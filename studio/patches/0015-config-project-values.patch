@@ -0,0 +1,230 @@
+// SPDX-License-Identifier: Apache-2.0
+// What upstream read once from the process for its one project — the public URL, the Data API
+// settings, the names, the version and the state — is the request's project's, from its
+// context: every route that answers one of them, under two projects' requests interleaved.
+import { setTimeout as sleep } from 'node:timers/promises'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { projectContext, runWithProject, type ResolveAnswer } from './project-context'
+
+vi.mock('@sentry/react', () => ({
+  startSpan: (_o: unknown, fn: (span: unknown) => unknown) => fn({ setAttribute: () => {} }),
+  captureException: () => {},
+}))
+vi.mock('@/lib/constants', async (original) => ({
+  ...(await original<Record<string, unknown>>()),
+  IS_PLATFORM: false,
+  PG_META_URL: 'http://meta.test',
+}))
+vi.mock('@/lib/constants/index', async (original) => ({
+  ...(await original<Record<string, unknown>>()),
+  IS_PLATFORM: false,
+  PG_META_URL: 'http://meta.test',
+}))
+vi.mock('./util', async (original) => ({
+  ...(await original<typeof import('./util')>()),
+  encryptString: (text: string) => `encrypted(${text})`,
+}))
+const lints = vi.hoisted(() => vi.fn())
+vi.mock('@/lib/api/self-hosted/lints', () => ({ getLints: lints }))
+
+const REF_A = 'abcdefghij0123456789'
+const REF_B = 'bcdefghij0123456789a'
+
+type Over = Partial<ResolveAnswer>
+function answer(ref: string, over: Over = {}): ResolveAnswer {
+  const a = ref === REF_A
+  return {
+    ref,
+    name: a ? 'project alpha' : 'project bravo',
+    state: 'active',
+    db_version: a ? '17.6.1' : '15.8.1',
+    pg_meta: a ? 1 : 0,
+    dsn_rw: `postgresql://postgres:pw@10.212.0.6:${a ? 20001 : 20002}/postgres?sslmode=disable`,
+    api_url: `https://${ref}.${a ? 'alpha' : 'bravo'}.test`,
+    data_api: a
+      ? { schemas: ['public', 'graphql_public'], extra_search_path: ['public', 'extensions'], max_rows: null }
+      : { schemas: ['api', 'reporting'], extra_search_path: ['extensions'], max_rows: 250 },
+    generation: 1,
+    at: '2026-11-19T10:00:00Z',
+    ...over,
+  }
+}
+const context = (ref: string, over: Over = {}) =>
+  projectContext(
+    { text: 'v1.a.b', ref, iss: 'https://issuer.test', sub: 'u', name: 'U', role: 'owner', purpose: '' },
+    answer(ref, over)
+  )
+
+/** A route's GET as the server runs it, the path's $ref naming the OTHER project. */
+async function get(module: string, path: string, otherRef: string) {
+  const { Route } = await import(/* @vite-ignore */ module)
+  const response: Response = await (Route as any).options.server.handlers.GET({
+    request: new Request(`http://studio.test${path.replace('$ref', otherRef)}`),
+    params: { ref: otherRef },
+  })
+  expect(response.status).toBe(200)
+  return response.json()
+}
+
+// What each converted value is for a project, and where its answer holds it.
+const host = (ref: string) => new URL(answer(ref).api_url).host
+const rest = (ref: string) => `${answer(ref).api_url}/rest/v1/`
+const schemas = (ref: string) => answer(ref).data_api.schemas.join(',')
+
+const ROUTES: [string, string, string, (ref: string) => unknown][] = [
+  ['projects/$ref', '@/routes/api/platform/projects/$ref/index', '/api/platform/projects/$ref/',
+    (ref) => ({ ref, name: answer(ref).name, restUrl: rest(ref), dbVersion: answer(ref).db_version })],
+  ['projects', '@/routes/api/platform/projects/index', '/api/platform/projects/',
+    (ref) => [{ ref, name: answer(ref).name }]],
+  ['props/project/$ref', '@/routes/api/platform/props/project/$ref/index', '/api/platform/props/project/$ref/',
+    (ref) => ({ project: { ref, name: answer(ref).name } })],
+  ['props/project/$ref/api', '@/routes/api/platform/props/project/$ref/api', '/api/platform/props/project/$ref/api',
+    (ref) => ({
+      project: { ref, name: answer(ref).name, db_host: ref + (ref === REF_A ? '.alpha.test' : '.bravo.test'),
+        services: [{ app_config: { endpoint: host(ref) } }] },
+      autoApiService: { project: { ref }, protocol: 'https', endpoint: host(ref), restUrl: rest(ref),
+        app_config: { endpoint: host(ref) } },
+    })],
+  ['databases', '@/routes/api/platform/projects/$ref/databases', '/api/platform/projects/$ref/databases',
+    (ref) => [{ identifier: ref, db_host: new URL(answer(ref).api_url).hostname, restUrl: rest(ref) }]],
+  ['settings', '@/routes/api/platform/projects/$ref/settings', '/api/platform/projects/$ref/settings',
+    (ref) => ({ ref, name: answer(ref).name, db_host: new URL(answer(ref).api_url).hostname,
+      app_config: { endpoint: host(ref), storage_endpoint: host(ref), protocol: 'https' } })],
+  ['config/postgrest', '@/routes/api/platform/projects/$ref/config/postgrest',
+    '/api/platform/projects/$ref/config/postgrest',
+    (ref) => ({ db_schema: schemas(ref), db_extra_search_path: answer(ref).data_api.extra_search_path.join(','),
+      max_rows: answer(ref).data_api.max_rows })],
+  ['organizations', '@/routes/api/platform/organizations/index', '/api/platform/organizations/',
+    (ref) => [{ name: answer(ref).name }]],
+  ['profile', '@/routes/api/platform/profile/index', '/api/platform/profile/',
+    (ref) => ({ organizations: [{ name: answer(ref).name, projects: [{ ref, name: answer(ref).name }] }] })],
+]
+
+describe('per-project values from the request context', () => {
+  let sent: string[]
+
+  beforeEach(() => {
+    sent = []
+    lints.mockReset()
+    lints.mockImplementation(async () => ({ data: [], error: undefined }))
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async (url: string) => {
+        sent.push(String(url))
+        await sleep(Math.random() * 5)
+        return new Response(JSON.stringify({ types: '' }), {
+          status: 200,
+          headers: { 'Content-Type': 'application/json' },
+        })
+      })
+    )
+  })
+  afterEach(() => {
+    vi.unstubAllGlobals()
+  })
+
+  it.each(ROUTES)(
+    'each converted value under two interleaved contexts: %s',
+    async (_, module, path, want) => {
+      const one = async (ref: string, other: string) =>
+        runWithProject(context(ref), async () => {
+          await sleep(Math.random() * 5)
+          const got = await get(module, path, other)
+          expect(got).toMatchObject(want(ref) as object)
+          const text = JSON.stringify(got)
+          expect(text).not.toContain(other)
+          expect(text).not.toContain(answer(other).name)
+          // upstream's one project and its fallbacks
+          expect(text).not.toMatch(/"default"|Default (Project|Organization)|localhost:/)
+        })
+      await Promise.all(
+        Array.from({ length: 20 }, (_, n) => (n % 2 ? one(REF_A, REF_B) : one(REF_B, REF_A)))
+      )
+    },
+    120_000
+  )
+
+  it('each converted value under two interleaved contexts: the schemas of lints and of type generation', async () => {
+    const { generateTypescriptTypes } = await import('./generate-types')
+    const one = (ref: string, other: string) =>
+      runWithProject(context(ref), async () => {
+        await sleep(Math.random() * 5)
+        await get('@/routes/api/platform/projects/$ref/run-lints', '/api/platform/projects/$ref/run-lints', other)
+        await generateTypescriptTypes({ headers: {} })
+        return ref
+      })
+    const refs = await Promise.all(
+      Array.from({ length: 20 }, (_, n) => (n % 2 ? one(REF_A, REF_B) : one(REF_B, REF_A)))
+    )
+    expect(lints).toHaveBeenCalledTimes(20)
+    expect(lints.mock.calls.map(([o]: any) => o.exposedSchemas).sort()).toEqual(
+      refs.map(schemas).sort()
+    )
+    expect(sent.map((url) => new URL(url).searchParams.get('included_schemas')).sort()).toEqual(
+      refs.map(schemas).sort()
+    )
+  })
+
+  it('each converted value under two interleaved contexts: the opt-in tool’s advisors', async () => {
+    const { getDebuggingOperations } = await import('./mcp')
+    const one = (ref: string, other: string) =>
+      runWithProject(context(ref), async () => {
+        await sleep(Math.random() * 5)
+        await getDebuggingOperations({ headers: {} }).getSecurityAdvisors(other)
+        return ref
+      })
+    const refs = await Promise.all(
+      Array.from({ length: 10 }, (_, n) => (n % 2 ? one(REF_A, REF_B) : one(REF_B, REF_A)))
+    )
+    expect(lints.mock.calls.map(([o]: any) => o.exposedSchemas).sort()).toEqual(
+      refs.map(schemas).sort()
+    )
+  }, 120_000)
+
+  it.each([
+    ['active', 'ACTIVE_HEALTHY'],
+    ['restarting', 'RESTARTING'],
+    ['restoring', 'RESTORING'],
+  ] as const)('the version and state of the answer reach the project response: %s', async (state, status) => {
+    for (const ref of [REF_A, REF_B]) {
+      const got = await runWithProject(context(ref, { state }), () =>
+        get('@/routes/api/platform/projects/$ref/index', '/api/platform/projects/$ref/', ref)
+      )
+      expect(got).toMatchObject({ ref, status, dbVersion: answer(ref).db_version })
+    }
+  })
+
+  it('a tenant-chosen version is never read: no project answer asks postgres-meta', async () => {
+    // control: a statement on the same path is seen
+    const { executeQuery } = await import('./query')
+    await runWithProject(context(REF_A), () => executeQuery({ query: 'select version()' }))
+    expect(sent).toEqual(['http://meta.test/query'])
+    sent = []
+    for (const [, module, path] of ROUTES) {
+      const got = await runWithProject(context(REF_A), () => get(module, path, REF_A))
+      if (path === '/api/platform/projects/$ref/')
+        expect(got.dbVersion).toBe(answer(REF_A).db_version)
+    }
+    expect(sent).toEqual([])
+  })
+
+  it('outside a request no route answers a project', async () => {
+    for (const [, module, path] of ROUTES) {
+      const { Route } = await import(/* @vite-ignore */ module)
+      await expect(
+        (Route as any).options.server.handlers.GET({
+          request: new Request(`http://studio.test${path.replace('$ref', REF_A)}`),
+          params: { ref: REF_A },
+        })
+      ).rejects.toMatchObject({ code: 'no_project_context' })
+    }
+  })
+
+  it('no per-project constant is left to import', async () => {
+    expect(Object.keys(await import('@/lib/constants/api'))).toEqual(['PROJECT_ANALYTICS_URL'])
+    const constants = await import('./constants')
+    for (const name of ['DEFAULT_EXPOSED_SCHEMAS', 'ENCRYPTION_KEY', 'POSTGRES_PORT'])
+      expect(constants).not.toHaveProperty(name)
+  })
+})
