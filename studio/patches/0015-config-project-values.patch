@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: Apache-2.0
+// What upstream read once, from the process, for its one project — the public URL and what it
+// derived from it, the Data API settings, the name, the version and the state — read here for
+// the request's project, from its context. There is no default: outside a request each throws.
+
+import { getProjectContext } from './project-context'
+
+const STATUS = {
+  active: 'ACTIVE_HEALTHY',
+  restarting: 'RESTARTING',
+  restoring: 'RESTORING',
+} as const
+
+/** Every project's server listens on this port inside its own cluster. */
+export const PROJECT_DB_PORT = 5432
+
+/** The project's public URL, in the forms upstream derived from it. */
+export function projectUrls() {
+  const url = new URL(getProjectContext().api_url)
+  return {
+    restUrl: `${url.origin}/rest/v1/`,
+    endpoint: url.host,
+    protocol: url.protocol.replace(':', ''),
+    dbHost: url.hostname,
+  }
+}
+
+/** The project's Data API settings, in upstream's comma-separated form. */
+export function dataApi() {
+  const { schemas, extra_search_path, max_rows } = getProjectContext().data_api
+  return {
+    schemas: schemas.join(','),
+    extraSearchPath: extra_search_path.join(','),
+    maxRows: max_rows,
+  }
+}
+
+/** The request's project, in the shape of upstream's one default project. */
+export function contextProject() {
+  const { ref, name, state, db_version } = getProjectContext()
+  return {
+    id: 1,
+    ref,
+    name,
+    organization_id: 1,
+    cloud_provider: 'localhost',
+    status: STATUS[state],
+    region: 'local',
+    inserted_at: '2021-08-02T06:40:40.646Z',
+    dbVersion: db_version,
+  }
+}
