diff --git a/apps/studio/lib/api/self-hosted/audit.test.ts b/apps/studio/lib/api/self-hosted/audit.test.ts
new file mode 100644
index 00000000..07044bb8
--- /dev/null
+++ b/apps/studio/lib/api/self-hosted/audit.test.ts
@@ -0,0 +1,192 @@
+// SPDX-License-Identifier: Apache-2.0
+// The audit file: what a line is, what a value can do to it, when it rolls, and what racing
+// writes leave. That a statement is on record before it is sent is the wrapper's test.
+import { createHash } from 'node:crypto'
+import { existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, statSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join, resolve as resolvePath } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+const VECTORS = resolvePath(import.meta.dirname, '../../../../../vectors')
+const LIMITS = JSON.parse(readFileSync(join(VECTORS, 'limits.json'), 'utf8'))
+const T = /^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{3}Z$/
+const RW = 'postgres'
+const ref = (n: number) => `project${String(n).padStart(13, '0')}`
+const sha = (text: string) => createHash('sha256').update(text).digest('hex')
+
+describe('api/self-hosted/audit', () => {
+  let dir: string
+  let data: string
+  async function load(limits: object = {}) {
+    vi.stubEnv('SUPAPACE_LIMITS', JSON.stringify({ ...LIMITS, ...limits }))
+    vi.resetModules()
+    return import('./audit')
+  }
+  const lines = (n: number, name = 'audit.log') =>
+    readFileSync(join(data, ref(n), name), 'utf8')
+      .split('\n')
+      .filter((line) => line !== '')
+
+  beforeEach(() => {
+    dir = mkdtempSync(join(tmpdir(), 'audit-'))
+    data = join(dir, 'data')
+    vi.stubEnv('SUPAPACE_DASH_DATA', data)
+    vi.spyOn(console, 'error').mockImplementation(() => {})
+  })
+  afterEach(() => {
+    vi.unstubAllEnvs()
+    vi.restoreAllMocks()
+    rmSync(dir, { recursive: true, force: true })
+  })
+
+  it('a line torn by a crash does not take the next record with it', async () => {
+    const { writeAudit } = await load()
+    const record = (sub: string) => ({
+      ref: ref(1),
+      iss: 'https://issuer.test',
+      sub,
+      role: 'owner',
+      login: RW,
+      kind: 'query' as const,
+    })
+    await writeAudit(record('before'))
+    // an append that the machine did not finish: a part of a line, and no line end
+    const { appendFileSync } = await import('node:fs')
+    appendFileSync(join(data, ref(1), 'audit.log'), '{"t":"2026-11-27T10:00:00.000Z","ref":"proj')
+    await writeAudit(record('after'))
+    await writeAudit(record('last'))
+    const text = readFileSync(join(data, ref(1), 'audit.log'), 'utf8')
+    const whole = lines(1).flatMap((line) => {
+      try {
+        return [JSON.parse(line).sub]
+      } catch {
+        return ['(torn)']
+      }
+    })
+    // the fragment is a line of its own, and every record after it is read
+    expect(whole).toEqual(['before', '(torn)', 'after', 'last'])
+    // and nothing is added to a file that ends as it should
+    expect(text.includes('\n\n')).toBe(false)
+  })
+
+  const odd = [
+    'plain',
+    'two\nlines',
+    'a\r\nb',
+    '{"t":"x","ref":"y"}',
+    '","role":"owner","x":"',
+    'back\\slash and "quotes"',
+    'controls \u0000\u0001\u001f\u007f',
+    'separators \u2028\u2029 and \ud83d\ude00 and a lone \ud800',
+    ' ',
+    'x'.repeat(255),
+  ]
+  it(
+    'writes one line per record, from which exactly the record is read again',
+    { timeout: 60_000 },
+    async () => {
+      const { writeAudit, MAX_LINE_BYTES } = await load()
+      const base = {
+        ref: ref(1),
+        role: 'owner',
+        login: RW,
+        kind: 'query' as const,
+      }
+      const records = odd.flatMap((value, i) => [
+        {
+          ...base,
+          iss: value,
+          sub: odd[(i + 1) % odd.length],
+          sql_sha256: sha(value),
+        },
+        { ...base, iss: 'i', sub: value, role: value, login: value },
+      ])
+      for (const record of records) await writeAudit(record)
+      const text = readFileSync(join(data, ref(1), 'audit.log'), 'utf8')
+      expect(text.endsWith('\n')).toBe(true)
+      const lines = text.slice(0, -1).split('\n')
+      expect(lines).toHaveLength(records.length)
+      lines.forEach((line, i) => {
+        const { t, ...read } = JSON.parse(line)
+        expect(read).toEqual(records[i])
+        expect(t).toMatch(T)
+        expect(Buffer.byteLength(line)).toBeLessThanOrEqual(MAX_LINE_BYTES)
+        // no byte of a line is a control byte: a reader of lines sees one line
+        expect(/[\u0000-\u001f]/.test(line)).toBe(false)
+      })
+    }
+  )
+
+  it('refuses a record its reader would not take, and one that names no project', async () => {
+    const { writeAudit } = await load()
+    const good = {
+      ref: ref(1),
+      iss: 'i',
+      sub: 's',
+      role: 'owner',
+      login: RW,
+      kind: 'query' as const,
+    }
+    const refused = { status: 503, code: 'audit_unavailable' }
+    const bad: object[] = [
+      { ...good, sub: 'x'.repeat(4096) },
+      // every control byte takes six bytes in a line
+      { ...good, sub: '\u0001'.repeat(700) },
+      { ...good, sub: 7 },
+      { ...good, iss: { a: 1 } },
+      { ...good, iss: undefined },
+      { ...good, sql_sha256: 7 },
+      { ...good, ref: '../../../outside' },
+      { ...good, ref: `${ref(1)}/..` },
+      { ...good, ref: ref(1).toUpperCase() },
+      { ...good, ref: '' },
+    ]
+    for (const record of bad) {
+      await expect(writeAudit(record as never)).rejects.toMatchObject(refused)
+    }
+    expect(existsSync(data)).toBe(false)
+    expect(readdirSync(dir)).toEqual([])
+    // control
+    await writeAudit(good)
+    expect(lines(1)).toHaveLength(1)
+    // and without a data directory nothing is written anywhere
+    vi.stubEnv('SUPAPACE_DASH_DATA', 'relative/data')
+    await expect(writeAudit(good)).rejects.toMatchObject(refused)
+    delete process.env.SUPAPACE_DASH_DATA
+    await expect(writeAudit(good)).rejects.toMatchObject(refused)
+  })
+
+  it(
+    'writes that race a roll leave whole lines, in two files, and lose none',
+    { timeout: 60_000 },
+    async () => {
+      // 60 records of 200 bytes and a bound of 8,000: one roll, whoever is first
+      const { writeAudit } = await load({ audit_file_bytes: 8000 })
+      const record = (i: number) => ({
+        ref: ref(1),
+        iss: 'https://issuer.test',
+        sub: `member-${String(i).padStart(3, '0')}`,
+        role: 'owner',
+        login: RW,
+        kind: 'query' as const,
+        sql_sha256: sha(String(i)),
+      })
+      const other = Array.from({ length: 20 }, (_, i) => writeAudit({ ...record(i), ref: ref(2) }))
+      await Promise.all([...Array.from({ length: 60 }, (_, i) => writeAudit(record(i))), ...other])
+      const dir = join(data, ref(1))
+      expect(readdirSync(dir).sort()).toEqual(['audit.log', 'audit.log.1'])
+      const all = [...lines(1, 'audit.log.1'), ...lines(1)]
+      // every record once, each line whole, in the order the writes were asked for
+      expect(all.map((l) => JSON.parse(l).sub)).toEqual(
+        Array.from({ length: 60 }, (_, i) => record(i).sub)
+      )
+      for (const name of ['audit.log', 'audit.log.1']) {
+        expect(statSync(join(dir, name)).size).toBeLessThanOrEqual(8000)
+        expect(readFileSync(join(dir, name), 'utf8').endsWith('}\n')).toBe(true)
+      }
+      // the other project's writes went to its own file, which did not roll
+      expect(readdirSync(join(data, ref(2)))).toEqual(['audit.log'])
+      expect(lines(2)).toHaveLength(20)
+    }
+  )
+})
