+++ b/apps/studio/lib/api/self-hosted/audit.ts
@@ -0,0 +1,122 @@
+// SPDX-License-Identifier: Apache-2.0
+// The dashboard's record of what it sends to a project's database: one line per statement or
+// type generation, in a file of the project on the server's data volume, written and flushed
+// before the request leaves. A statement that is not on record is not sent: when the line
+// cannot be written, the caller is refused.
+//
+// A line is one JSON object, its members in this order, each a text:
+//   {"t","ref","iss","sub","role","login","kind","sql_sha256"}
+// `t` is the time in UTC with milliseconds; `kind` is `query` or `typegen`; `sql_sha256` is the
+// hex SHA-256 of the statement's text and is absent for `typegen`. JSON leaves no line end, no
+// control byte and no quote of a value unescaped, so a value cannot end its line or forge a
+// member. The file is `<data>/<ref>/audit.log`; before a line would take it past
+// `audit_file_bytes` it becomes `audit.log.1`, replacing the one before.
+
+import { constants } from 'node:fs'
+import { mkdir, open, rename } from 'node:fs/promises'
+import { isAbsolute, join } from 'node:path'
+
+import { limits } from './limits'
+import { ProjectError } from './project-context'
+
+export type AuditRecord = {
+  ref: string
+  iss: string
+  sub: string
+  role: string
+  login: string
+  kind: 'query' | 'typegen'
+  sql_sha256?: string
+}
+
+/** A line, without its line end, is at most this long: what the audit's reader takes for a record. */
+export const MAX_LINE_BYTES = 4096
+
+const REF = /^[a-z0-9]{20}$/
+const { O_RDWR, O_APPEND, O_CREAT, O_NOFOLLOW, O_NONBLOCK, O_RDONLY, O_DIRECTORY } = constants
+
+const unavailable = () =>
+  new ProjectError(503, 'audit_unavailable', 'The audit record could not be written')
+
+/** One line appended to the project's file and flushed; the file rolled first when it is full. */
+async function append(dir: string, line: Buffer) {
+  await mkdir(dir, { recursive: true, mode: 0o700 })
+  const file = join(dir, 'audit.log')
+  for (let rolled = false; ; rolled = true) {
+    // never through a link, and never waiting on what is no file: a flush of such a thing fails
+    const fh = await open(file, O_RDWR | O_APPEND | O_CREAT | O_NOFOLLOW | O_NONBLOCK, 0o600)
+    try {
+      const { size } = await fh.stat()
+      if (!rolled && size > 0 && size + line.length > limits().audit_file_bytes) {
+        await rename(file, `${file}.1`)
+        continue
+      }
+      try {
+        // a file that does not end in a line end holds a part of a line, left by a write the
+        // machine did not finish: this record begins a line of its own
+        const torn = size > 0 && (await fh.read(Buffer.alloc(1), 0, 1, size - 1)).buffer[0] !== 0x0a
+        await fh.appendFile(torn ? Buffer.concat([Buffer.from('\n'), line]) : line)
+        await fh.sync()
+      } catch (error) {
+        // a part of a line must not stay: the next record would be read as its end
+        await fh.truncate(size).catch(() => {})
+        throw error
+      }
+      if (size === 0) {
+        // a new file: its name is flushed too
+        const dh = await open(dir, O_RDONLY | O_DIRECTORY)
+        await dh.sync().finally(() => dh.close())
+      }
+      return
+    } finally {
+      await fh.close()
+    }
+  }
+}
+
+// One write at a time per project: a line is whole before the next begins, and a roll moves a
+// file no line is being written to.
+const tails = new Map<string, Promise<void>>()
+
+/**
+ * Writes the record, with the time, and returns when it is flushed. Throws `503
+ * audit_unavailable` when it is not on the volume: the caller sends nothing then.
+ */
+export async function writeAudit(record: AuditRecord): Promise<void> {
+  const { ref, iss, sub, role, login, kind, sql_sha256 } = record
+  const data = process.env.SUPAPACE_DASH_DATA
+  const line = Buffer.from(
+    JSON.stringify({
+      t: new Date().toISOString(),
+      ref,
+      iss,
+      sub,
+      role,
+      login,
+      kind,
+      sql_sha256,
+    }) + '\n'
+  )
+  const texts = [ref, iss, sub, role, login, kind, sql_sha256 ?? ''].every(
+    (s) => typeof s === 'string'
+  )
+  if (!texts || !REF.test(ref) || !data || !isAbsolute(data) || line.length - 1 > MAX_LINE_BYTES) {
+    throw unavailable()
+  }
+  const written = (tails.get(ref) ?? Promise.resolve()).then(() => append(join(data, ref), line))
+  const tail = written.then(
+    () => {},
+    () => {}
+  )
+  tails.set(ref, tail)
+  void tail.then(() => tails.get(ref) === tail && tails.delete(ref))
+  try {
+    await written
+  } catch (error) {
+    const code = (error as NodeJS.ErrnoException)?.code
+    console.error(
+      `supapace: the audit record of ${ref} could not be written (${typeof code === 'string' && /^[A-Z0-9_]{1,32}$/.test(code) ? code : 'error'})`
+    )
+    throw unavailable()
+  }
+}
