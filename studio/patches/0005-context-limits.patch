@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: Apache-2.0
+// The dashboard's bounds. The control plane renders them into SUPAPACE_LIMITS, one JSON object;
+// a server without them, or with a value it does not understand, does not serve. Nothing is
+// read when the module loads — the build loads the server's modules too, without the node's
+// environment — but at the first use.
+
+const MEMBERS = [
+  'socket_call_ms',
+  'slot_wait_ms',
+  'meta_call_ms',
+  'handover_ms',
+  'result_bytes',
+  'instance_calls',
+  'project_calls',
+  'project_waiting',
+  'parser_slots',
+  'resolve_memory_s',
+  'resolve_disk_days',
+  'snippet_bytes',
+  'snippet_entries',
+  'audit_file_bytes',
+] as const
+
+export type Limits = Readonly<Record<(typeof MEMBERS)[number], number>>
+
+/**
+ * Parses the value of SUPAPACE_LIMITS: one JSON object holding exactly the known members,
+ * each a positive integer. Anything else throws.
+ */
+export function parseLimits(text: string | undefined): Limits {
+  if (!text) throw new Error('SUPAPACE_LIMITS is not set')
+  let value: unknown
+  try {
+    value = JSON.parse(text)
+  } catch {
+    throw new Error('SUPAPACE_LIMITS is not JSON')
+  }
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+    throw new Error('SUPAPACE_LIMITS is not a JSON object')
+  }
+  const given: Record<string, unknown> = { ...value }
+  const known: readonly string[] = MEMBERS
+  if (Object.keys(given).some((name) => !known.includes(name))) {
+    throw new Error('SUPAPACE_LIMITS has an unknown member')
+  }
+  const limits: Record<string, number> = {}
+  for (const name of MEMBERS) {
+    const n = given[name]
+    if (typeof n !== 'number' || !Number.isSafeInteger(n) || n <= 0) {
+      throw new Error(`SUPAPACE_LIMITS: ${name} is missing or not a positive integer`)
+    }
+    limits[name] = n
+  }
+  return Object.freeze(limits) as Limits
+}
+
+/**
+ * Runs a read of the server's configuration. A value that is missing or malformed stops
+ * the process: the dashboard serves nothing rather than serve on a default.
+ */
+export function orStop<T>(read: () => T): T {
+  try {
+    return read()
+  } catch (error) {
+    console.error(
+      `supapace: ${error instanceof Error ? error.message : 'bad configuration'}; the server stops`
+    )
+    process.exit(1)
+  }
+}
+
+let loaded: Limits | undefined
+
+/** The bounds, read and checked at the first call; a bad value stops the process. */
+export function limits(): Limits {
+  return (loaded ??= orStop(() => parseLimits(process.env.SUPAPACE_LIMITS)))
+}
