+// SPDX-License-Identifier: Apache-2.0
+// supapace: in self-hosted, sharing or unsharing a snippet moves its file and gives it another
+// id (the server derives a snippet's id from where it is kept). The editor's state follows the
+// answer: the old entry goes, the moved one comes, and an open tab follows it.
+import { useRouter } from 'next/router'
+
+import type { SnippetWithContent } from '@/data/content/sql-folders-query'
+import { useSqlEditorV2StateSnapshot } from '@/state/sql-editor/sql-editor-state'
+import { createTabId, useTabsStateSnapshot } from '@/state/tabs'
+
+export function useMovedSnippet() {
+  const router = useRouter()
+  const snapV2 = useSqlEditorV2StateSnapshot()
+  const tabsSnap = useTabsStateSnapshot()
+
+  return async (
+    projectRef: string,
+    id: string,
+    moved: SnippetWithContent | null | undefined,
+    change: Pick<SnippetWithContent, 'visibility' | 'folder_id'>
+  ) => {
+    if (!moved || moved.id === id) {
+      snapV2.updateSnippet({ id, snippet: change, skipSave: true })
+      return
+    }
+    snapV2.removeSnippet(id, true)
+    snapV2.addSnippet({ projectRef, snippet: moved })
+    const tabId = createTabId('sql', { id })
+    if (tabsSnap.hasTab(tabId)) {
+      tabsSnap.removeTab(tabId)
+      await router.push(`/project/${projectRef}/sql/${moved.id}`)
+    }
+  }
+}
