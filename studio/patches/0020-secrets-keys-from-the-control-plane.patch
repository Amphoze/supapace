+/**
+ * The keys of the request's project, asked of the control plane with the request's own
+ * assertion, every time: nothing of the answer is kept, and no key is read from the process.
+ */
+export function projectKeys() {
+  const { assertion, ref, principal, role, purpose } = getProjectContext()
+  return keys({ text: assertion, ref, ...principal, role, purpose })
