-export function applyRevealToApiKey(key: NonPlatformApiKey, reveal: boolean): NonPlatformApiKey {
-  if (key.type !== 'secret' || reveal) return key
-
-  return { ...key, api_key: key.prefix }
+/**
+ * The project's API keys. The service_role key is listed only when the request asks for it
+ * (`reveal`) and the control plane answered it — which it does for an owner under an
+ * assertion the gateway signed for that purpose, and for nobody else.
+ */
+export async function getNonPlatformApiKeys(reveal: boolean): Promise<NonPlatformApiKey[]> {
+  const answer = await projectKeys()
+  const legacy = (name: string, api_key: string): NonPlatformApiKey => ({
+    name,
+    api_key,
+    id: name,
+    type: 'legacy',
+    hash: '',
+    prefix: '',
+    description: `Legacy ${name} API key`,
+  })
+  return [
+    legacy('anon', answer.anon_key),
+    ...(reveal && answer.service_role_key !== undefined
+      ? [legacy('service_role', answer.service_role_key)]
+      : []),
+  ]
 }
 
-export function getNonPlatformApiKeyById(
+export async function getNonPlatformApiKeyById(
   id: string,
   reveal: boolean
-): NonPlatformApiKey | undefined {
-  const key = getNonPlatformApiKeys().find((entry) => entry.id === id)
-  if (!key) return undefined
-
-  return applyRevealToApiKey(key, reveal)
+): Promise<NonPlatformApiKey | undefined> {
+  return (await getNonPlatformApiKeys(reveal)).find((entry) => entry.id === id)
 }
