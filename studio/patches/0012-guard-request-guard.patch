diff --git a/apps/studio/lib/api/apiWrapper.ts b/apps/studio/lib/api/apiWrapper.ts
index 958186e2..b5c9679e 100644
--- a/apps/studio/lib/api/apiWrapper.ts
+++ b/apps/studio/lib/api/apiWrapper.ts
@@ -54,6 +54,10 @@ export async function apiWrapper(
 
     return await handler(req, res, claims)
   } catch (error) {
+    // supapace: a refusal of the server itself is not an internal error; the request guard
+    // answers it. Told by its name: this module is shared with the browser's bundle, which
+    // must not load the server's project context.
+    if (error instanceof Error && error.name === 'ProjectError') throw error
     Sentry.captureException(error)
     return res.status(500).json({ error })
   }
