+// SPDX-License-Identifier: Apache-2.0
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import type { NextApiRequest, NextApiResponse } from 'next'
+import { describe, expect, it, vi } from 'vitest'
+
+import { apiWrapper } from '../apiWrapper'
+import { ProjectError } from './project-context'
+
+vi.mock('@sentry/react', () => ({ captureException: vi.fn() }))
+
+function response() {
+  const res = { status: vi.fn(), json: vi.fn() }
+  res.status.mockReturnValue(res)
+  res.json.mockReturnValue(res)
+  return res
+}
+
+describe('a route handler that throws', () => {
+  it('passes a refusal of the server on to the request guard, unanswered', async () => {
+    const res = response()
+    const refusal = new ProjectError(
+      403,
+      'no_read_only_login',
+      'The project has no read-only login'
+    )
+    const wrapped = apiWrapper(
+      {} as NextApiRequest,
+      res as unknown as NextApiResponse,
+      async () => {
+        throw refusal
+      }
+    )
+    await expect(wrapped).rejects.toBe(refusal)
+    expect(res.status).not.toHaveBeenCalled()
+    expect(res.json).not.toHaveBeenCalled()
+  })
+
+  it('answers any other error as before', async () => {
+    const res = response()
+    const error = new TypeError('broken')
+    await apiWrapper({} as NextApiRequest, res as unknown as NextApiResponse, async () => {
+      throw error
+    })
+    expect(res.status).toHaveBeenCalledWith(500)
+    expect(res.json).toHaveBeenCalledWith({ error })
+  })
+
+  it('does not load the project context into a module the browser’s bundle shares', () => {
+    const source = readFileSync(join(import.meta.dirname, '../apiWrapper.ts'), 'utf8')
+    expect(source).not.toMatch(/from ['"][^'"]*self-hosted/)
+  })
+})
diff --git a/apps/studio/lib/api/self-hosted/request-guard.test.ts b/apps/studio/lib/api/self-hosted/request-guard.test.ts
new file mode 100644
