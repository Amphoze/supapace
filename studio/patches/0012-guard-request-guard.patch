--- /dev/null
+++ b/apps/studio/lib/api/self-hosted/request-guard.test.ts
@@ -0,0 +1,897 @@
+// SPDX-License-Identifier: Apache-2.0
+import { createPrivateKey, sign as signBytes } from 'node:crypto'
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { createServer, type Server } from 'node:http'
+import { tmpdir } from 'node:os'
+import { join, resolve as resolvePath } from 'node:path'
+import { setTimeout as sleep } from 'node:timers/promises'
+import { createRootRoute, createRoute, createRouter } from '@tanstack/react-router'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+const VECTOR_DIR = resolvePath(import.meta.dirname, '../../../../../vectors')
+const VECTORS = JSON.parse(readFileSync(join(VECTOR_DIR, 'tokens.json'), 'utf8'))
+const LIMITS = readFileSync(join(VECTOR_DIR, 'limits.json'), 'utf8').trim()
+const HEADER = 'X-Supapace-Assertion'
+const REF_A = 'abcdefghij0123456789'
+const REF_B = 'bcdefghij0123456789a'
+const ISS = 'https://issuer.test'
+
+// The routes the build refuses though it holds them: under /api/ai/ and at /api/mcp.
+const OPT_IN = [
+  '/api/ai/code/complete',
+  '/api/ai/docs',
+  '/api/ai/feedback/classify',
+  '/api/ai/feedback/rate',
+  '/api/ai/onboarding/design',
+  '/api/ai/sql/check-api-key',
+  '/api/ai/sql/cron-v2',
+  '/api/ai/sql/filter-v1',
+  '/api/ai/sql/generate-v4',
+  '/api/ai/sql/parse-client-code',
+  '/api/ai/sql/policy',
+  '/api/ai/sql/title-v2',
+  '/api/mcp',
+]
+
+// A route tree of the shapes the application has, matched by the router package itself.
+const handler = vi.fn(() => new Response('handled'))
+function testRouter() {
+  const root = createRootRoute()
+  const route = (path: string, methods?: string[]) =>
+    createRoute({
+      getParentRoute: () => root,
+      path,
+      ...(methods && {
+        server: {
+          handlers: Object.fromEntries(methods.map((m) => [m, handler])),
+        },
+      }),
+    } as any)
+  const routeTree = root.addChildren([
+    route('/'),
+    route('/project/$ref'),
+    route('/project/$ref/editor'),
+    route('/org/$slug'),
+    route('/api/get-utc-time', ['GET']),
+    route('/api/platform/profile', ['GET']),
+    route('/api/platform/pg-meta/$ref/query', ['POST']),
+    route('/api/platform/projects/$ref/content', ['DELETE', 'GET', 'PUT']),
+    route('/api/any', ['ANY']),
+    route('/api/platform/projects/$ref/content/folders/$id', ['GET', 'PATCH']),
+    route('/api/no-handlers'),
+    // a route outside /api with a server handler: the application has none, the guard does
+    // not rely on it
+    route('/hooks/ping', ['GET']),
+    ...OPT_IN.map((path) => route(path, [path.endsWith('check-api-key') ? 'GET' : 'POST'])),
+  ])
+  return createRouter({ routeTree }) as any
+}
+
+const privateKey = createPrivateKey({
+  key: {
+    kty: 'OKP',
+    crv: 'Ed25519',
+    d: VECTORS.private_file,
+    x: VECTORS.public_file,
+  },
+  format: 'jwk',
+})
+function assertion(
+  ref: string,
+  sub = 'user-1',
+  role = 'owner',
+  over: Record<string, unknown> = {}
+) {
+  const iat = Math.floor(Date.now() / 1000)
+  const claims = {
+    node: VECTORS.node,
+    iss: ISS,
+    sub,
+    name: `N ${sub}`,
+    ref,
+    role,
+    purpose: '',
+    iat,
+    exp: iat + 30,
+    ...over,
+  }
+  const p = Buffer.from(JSON.stringify(claims)).toString('base64url')
+  const s = signBytes(null, Buffer.from('supapace-assertion-v1.' + p), privateKey)
+  return `v1.${p}.${s.toString('base64url')}`
+}
+
+function answer(ref: string, role: string) {
+  const port = ref === REF_A ? 20001 : 20002
+  return {
+    ref,
+    name: `project ${port}`,
+    state: 'active',
+    db_version: '17.6.1',
+    pg_meta: port % 2,
+    ...(role !== 'read_only' && {
+      dsn_rw: `postgresql://postgres:rw${port}@10.212.0.6:${port}/postgres?sslmode=disable`,
+    }),
+    dsn_ro: `postgresql://supabase_read_only_user:ro${port}@10.212.0.6:${port}/postgres?sslmode=disable`,
+    api_url: `https://${ref}.example.test`,
+    data_api: {
+      schemas: ['public'],
+      extra_search_path: ['public', 'extensions'],
+      max_rows: null,
+    },
+    generation: 4,
+    at: new Date().toISOString().replace(/\.\d+Z$/, 'Z'),
+  }
+}
+
+describe('api/self-hosted/request-guard', () => {
+  let dir: string
+  let socket: Server
+  let asked: string[]
+  let refusal: { status: number; code: string } | undefined
+  let exit: ReturnType<typeof vi.spyOn>
+  let said: ReturnType<typeof vi.spyOn>
+  let guard: typeof import('./request-guard')
+  let context: typeof import('./project-context')
+  let router: any
+
+  /** One request through the guard; `seen` is what the rest of the chain saw. */
+  async function send(
+    path: string,
+    init: {
+      method?: string
+      assertion?: string | null
+      headers?: Record<string, string>
+      next?: () => unknown
+      // the path the server framework hands a middleware; the URL's own when not given
+      pathname?: string
+    } = {}
+  ) {
+    const headers = new Headers(init.headers)
+    if (init.assertion) headers.set(HEADER, init.assertion)
+    const request = new Request(`http://studio.test${path}`, {
+      method: init.method ?? 'GET',
+      headers,
+    })
+    const seen: { called: boolean; context?: unknown; noContext?: unknown } = {
+      called: false,
+    }
+    const next = async () => {
+      seen.called = true
+      try {
+        seen.context = context.getProjectContext()
+      } catch (error) {
+        seen.noContext = error
+      }
+      return init.next ? init.next() : new Response('next')
+    }
+    const response = (await guard.guardRequest(
+      { request, pathname: init.pathname ?? new URL(request.url).pathname, next },
+      () => router
+    )) as Response
+    return {
+      response,
+      seen,
+      body:
+        response.status === 200
+          ? undefined
+          : await response
+              .clone()
+              .json()
+              .catch(() => undefined),
+    }
+  }
+  const expectRefused = async (sent: ReturnType<typeof send>, status: number, code: string) => {
+    const { response, seen, body } = await sent
+    expect([response.status, body?.code]).toEqual([status, code])
+    expect(Object.keys(body)).toEqual(['code', 'message'])
+    expect(seen.called).toBe(false)
+    return response
+  }
+
+  beforeEach(async () => {
+    vi.resetModules()
+    handler.mockClear()
+    dir = mkdtempSync(join(tmpdir(), 'guard-'))
+    writeFileSync(join(dir, 'assert.pub'), VECTORS.public_file + '\n')
+    writeFileSync(join(dir, 'cache.key'), Buffer.alloc(32, 7).toString('base64url') + '\n')
+    asked = []
+    refusal = undefined
+    socket = createServer((req, res) => {
+      const text = String(req.headers[HEADER.toLowerCase()])
+      const claims = JSON.parse(Buffer.from(text.split('.')[1], 'base64url').toString('utf8'))
+      asked.push(`${req.url} ${claims.ref} ${claims.sub}`)
+      res.setHeader('content-type', 'application/json')
+      if (refusal) {
+        res.statusCode = refusal.status
+        res.end(JSON.stringify({ code: refusal.code }))
+      } else res.end(JSON.stringify(answer(claims.ref, claims.role)))
+    })
+    await new Promise<void>((done) => socket.listen(join(dir, 'dash.sock'), done))
+    vi.stubEnv('SUPAPACE_LIMITS', LIMITS)
+    vi.stubEnv('SUPAPACE_DASH_SOCKET', join(dir, 'dash.sock'))
+    vi.stubEnv('SUPAPACE_DASH_DATA', join(dir, 'data'))
+    vi.stubEnv('SUPAPACE_DASH_KEYS', dir)
+    vi.stubEnv('SUPAPACE_PGCAP', '10.212.0.6:20000:21023')
+    vi.stubEnv('SUPAPACE_PGMETA', 'http://10.212.0.4:8080,http://10.212.0.5:8080')
+    vi.stubEnv('SUPAPACE_NODE_ID', VECTORS.node)
+    vi.stubEnv('TSS_PRERENDERING', '')
+    delete process.env.TSS_PRERENDERING
+    exit = vi.spyOn(process, 'exit').mockImplementation(() => {
+      throw new Error('the process exited')
+    })
+    said = vi.spyOn(console, 'error').mockImplementation(() => {})
+    guard = await import('./request-guard')
+    context = await import('./project-context')
+    router = testRouter()
+  })
+  afterEach(async () => {
+    vi.useRealTimers()
+    vi.unstubAllEnvs()
+    vi.restoreAllMocks()
+    await new Promise((done) => socket.close(done))
+    rmSync(dir, { recursive: true, force: true })
+  })
+
+  describe('the assertion', () => {
+    it.each([
+      ['an API route', '/api/platform/profile', 'GET'],
+      ['a route that writes', `/api/platform/pg-meta/${REF_A}/query`, 'POST'],
+      ['a page', `/project/${REF_A}/editor`, 'GET'],
+      ['the root', '/', 'GET'],
+      [
+        'a server function',
+        '/_serverFn/13355c4bebdb166d8b90dd1232f8a7ed9810ba1819821acf01f1db6947e845ee',
+        'GET',
+      ],
+      ['a path no route has', '/nothing/here', 'GET'],
+      ['an API path no route has', '/api/nothing', 'GET'],
+      ['a refused route', '/api/mcp', 'POST'],
+    ])('answers 401 without one: %s', async (_, path, method) => {
+      await expectRefused(send(path, { method }), 401, 'bad_assertion')
+      expect(asked).toEqual([])
+    })
+
+    it('answers 401 for every refused case of the vector file, at the case’s own time', async () => {
+      vi.useFakeTimers({ toFake: ['Date'] })
+      let own = 0
+      for (const c of VECTORS.refused) {
+        // a line end cannot be in a header's value: that case is the verifier's own test
+        if (/[\r\n]/.test(c.token)) {
+          expect(c.case).toBe('signature-line-end')
+          continue
+        }
+        vi.setSystemTime(c.now * 1000)
+        await expectRefused(
+          send('/api/platform/profile', { assertion: c.token }),
+          401,
+          'bad_assertion'
+        )
+        if (c.kind === 'assertion') own++
+      }
+      expect(own).toBeGreaterThanOrEqual(24)
+      expect(VECTORS.refused.map((c: any) => `${c.kind}/${c.case}`)).toContain(
+        'assertion/signature-s-plus-l'
+      )
+      expect(asked).toEqual([])
+      // the control: the accepted assertions pass at theirs
+      for (const t of VECTORS.tokens.filter((t: any) => t.kind === 'assertion')) {
+        vi.setSystemTime(t.now * 1000)
+        const { response, seen } = await send('/api/platform/profile', {
+          assertion: t.token,
+        })
+        expect(response.status).toBe(200)
+        expect((seen.context as any).principal.name).toBe(JSON.parse(t.payload).name)
+      }
+    })
+
+    it('answers 401 for two assertion headers', async () => {
+      const headers = new Headers()
+      headers.append(HEADER, assertion(REF_A))
+      headers.append(HEADER, assertion(REF_A))
+      const request = new Request('http://studio.test/api/platform/profile', {
+        headers,
+      })
+      const next = vi.fn()
+      const response = (await guard.guardRequest(
+        { request, pathname: '/api/platform/profile', next },
+        () => router
+      )) as Response
+      expect(response.status).toBe(401)
+      expect(next).not.toHaveBeenCalled()
+    })
+
+    it('takes no assertion from a query, a cookie or another header', async () => {
+      const a = assertion(REF_A)
+      await expectRefused(
+        send(`/api/platform/profile?${HEADER}=${a}&${HEADER.toLowerCase()}=${a}&assertion=${a}`, {
+          headers: {
+            cookie: `${HEADER}=${a}`,
+            authorization: `Bearer ${a}`,
+            'x-assertion': a,
+          },
+        }),
+        401,
+        'bad_assertion'
+      )
+    })
+  })
+
+  describe('the routes that are not served', () => {
+    const forms = (path: string) => [
+      path,
+      path.toUpperCase(),
+      path.replace('/api/', '/Api/'),
+      // percent-encoded: a letter of each of the first two segments
+      path
+        .replace('/api/', '/%61pi/')
+        .replace(/^(\/[^/]+\/)(.)/, (_, head, c) => `${head}%${c.charCodeAt(0).toString(16)}`),
+      path.replace('/api/', '/%41PI/'),
+      `${path}/`,
+    ]
+
+    it.each(OPT_IN)(
+      'answers 404 for %s as written, encoded, in capitals and with a slash',
+      async (path) => {
+        const method = path.endsWith('check-api-key') ? 'GET' : 'POST'
+        for (const form of forms(path)) {
+          await expectRefused(send(form, { method, assertion: assertion(REF_A) }), 404, 'not_found')
+        }
+        expect(handler).not.toHaveBeenCalled()
+        expect(asked).toEqual([])
+      }
+    )
+
+    it.each([
+      '/api/ai',
+      '/api/mcp',
+      '/API/AI',
+      '/api/Mcp',
+      '/api/ai/',
+      '/api/mcp/x',
+      '/api/ai/sql/anything/else',
+      '/api/%6dcp',
+    ])('answers 404 for the bare path %s, whatever the method', async (path) => {
+      for (const method of ['GET', 'POST', 'OPTIONS', 'DELETE']) {
+        await expectRefused(send(path, { method, assertion: assertion(REF_A) }), 404, 'not_found')
+      }
+      expect(asked).toEqual([])
+    })
+
+    it('has thirteen such routes in this test’s tree, each matched by the router', () => {
+      expect(OPT_IN).toHaveLength(13)
+      for (const path of OPT_IN) expect(guard.readPath(router, path.toUpperCase()).route).toBe(path)
+    })
+  })
+
+  describe('a ref in the path', () => {
+    it.each([
+      ['a page', `/project/${REF_B}/editor`, 'GET'],
+      ['a page, in capitals', `/project/${REF_B.toUpperCase()}/editor`, 'GET'],
+      ['a page, in mixed case', `/project/${REF_B.replace('b', 'B')}`, 'GET'],
+      ['an API route', `/api/platform/pg-meta/${REF_B}/query`, 'POST'],
+      ['an API route, in capitals', `/API/PLATFORM/PG-META/${REF_B.toUpperCase()}/QUERY`, 'POST'],
+      ['a position that is no parameter', `/api/platform/profile/${REF_B}`, 'GET'],
+      ['a path no route has', `/x/${REF_B}/y`, 'GET'],
+      ['a server function’s path', `/_serverFn/${REF_B}`, 'GET'],
+      ['a percent-encoded letter', `/project/%62${REF_B.slice(1)}/editor`, 'GET'],
+      ['beside the project’s own ref', `/project/${REF_A}/${REF_B}`, 'GET'],
+      ['the last segment, before a slash', `/project/${REF_B}/`, 'GET'],
+    ])('answers 404 for another project’s ref in %s', async (_, path, method) => {
+      await expectRefused(send(path, { method, assertion: assertion(REF_A) }), 404, 'not_found')
+      expect(asked).toEqual([])
+      expect(handler).not.toHaveBeenCalled()
+    })
+
+    it.each([
+      `/project/${REF_A}/editor`,
+      `/project/${REF_A.toUpperCase()}/editor`,
+      `/project/${REF_A}`,
+      // not the shape of a ref: 19 and 21 characters, and a character outside it
+      `/project/${REF_B.slice(1)}/editor`,
+      `/project/${REF_B}0/editor`,
+      `/project/${REF_B.slice(1)}_/editor`,
+      `/org/${REF_A}`,
+    ])('passes %s for the assertion’s project', async (path) => {
+      const { response, seen } = await send(path, {
+        assertion: assertion(REF_A),
+      })
+      expect(response.status).toBe(200)
+      expect(seen.called).toBe(true)
+    })
+
+    it('reads no ref from the query, the body or a header', async () => {
+      const { response, seen } = await send(
+        `/api/platform/pg-meta/${REF_A}/query?ref=${REF_B}&project=${REF_B}`,
+        {
+          method: 'POST',
+          assertion: assertion(REF_A),
+          headers: {
+            'x-project-ref': REF_B,
+            'x-forwarded-host': `${REF_B}.studio.test`,
+            host: `${REF_B}.studio.test`,
+          },
+        }
+      )
+      expect(response.status).toBe(200)
+      expect((seen.context as any).ref).toBe(REF_A)
+    })
+  })
+
+  describe('an API path', () => {
+    it.each([
+      ['a route that is not in the build', '/api/platform/storage/x/buckets'],
+      ['the same with a slash', '/api/platform/storage/x/buckets/'],
+      ['the same in capitals', '/API/platform/storage/x/buckets'],
+      ['/api itself', '/api'],
+      ['/api/', '/api/'],
+      ['a path below a route', '/api/platform/profile/more'],
+      ['a route without handlers', '/api/no-handlers'],
+      ['a segment that only decodes twice', '/%2561pi/platform/profile/..%252f'],
+    ])('answers 404 for %s, whatever the method', async (_, path) => {
+      for (const method of ['GET', 'HEAD', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS']) {
+        if (!path.toLowerCase().startsWith('/api')) continue
+        const response = await expectRefused(
+          send(path, { method, assertion: assertion(REF_A) }),
+          404,
+          'not_found'
+        )
+        expect(response.headers.get('allow')).toBeNull()
+      }
+      expect(asked).toEqual([])
+    })
+
+    it.each([
+      ['/api/platform/profile', 'POST', 'GET, HEAD'],
+      ['/api/platform/profile', 'OPTIONS', 'GET, HEAD'],
+      ['/api/platform/profile/', 'DELETE', 'GET, HEAD'],
+      ['/API/Platform/Profile', 'PUT', 'GET, HEAD'],
+      [`/api/platform/pg-meta/${REF_A}/query`, 'GET', 'POST'],
+      [`/api/platform/pg-meta/${REF_A}/query`, 'HEAD', 'POST'],
+      [`/api/platform/projects/${REF_A}/content`, 'POST', 'DELETE, GET, HEAD, PUT'],
+      [`/api/platform/projects/${REF_A}/content`, 'PATCH', 'DELETE, GET, HEAD, PUT'],
+    ])('answers 405 with Allow for %s asked by %s', async (path, method, allow) => {
+      const response = await expectRefused(
