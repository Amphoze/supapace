+++ b/apps/studio/lib/api/self-hosted/request-guard.ts
@@ -0,0 +1,171 @@
+// SPDX-License-Identifier: Apache-2.0
+// The request guard: the first thing every request to this server meets, whatever it is for —
+// a route handler, a server function or a page. In order:
+//
+//   1. the gateway's assertion must verify, or the answer is 401;
+//   2. the path, read as the router reads it, must name no route that is not served and no
+//      project but the assertion's, or the answer is 404; a path under /api must match a route
+//      with a handler for the method, or the answer is 404 or 405;
+//   3. the control plane is asked for the assertion's project, and the rest of the request
+//      runs inside that project's context; its refusal is the answer.
+//
+// A refusal's body is {code, message}. The project is never taken from the path, the query, a
+// body or a header: the path can only disagree with the assertion, and then it is refused.
+
+import { checkAssertionSettings, verifyAssertion } from './assertion'
+import { checkSettings, resolve } from './dash-socket'
+import { orStop } from './limits'
+import { projectContext, ProjectError, runWithProject } from './project-context'
+
+const HEADER = 'x-supapace-assertion'
+// The header of the build's request for the application shell.
+const SHELL_HEADER = 'x-tss_shell'
+const REF_SHAPE = /^[a-z0-9]{20}$/
+
+/** What this module uses of the application's router: its own reading and matching of a path. */
+export type PathRouter = {
+  parseLocation: (location: any) => { pathname: string }
+  getMatchedRoutes: (pathname: string) => [unknown, Record<string, unknown>, any?]
+}
+
+export type PathReading = {
+  /** the path's segments as the router matches on them: decoded once, a trailing slash dropped */
+  segments: string[]
+  /** the full path of the route the path matches exactly, or null */
+  route: string | null
+  /** the methods that route's server handlers answer, or null when it has none */
+  methods: string[] | null
+}
+
+/** Reads a request path with the router's own decoder and matcher. */
+export function readPath(router: PathRouter, pathname: string): PathReading {
+  const path = router.parseLocation({
+    href: pathname,
+    pathname,
+    search: '',
+    hash: '',
+    state: {},
+  }).pathname
+  const [, params, found] = router.getMatchedRoutes(path)
+  // a match with a rest of the path left over is no match for a handler
+  const route = found && params['**'] === undefined ? found : undefined
+  // the handlers as the build registers them: an object, one member per method
+  const handlers = route?.options?.server?.handlers
+  return {
+    segments: path.replace(/\/+$/, '').split('/').slice(1),
+    route: route ? (route.fullPath as string) : null,
+    methods: handlers ? Object.keys(handlers).sort() : null,
+  }
+}
+
+/** Whether a route's handlers answer the method, as the server picks one: HEAD follows GET. */
+function answers(methods: string[], method: string): boolean {
+  const m = method.toUpperCase()
+  return methods.includes(m) || methods.includes('ANY') || (m === 'HEAD' && methods.includes('GET'))
+}
+
+function refusal(error: ProjectError, headers?: Record<string, string>): Response {
+  return Response.json(
+    { code: error.code, message: error.message },
+    { status: error.status, headers }
+  )
+}
+const notFound = () => refusal(new ProjectError(404, 'not_found', 'Not found'))
+
+// The server framework takes every path with this prefix for a server function, before any
+// route is matched.
+const SERVER_FUNCTIONS = '/_serverFn/'
+/** A path that is no API path and whose route, if it has one, has no server handler. */
+const isPage = ({ segments, methods }: PathReading) =>
+  segments[0]?.toLowerCase() !== 'api' && methods === null
+
+// --- the build's prerender -------------------------------------------------------------------
+
+let prerender: boolean | undefined
+
+/**
+ * True only in the build's prerender: the build starts this server once, without a node's
+ * settings, and asks for the application shell. The switch is the process's environment and
+ * nothing a request carries. A process that has the switch together with any setting of a
+ * node stops: a node never serves in this mode.
+ */
+function buildPrerender(): boolean {
+  return (prerender ??= orStop(() => {
+    if (process.env.TSS_PRERENDERING !== 'true') return false
+    if (
+      process.env.SUPAPACE_NODE_ID !== undefined ||
+      process.env.SUPAPACE_DASH_SOCKET !== undefined ||
+      process.env.SUPAPACE_DASH_KEYS !== undefined ||
+      process.env.SUPAPACE_DASH_DATA !== undefined ||
+      process.env.SUPAPACE_PGCAP !== undefined ||
+      process.env.SUPAPACE_PGMETA !== undefined ||
+      process.env.SUPAPACE_LIMITS !== undefined
+    ) {
+      throw new Error('TSS_PRERENDERING is set on a node: the build’s prerender is never served')
+    }
+    return true
+  }))
+}
+
+/**
+ * Run once when the process starts: every setting of a node is read and checked now, and a
+ * missing or malformed one stops the process before it serves. The build's prerender has none.
+ */
+export function checkStart() {
+  if (buildPrerender()) return
+  checkSettings()
+  checkAssertionSettings()
+}
+
+// --- the guard -------------------------------------------------------------------------------
+
+type GuardContext = { request: Request; pathname: string; next: () => unknown }
+let router: PathRouter | undefined
+
+/**
+ * The first request middleware. `pathname` is the request's path as the server framework hands
+ * it to a middleware; `getRouter` makes the application's router, once.
+ */
+export async function guardRequest(
+  { request, pathname, next }: GuardContext,
+  getRouter: () => PathRouter
+): Promise<unknown> {
+  if (buildPrerender()) {
+    // Only the page the build asks for passes: a GET with the shell's header and no
+    // assertion, for a path that is no server function and no API path and whose route has
+    // no server handler. Everything else is refused, and no setting is read for it.
+    const shell =
+      request.method === 'GET' &&
+      request.headers.get(SHELL_HEADER) === 'true' &&
+      !request.headers.has(HEADER) &&
+      !pathname.startsWith(SERVER_FUNCTIONS) &&
+      isPage(readPath((router ??= getRouter()), pathname))
+    return shell
+      ? next()
+      : refusal(new ProjectError(401, 'bad_assertion', 'The request carries no valid assertion'))
+  }
+  try {
+    const assertion = verifyAssertion(request.headers.get(HEADER))
+
+    const { segments, methods } = readPath((router ??= getRouter()), pathname)
+    const lower = segments.map((s) => s.toLowerCase())
+    const api = lower[0] === 'api'
+    if (api && (lower[1] === 'ai' || lower[1] === 'mcp')) return notFound()
+    if (lower.some((s) => REF_SHAPE.test(s) && s !== assertion.ref)) return notFound()
+    if (api) {
+      if (!methods) return notFound()
+      if (!answers(methods, request.method)) {
+        const allow = [...new Set(methods.includes('GET') ? [...methods, 'HEAD'] : methods)].sort()
+        return refusal(new ProjectError(405, 'method_not_allowed', 'Method not allowed'), {
+          allow: allow.join(', '),
+        })
+      }
+    }
+
+    const context = projectContext(assertion, await resolve(assertion))
+    return await runWithProject(context, () => next())
+  } catch (error) {
+    if (error instanceof ProjectError) return refusal(error)
+    throw error
+  }
+}
