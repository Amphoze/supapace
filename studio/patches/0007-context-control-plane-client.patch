+// SPDX-License-Identifier: Apache-2.0
+import { createDecipheriv } from 'node:crypto'
+import {
+  copyFileSync,
+  existsSync,
+  mkdirSync,
+  mkdtempSync,
+  readdirSync,
+  readFileSync,
+  rmSync,
+  statSync,
+  utimesSync,
+  writeFileSync,
+} from 'node:fs'
+import { createServer, type IncomingMessage, type Server, type ServerResponse } from 'node:http'
+import { createRequire } from 'node:module'
+import { tmpdir } from 'node:os'
+import { join, resolve as resolvePath } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import type { Assertion, ResolveAnswer } from './project-context'
+
+const VECTORS = resolvePath(import.meta.dirname, '../../../../../vectors')
+const LIMITS = readFileSync(join(VECTORS, 'limits.json'), 'utf8').trim()
+const DSN = JSON.parse(readFileSync(join(VECTORS, 'dsn.json'), 'utf8'))
+
+const REF_A = 'abcdefghij0123456789'
+const REF_B = 'bcdefghij0123456789a'
+const ISS = 'https://issuer.test'
+const PGCAP = '10.212.0.6:20000:21023'
+const DAY = 86_400_000
+// An answer's own time: the clock's, as the control plane writes it.
+const AT = new Date().toISOString().replace(/\.\d+Z$/, 'Z')
+
+const dsn = (login: string, password: string, port: number) =>
+  `postgresql://${login}:${password}@10.212.0.6:${port}/postgres?sslmode=disable`
+
+function answer(ref: string, port: number, over: Record<string, unknown> = {}): ResolveAnswer {
+  return {
+    ref,
+    name: `project ${port}`,
+    state: 'active',
+    db_version: '17.6.1',
+    pg_meta: port % 2,
+    dsn_rw: dsn('postgres', `rw-secret-${port}`, port),
+    dsn_ro: dsn('supabase_read_only_user', `ro-secret-${port}`, port),
+    api_url: `https://${ref}.example.test`,
+    data_api: {
+      schemas: ['public', 'graphql_public'],
+      extra_search_path: ['public', 'extensions'],
+      max_rows: null,
+    },
+    generation: 4,
+    at: AT,
+    ...over,
+  } as ResolveAnswer
+}
+
+// What a read_only member is answered: the same without the read-write string.
+function roAnswer(ref: string, port: number): ResolveAnswer {
+  const a = answer(ref, port)
+  delete (a as any).dsn_rw
+  return a
+}
+
+function who(ref: string, sub: string, role: Assertion['role'] = 'owner'): Assertion {
+  return {
+    text: `v1.assertion-of-${sub}-for-${ref}.signature`,
+    ref,
+    iss: ISS,
+    sub,
+    name: sub,
+    role,
+    purpose: '',
+  }
+}
+
+type Seen = {
+  method?: string
+  url?: string
+  headers: IncomingMessage['headers']
+  raw: string[]
+  body: number
+}
+type Handler = (req: IncomingMessage, res: ServerResponse, seen: Seen) => void
+
+const json =
+  (status: number, body: unknown): Handler =>
+  (_req, res) => {
+    const text = typeof body === 'string' ? body : JSON.stringify(body)
+    res.writeHead(status, { 'Content-Type': 'application/json' }).end(text)
+  }
+const refuse = (status: number, code: string) => json(status, { code })
+const silent: Handler = () => {}
+
+describe('api/self-hosted/dash-socket', () => {
+  let dir: string
+  let server: Server | undefined
+  let handler: Handler
+  let seen: Seen[]
+  let exit: ReturnType<typeof vi.spyOn>
+  let said: string[]
+
+  const sock = () => join(dir, 'dash.sock')
+  const cacheFile = (ref: string, cls: string) => join(dir, 'data', ref, 'cache', `${cls}.bin`)
+
+  async function listen() {
+    server = createServer((req, res) => {
+      const s: Seen = {
+        method: req.method,
+        url: req.url,
+        headers: req.headers,
+        raw: req.rawHeaders,
+        body: 0,
+      }
+      seen.push(s)
+      req.on('data', (c) => (s.body += c.length))
+      req.on('end', () => handler(req, res, s))
+    })
+    await new Promise<void>((done) => server!.listen(sock(), done))
+  }
+  async function stopListening() {
+    if (!server) return
+    server.closeAllConnections()
+    await new Promise((done) => server!.close(done))
+    server = undefined
+    rmSync(sock(), { force: true })
+  }
+
+  // The module as a server process loads it: environment first, then the import.
+  async function load(env: Record<string, string | undefined> = {}) {
+    vi.resetModules()
+    const all: Record<string, string | undefined> = {
+      SUPAPACE_DASH_SOCKET: sock(),
+      SUPAPACE_DASH_KEYS: join(dir, 'keys'),
+      SUPAPACE_DASH_DATA: join(dir, 'data'),
+      SUPAPACE_PGCAP: PGCAP,
+      SUPAPACE_LIMITS: LIMITS,
+      ...env,
+    }
+    for (const [name, value] of Object.entries(all)) {
+      vi.stubEnv(name, value ?? '')
+      if (value === undefined) delete process.env[name]
+    }
+    return await import('./dash-socket')
+  }
+  const quick = (ms: number) => ({
+    SUPAPACE_LIMITS: LIMITS.replace(/"socket_call_ms":\d+/, `"socket_call_ms":${ms}`),
+  })
+
+  beforeEach(async () => {
+    dir = mkdtempSync(join(tmpdir(), 'dash-'))
+    mkdirSync(join(dir, 'keys'))
+    mkdirSync(join(dir, 'data'))
+    writeFileSync(join(dir, 'keys', 'cache.key'), Buffer.alloc(32, 7).toString('base64url') + '\n')
+    seen = []
+    said = []
+    handler = json(200, answer(REF_A, 20001))
+    for (const level of ['log', 'info', 'warn', 'error'] as const) {
+      vi.spyOn(console, level).mockImplementation((...args: unknown[]) => {
+        said.push(args.map(String).join(' '))
+      })
+    }
+    exit = vi.spyOn(process, 'exit').mockImplementation(() => {
+      throw new Error('the process exited')
+    })
+    await listen()
+  })
+  afterEach(async () => {
+    await stopListening()
+    vi.unstubAllEnvs()
+    vi.restoreAllMocks()
+    rmSync(dir, { recursive: true, force: true })
+  })
+
+  // Nothing a caller could log or answer with may carry a credential.
+  function expectNoSecret(text: string) {
+    for (const secret of [
+      'rw-secret',
+      'ro-secret',
+      'postgresql://',
+      'v1.assertion-of',
+      '.signature',
+      'service-token',
+    ]) {
+      expect(text).not.toContain(secret)
+    }
+  }
+  async function refusal(p: Promise<unknown>) {
+    const e: any = await p.then(
+      () => undefined,
+      (e) => e
+    )
+    expect(e, 'the call was answered instead of refused').toBeDefined()
+    expect(e.name).toBe('ProjectError')
+    expectNoSecret(JSON.stringify(e) + e.message + e.stack)
+    return { status: e.status, code: e.code }
+  }
+
+  describe('resolve', () => {
+    it('asks the socket with the assertion and returns its answer, member for member', async () => {
+      const { resolve } = await load()
+      const a = who(REF_A, 'u-owner')
+      const got = await resolve(a)
+      expect(got).toEqual(answer(REF_A, 20001))
+      expect(Object.keys(got)).toEqual(Object.keys(answer(REF_A, 20001)))
+      expect(seen).toHaveLength(1)
+      expect(seen[0].method).toBe('POST')
+      expect(seen[0].url).toBe('/v1/resolve')
+      expect(seen[0].body).toBe(0)
+      expect(seen[0].headers['content-length']).toBe('0')
+      const names = seen[0].raw.filter((_, i) => i % 2 === 0).map((n) => n.toLowerCase())
+      // exactly these headers: the assertion once, and nowhere else
+      expect(names.sort()).toEqual(['connection', 'content-length', 'host', 'x-supapace-assertion'])
+      expect(seen[0].raw.filter((v) => v.includes('assertion-of'))).toEqual([a.text])
+      expect(seen[0].headers['x-supapace-assertion']).toBe(a.text)
+      expect(Object.isFrozen(got)).toBe(true)
+      expect(Object.isFrozen(got.data_api.schemas)).toBe(true)
+    })
+
+    it('answers a read_only member without a read-write string', async () => {
+      handler = json(200, roAnswer(REF_A, 20001))
+      const { resolve } = await load()
+      const got = await resolve(who(REF_A, 'u-ro', 'read_only'))
+      expect(got.dsn_rw).toBeUndefined()
+      expect('dsn_rw' in got).toBe(false)
+      expect(got.dsn_ro).toBe(dsn('supabase_read_only_user', 'ro-secret-20001', 20001))
+    })
+
+    it('drops a member it does not know, and keeps no member it has not checked', async () => {
+      handler = json(200, answer(REF_A, 20001, { surprise: 'postgresql://x', keys: { a: 1 } }))
+      const { resolve } = await load()
+      const got = await resolve(who(REF_A, 'u-owner'))
+      expect(got).toEqual(answer(REF_A, 20001))
+    })
+
+    it('keeps an answer in memory 60 s per (ref, iss, sub, role class)', async () => {
+      // the 60 s are elapsed time: the clock that only moves forward
+      const now = vi.spyOn(performance, 'now')
+      const t0 = 5_000_000
+      now.mockReturnValue(t0)
+      const { resolve } = await load()
+      const x = who(REF_A, 'u-x')
+      await resolve(x)
+      expect(seen).toHaveLength(1)
+
+      // warm: the same principal, also as the other role of its class, asks nothing
+      now.mockReturnValue(t0 + 59_999)
+      await resolve(x)
+      await resolve({ ...x, role: 'developer' })
+      await resolve({
+        ...x,
+        text: 'v1.assertion-of-a-later-request.signature',
+        name: 'renamed',
+      })
+      expect(seen).toHaveLength(1)
+
+      // each other member of the key asks the socket
+      handler = (req, res, s) =>
+        (req.headers['x-supapace-assertion'] as string).includes(REF_B)
+          ? json(200, answer(REF_B, 20002))(req, res, s)
+          : (req.headers['x-supapace-assertion'] as string).includes('u-ro')
+            ? json(200, roAnswer(REF_A, 20001))(req, res, s)
+            : json(200, answer(REF_A, 20001))(req, res, s)
+      await resolve(who(REF_A, 'u-y'))
+      expect(seen).toHaveLength(2)
+      await resolve({ ...x, iss: 'https://other-issuer.test' })
+      expect(seen).toHaveLength(3)
+      await resolve(who(REF_B, 'u-x'))
+      expect(seen).toHaveLength(4)
+      await resolve({ ...who(REF_A, 'u-ro', 'read_only'), sub: 'u-x' })
+      expect(seen).toHaveLength(5)
+
+      // at 60 s the entry is gone
+      now.mockReturnValue(t0 + 60_000)
+      await resolve(x)
+      expect(seen).toHaveLength(6)
+    })
+
+    it('does not join the parts of the key ambiguously', async () => {
+      const { resolve } = await load()
+      await resolve({ ...who(REF_A, 'u'), iss: 'a","b', sub: 'c' })
+      await resolve({ ...who(REF_A, 'u'), iss: 'a', sub: 'b","c' })
+      expect(seen).toHaveLength(2)
+    })
+
+    it('never serves a member from an entry another member warmed', async () => {
+      const { resolve } = await load()
+      const x = who(REF_A, 'u-x')
+      const y = who(REF_A, 'u-y')
+      await resolve(x)
+      handler = refuse(403, 'not_a_member')
+      // Y, of the same project and role class, is asked about and refused, X's entry notwithstanding
+      expect(await refusal(resolve(y))).toEqual({
+        status: 403,
+        code: 'not_a_member',
+      })
+      expect(seen).toHaveLength(2)
+      expect(seen[1].headers['x-supapace-assertion']).toBe(y.text)
+      // control: X's entry is warm and still answers X
+      expect(await resolve(x)).toEqual(answer(REF_A, 20001))
+      expect(seen).toHaveLength(2)
+    })
+
+    it('asks once for requests of one member that arrive together', async () => {
+      let release!: () => void
+      const held = new Promise<void>((r) => (release = r))
+      handler = (req, res, s) => void held.then(() => json(200, answer(REF_A, 20001))(req, res, s))
+      const { resolve } = await load()
+      const x = who(REF_A, 'u-x')
+      const all = Promise.all([resolve(x), resolve(x), resolve(x), resolve(who(REF_A, 'u-y'))])
+      await vi.waitFor(() => expect(seen).toHaveLength(2))
+      release()
+      for (const got of await all) expect(got).toEqual(answer(REF_A, 20001))
+      expect(seen).toHaveLength(2)
+    })
+
+    it('holds a bounded number of entries', async () => {
+      vi.spyOn(performance, 'now').mockReturnValue(5_000_000)
+      handler = (req, res, s) => json(200, answer(REF_A, 20001))(req, res, s)
+      const m = await load()
+      for (let i = 0; i <= m.MEMORY_ENTRIES; i++) await m.resolve(who(REF_A, `u-${i}`))
+      expect(seen).toHaveLength(m.MEMORY_ENTRIES + 1)
+      // the oldest was dropped for the newest; the second oldest is still warm
+      await m.resolve(who(REF_A, 'u-1'))
+      expect(seen).toHaveLength(m.MEMORY_ENTRIES + 1)
+      await m.resolve(who(REF_A, 'u-0'))
+      expect(seen).toHaveLength(m.MEMORY_ENTRIES + 2)
+    }, 60_000)
+  })
+
+  describe('the disk entry', () => {
+    it('is written by rename, encrypted, under the project and role class', async () => {
+      const now = vi.spyOn(performance, 'now')
+      now.mockReturnValue(1_000)
+      const { resolve } = await load()
+      await resolve(who(REF_A, 'u-x'))
+      const file = cacheFile(REF_A, 'rw')
+      const first = statSync(file)
+      expect(readdirSync(join(dir, 'data', REF_A, 'cache'))).toEqual(['rw.bin'])
+      expect(first.mode & 0o777).toBe(0o600)
+      expect(statSync(join(dir, 'data', REF_A, 'cache')).mode & 0o777).toBe(0o700)
+
+      const bytes = readFileSync(file)
+      expectNoSecret(bytes.toString('latin1'))
+      expect(bytes.toString('latin1')).not.toContain(REF_A)
+      expect(bytes.toString('latin1')).not.toContain('10.212.0.6')
+      // 12-byte nonce, the answer's JSON, the 16-byte tag
+      expect(bytes.length).toBe(12 + Buffer.byteLength(JSON.stringify(answer(REF_A, 20001))) + 16)
+      // AES-256-GCM under the cache key, bound to the project and the role class
+      const open = (bound: string) => {
+        const d = createDecipheriv('aes-256-gcm', Buffer.alloc(32, 7), bytes.subarray(0, 12))
+        d.setAAD(Buffer.from(bound))
+        d.setAuthTag(bytes.subarray(bytes.length - 16))
+        return Buffer.concat([
+          d.update(bytes.subarray(12, bytes.length - 16)),
+          d.final(),
+        ]).toString()
+      }
+      expect(JSON.parse(open(`${REF_A}:rw`))).toEqual(answer(REF_A, 20001))
+      for (const other of [`${REF_B}:rw`, `${REF_A}:ro`, REF_A, 'rw', ''])
+        expect(() => open(other)).toThrow()
+
+      // the next answer replaces the file by a new one (a rename), never writes into it
+      now.mockReturnValue(61_000)
+      await resolve(who(REF_A, 'u-x'))
+      expect(seen).toHaveLength(2)
+      const second = statSync(file)
+      expect(second.ino).not.toBe(first.ino)
+      expect(readFileSync(file).subarray(0, 12)).not.toEqual(bytes.subarray(0, 12))
+      expect(readdirSync(join(dir, 'data', REF_A, 'cache'))).toEqual(['rw.bin'])
+    })
+
+    it('is kept per role class: a read_only entry holds no read-write string', async () => {
+      handler = json(200, roAnswer(REF_A, 20001))
+      const m = await load()
+      await m.resolve(who(REF_A, 'u-ro', 'read_only'))
+      expect(readdirSync(join(dir, 'data', REF_A, 'cache'))).toEqual(['ro.bin'])
+      await stopListening()
+      const again = await load()
+      const got = await again.resolve(who(REF_A, 'u-other', 'read_only'))
+      expect(got).toEqual(roAnswer(REF_A, 20001))
+      // and a read-write member finds no entry of its class
+      expect(await refusal(again.resolve(who(REF_A, 'u-x')))).toEqual({
+        status: 503,
+        code: 'project_unavailable',
+      })
+    })
+
+    it('fails to open under another project’s or another class’s name', async () => {
+      handler = (req, res, s) =>
+        (req.headers['x-supapace-assertion'] as string).includes(REF_B)
+          ? json(200, answer(REF_B, 20002))(req, res, s)
+          : json(200, answer(REF_A, 20001))(req, res, s)
+      const first = await load()
+      await first.resolve(who(REF_A, 'u-x'))
+      await first.resolve(who(REF_B, 'u-x'))
+      await stopListening()
+
+      // control: on silence each project's own entry opens
+      const own = await load()
+      expect((await own.resolve(who(REF_A, 'u-x'))).ref).toBe(REF_A)
+      expect((await own.resolve(who(REF_B, 'u-x'))).ref).toBe(REF_B)
+
+      // A's file under B's name, and A's read-write file under A's read-only name
+      copyFileSync(cacheFile(REF_A, 'rw'), cacheFile(REF_B, 'rw'))
+      copyFileSync(cacheFile(REF_A, 'rw'), cacheFile(REF_A, 'ro'))
+      const moved = await load()
+      expect(await refusal(moved.resolve(who(REF_B, 'u-x')))).toEqual({
+        status: 503,
+        code: 'project_unavailable',
+      })
+      expect(await refusal(moved.resolve(who(REF_A, 'u-ro', 'read_only')))).toEqual({
+        status: 503,
+        code: 'project_unavailable',
+      })
+      expect((await moved.resolve(who(REF_A, 'u-x'))).ref).toBe(REF_A)
+    })
+
+    it('does not open under another key, cut short, or changed in one byte', async () => {
+      const first = await load()
+      await first.resolve(who(REF_A, 'u-x'))
+      await stopListening()
+      const file = cacheFile(REF_A, 'rw')
+      const good = readFileSync(file)
+      const unavailable = { status: 503, code: 'project_unavailable' }
+      const m = await load()
+
+      writeFileSync(file, good.subarray(0, good.length - 1))
+      expect(await refusal(m.resolve(who(REF_A, 'u-x')))).toEqual(unavailable)
+      const flipped = Buffer.from(good)
+      flipped[20] ^= 1
+      writeFileSync(file, flipped)
+      expect(await refusal(m.resolve(who(REF_A, 'u-x')))).toEqual(unavailable)
+      writeFileSync(file, Buffer.alloc(5))
+      expect(await refusal(m.resolve(who(REF_A, 'u-x')))).toEqual(unavailable)
+      writeFileSync(file, good)
+      expect((await m.resolve(who(REF_A, 'u-x'))).ref).toBe(REF_A)
+
+      writeFileSync(
+        join(dir, 'keys', 'cache.key'),
+        Buffer.alloc(32, 8).toString('base64url') + '\n'
+      )
+      const rekeyed = await load()
+      expect(await refusal(rekeyed.resolve(who(REF_A, 'u-x')))).toEqual(unavailable)
+    })
+
+    it('is used when the socket refuses the connection', async () => {
+      const first = await load()
+      await first.resolve(who(REF_A, 'u-x'))
+      await stopListening()
+
+      // a new process: nothing in memory; no listener at the path (the file is gone)
+      const gone = await load()
+      expect(await gone.resolve(who(REF_A, 'u-y'))).toEqual(answer(REF_A, 20001))
+      // and with a socket file nobody listens on
+      writeFileSync(sock(), '')
+      const stale = await load()
+      expect(await stale.resolve(who(REF_A, 'u-y'))).toEqual(answer(REF_A, 20001))
+      // control: a project with no entry is unavailable
+      expect(await refusal(stale.resolve(who(REF_B, 'u-y')))).toEqual({
+        status: 503,
+        code: 'project_unavailable',
+      })
+    })
+
+    it('is used when the socket gives no answer inside the call’s bound', async () => {
+      const first = await load()
+      await first.resolve(who(REF_A, 'u-x'))
+      handler = silent
+      const m = await load(quick(150))
+      expect(await m.resolve(who(REF_A, 'u-y'))).toEqual(answer(REF_A, 20001))
+      expect(seen).toHaveLength(2)
+      expect(await refusal(m.resolve(who(REF_B, 'u-y')))).toEqual({
+        status: 503,
+        code: 'project_unavailable',
+      })
+      // nothing read on silence is kept in memory: the next request asks again
+      await m.resolve(who(REF_A, 'u-y'))
+      expect(seen).toHaveLength(4)
+    })
+
+    it('is used when the socket closes the connection without an answer', async () => {
+      const first = await load()
+      await first.resolve(who(REF_A, 'u-x'))
+      handler = (req) => req.socket.destroy()
+      const m = await load()
+      expect(await m.resolve(who(REF_A, 'u-y'))).toEqual(answer(REF_A, 20001))
+    })
+
+    const refusals: [string, Handler, { status: number; code: string }][] = [
+      ['401 bad_assertion', refuse(401, 'bad_assertion'), { status: 401, code: 'bad_assertion' }],
+      ['403 not_a_member', refuse(403, 'not_a_member'), { status: 403, code: 'not_a_member' }],
+      ['404 not_here', refuse(404, 'not_here'), { status: 404, code: 'not_here' }],
+      ['429 rate_limited', refuse(429, 'rate_limited'), { status: 429, code: 'rate_limited' }],
+      ['503 unavailable', refuse(503, 'unavailable'), { status: 503, code: 'unavailable' }],
+      ['403 peer', refuse(403, 'peer'), { status: 503, code: 'project_unavailable' }],
