@@ -0,0 +1,540 @@
+// SPDX-License-Identifier: Apache-2.0
+// The control-plane client. What the dashboard knows about a project it asks the dashboard
+// socket — a Unix socket of the control plane — presenting the gateway's assertion; the
+// control plane checks the assertion and the membership again and answers for that project
+// alone. Every answer is bounded and checked before it is used.
+//
+// An answer to `resolve` is kept in memory for a short time, per principal, and encrypted on
+// disk per project and role class. The disk entry stands in only when the socket gives no
+// answer at all; whatever the socket answers, a refusal included, is final.
+
+import { createCipheriv, createDecipheriv, randomBytes } from 'node:crypto'
+import {
+  mkdirSync,
+  opendirSync,
+  readFileSync,
+  renameSync,
+  rmSync,
+  statSync,
+  writeFileSync,
+} from 'node:fs'
+import { request } from 'node:http'
+import { isAbsolute, join } from 'node:path'
+import z from 'zod'
+
+import { limits, orStop } from './limits'
+import {
+  ProjectError,
+  roleClass,
+  type Assertion,
+  type ResolveAnswer,
+  type RoleClass,
+} from './project-context'
+
+/** The answer to `keys`. The service_role key is there for an owner under the purpose reveal alone. */
+export type KeysAnswer = {
+  anon_key: string
+  signing_keys: readonly {
+    kid: string
+    class: string
+    alg: 'RS256'
+    kty: 'RSA'
+    n: string
+    e: string
+  }[]
+  service_role_key?: string
+}
+
+/** The wire proxy's address and the port range of its postgres-meta class. */
+export type Pgcap = { addr: string; lo: number; hi: number }
+
+/** An answer of the socket is read up to this size; a longer one is not an answer. */
+export const MAX_ANSWER_BYTES = 64 * 1024
+/** The memory cache holds at most this many entries. */
+export const MEMORY_ENTRIES = 4096
+/** Before a write, at most this many names of the cache directory are looked at for leftovers. */
+export const SWEEP_NAMES = 64
+
+const HEADER = 'X-Supapace-Assertion'
+const REF = /^[a-z0-9]{20}$/
+const TOKEN = /^[A-Za-z0-9._-]{1,4096}$/
+const DAY_MS = 86_400_000
+// A disk entry dated further ahead of the clock than this is no proof of a recent answer.
+const CLOCK_SKEW_MS = 60_000
+const NONCE_BYTES = 12
+const TAG_BYTES = 16
+
+// --- configuration, read once, at the first use ----------------------------------------------
+
+function absolute(name: string, value: string | undefined): string {
+  if (!value || !isAbsolute(value)) throw new Error(`${name} is not set to an absolute path`)
+  return value
+}
+
+/** `<IPv4 address>:<first port>:<last port>`, each in its canonical decimal form. */
+function parsePgcap(text: string | undefined): Pgcap {
+  const octet = '(?:0|[1-9][0-9]{0,2})'
+  const port = '([1-9][0-9]{0,4})'
+  const m = new RegExp(`^(${octet}(?:\\.${octet}){3}):${port}:${port}$`).exec(text ?? '')
+  const pgcap = m && { addr: m[1], lo: Number(m[2]), hi: Number(m[3]) }
+  if (
+    !pgcap ||
+    pgcap.addr.split('.').some((o) => Number(o) > 255) ||
+    pgcap.lo > pgcap.hi ||
+    pgcap.hi > 65535
+  ) {
+    throw new Error('SUPAPACE_PGCAP is not <address>:<first port>:<last port>')
+  }
+  return pgcap
+}
+
+/** The cache key file: 32 bytes as 43 base64url characters and at most one line end. */
+function readCacheKey(file: string): Buffer {
+  let text: string
+  try {
+    text = readFileSync(file, 'latin1')
+  } catch {
+    throw new Error('the cache key file cannot be read')
+  }
+  const encoded = text.replace(/=?\n?$/, '')
+  const key = Buffer.from(encoded, 'base64url')
+  // 43 characters with no unused bit set are exactly 32 bytes
+  if (!/^[A-Za-z0-9_-]{43}$/.test(encoded) || key.toString('base64url') !== encoded) {
+    throw new Error('the cache key file does not hold 32 bytes in base64url')
+  }
+  return key
+}
+
+type Config = { socket: string; data: string; cacheKey: Buffer; pgcap: Pgcap }
+let loaded: Config | undefined
+
+/**
+ * The node's settings of this module, read and checked at the first call — never when the
+ * module loads, which the build does too. A missing or malformed one stops the process.
+ */
+function config(): Config {
+  return (loaded ??= orStop(() => ({
+    socket: absolute('SUPAPACE_DASH_SOCKET', process.env.SUPAPACE_DASH_SOCKET),
+    data: absolute('SUPAPACE_DASH_DATA', process.env.SUPAPACE_DASH_DATA),
+    cacheKey: readCacheKey(
+      join(absolute('SUPAPACE_DASH_KEYS', process.env.SUPAPACE_DASH_KEYS), 'cache.key')
+    ),
+    pgcap: parsePgcap(process.env.SUPAPACE_PGCAP),
+  })))
+}
+
+/**
+ * Reads and checks every setting of the control-plane client now; a missing or malformed one
+ * stops the process, with the line the first use would give. For a server start hook: the
+ * modules themselves read nothing when they load.
+ */
+export function checkSettings() {
+  limits()
+  config()
+}
+
+// --- the connection string ------------------------------------------------------------------
+
+const DSN_SCHEME = 'postgresql://'
+const DSN_TAIL = '/postgres?sslmode=disable'
+const LOGIN_RW = 'postgres'
+const LOGIN_RO = 'supabase_read_only_user'
+const UNRESERVED = /[A-Za-z0-9\-._~]/
+
+/**
+ * Accepts the one form of connection string the control plane renders and nothing else:
+ * `postgresql://<login>:<password>@<proxy address>:<port>/postgres?sslmode=disable` — one of
+ * the two logins; a password of one or more printable ASCII bytes, every byte outside
+ * `A-Z a-z 0-9 - . _ ~` written `%XX` in upper case; the proxy's address; a port of its
+ * range in canonical decimal; at most 512 bytes. The control plane makes the same check on
+ * the same vectors. A refusal's message never holds the string.
+ */
+export function checkDsn(
+  dsn: string,
+  pgcap: Pgcap = config().pgcap
+): {
+  login: typeof LOGIN_RW | typeof LOGIN_RO
+  port: number
+  password: string
+} {
+  const refuse = (why: string): never => {
+    throw new Error(`dsn: ${why}`)
+  }
+  if (typeof dsn !== 'string' || Buffer.byteLength(dsn) > 512) return refuse('too long')
+  if (!pgcap.addr || pgcap.lo < 1 || pgcap.hi < pgcap.lo) return refuse('no proxy address')
+  if (!dsn.startsWith(DSN_SCHEME)) return refuse('not postgresql://')
+  if (!dsn.endsWith(DSN_TAIL)) return refuse('not database postgres with sslmode=disable alone')
+  const rest = dsn.slice(DSN_SCHEME.length, dsn.length - DSN_TAIL.length)
+  const at = rest.indexOf('@')
+  if (at < 0) return refuse('no login')
+  const user = rest.slice(0, at)
+  const hostPort = rest.slice(at + 1)
+  const colon = user.indexOf(':')
+  const login = user.slice(0, colon)
+  if (colon < 0 || (login !== LOGIN_RW && login !== LOGIN_RO))
+    return refuse('not one of the two logins')
+
+  const encoded = user.slice(colon + 1)
+  let password = ''
+  for (let i = 0; i < encoded.length; i++) {
+    let byte = encoded.charCodeAt(i)
+    if (encoded[i] === '%') {
+      const hex = encoded.slice(i + 1, i + 3)
+      if (!/^[0-9A-F]{2}$/.test(hex)) return refuse('password not in the canonical encoding')
+      byte = parseInt(hex, 16)
+      i += 2
+      if (UNRESERVED.test(String.fromCharCode(byte)))
+        return refuse('password not in the canonical encoding')
+    } else if (!UNRESERVED.test(encoded[i])) {
+      return refuse('password not in the canonical encoding')
+    }
+    if (byte < 0x20 || byte > 0x7e) return refuse('password not in the canonical encoding')
+    password += String.fromCharCode(byte)
+  }
+  if (password === '') return refuse('password not in the canonical encoding')
+
+  const sep = hostPort.indexOf(':')
+  if (sep < 0 || hostPort.slice(0, sep) !== pgcap.addr) return refuse("not the proxy's address")
+  const portText = hostPort.slice(sep + 1)
+  const port = /^[1-9][0-9]{0,4}$/.test(portText) ? Number(portText) : 0
+  if (port < pgcap.lo || port > pgcap.hi) return refuse('port outside the meta range')
+  return { login, port, password }
+}
+
+// --- the answers, checked ---------------------------------------------------------------------
+
+const count = z.number().int().min(0).max(Number.MAX_SAFE_INTEGER)
+const names = z.array(z.string().min(1).max(128)).max(64)
+
+const resolveSchema = z.object({
+  ref: z.string().regex(REF),
+  name: z.string().max(255),
+  state: z.enum(['active', 'restarting', 'restoring']),
+  db_version: z.string().regex(/^[0-9A-Za-z._-]{1,64}$/),
+  pg_meta: z.union([z.literal(0), z.literal(1)]),
+  dsn_rw: z.string().optional(),
+  dsn_ro: z.string().optional(),
+  api_url: z.string().regex(/^https:\/\/[a-z0-9]{20}\.[a-z0-9.-]{1,253}$/),
+  data_api: z.object({
+    schemas: names,
+    extra_search_path: names,
+    max_rows: count.nullable(),
+  }),
+  generation: count,
+  at: z.string().regex(/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(\.\d{1,9})?Z$/),
+})
+
+const keysSchema = z.object({
+  anon_key: z.string().regex(TOKEN),
+  signing_keys: z
+    .array(
+      z.object({
+        kid: z.string().min(1).max(128),
+        class: z.string().min(1).max(32),
+        alg: z.literal('RS256'),
+        kty: z.literal('RSA'),
+        n: z.string().regex(/^[A-Za-z0-9_-]{1,1024}$/),
+        e: z.string().regex(/^[A-Za-z0-9_-]{1,16}$/),
+      })
+    )
+    .max(16),
+  service_role_key: z.string().regex(TOKEN).optional(),
+})
+
+const invalid = (): never => {
+  throw new Error('invalid answer')
+}
+
+/**
+ * An answer to `resolve` for `ref` and a role class, or a throw. Only the members checked
+ * here are kept. A read-write member's answer has the read-write string; a read_only
+ * member's must not; both strings, where present, name the two logins at one port.
+ */
+function checkResolve(value: unknown, ref: string, cls: RoleClass): ResolveAnswer {
+  const answer = resolveSchema.parse(value)
+  if (answer.ref !== ref || answer.api_url.slice(8, 28) !== ref) invalid()
+  if ((answer.dsn_rw !== undefined) !== (cls === 'rw')) invalid()
+  const rw = answer.dsn_rw === undefined ? undefined : checkDsn(answer.dsn_rw)
+  const ro = answer.dsn_ro === undefined ? undefined : checkDsn(answer.dsn_ro)
+  if (rw && rw.login !== LOGIN_RW) invalid()
+  if (ro && ro.login !== LOGIN_RO) invalid()
+  if (rw && ro && rw.port !== ro.port) invalid()
+  Object.freeze(answer.data_api.schemas)
+  Object.freeze(answer.data_api.extra_search_path)
+  Object.freeze(answer.data_api)
+  return Object.freeze(answer)
+}
+
+function checkKeys(value: unknown, a: Assertion): KeysAnswer {
+  const answer = keysSchema.parse(value)
+  if (answer.service_role_key !== undefined && !(a.role === 'owner' && a.purpose === 'reveal'))
+    invalid()
+  return answer
+}
+
+// --- one call ---------------------------------------------------------------------------------
+
+const unavailable = () =>
+  new ProjectError(503, 'project_unavailable', 'The project is not available')
+
+// The refusals of the control plane that are the request's answer, with the status each has.
+const REFUSALS = new Map([
+  ['bad_assertion', 401],
+  ['not_a_member', 403],
+  ['not_here', 404],
+  ['rate_limited', 429],
+  ['unavailable', 503],
+])
+
+/** Who asks, checked before anything of it is used in a path, a header or a cache key. */
+function checkCaller(a: Assertion): RoleClass {
+  const cls = roleClass(a.role)
+  const texts = [a.ref, a.text, a.iss, a.sub].every((s) => typeof s === 'string' && s !== '')
+  if (!texts || !REF.test(a.ref) || !TOKEN.test(a.text)) {
+    throw new ProjectError(401, 'bad_assertion', 'The request carries no valid assertion')
+  }
+  return cls
+}
+
+type Reply = { status: number; body?: Buffer }
+
+/**
+ * One request to the socket, within the call's bound. Resolves with the answer's status and
+ * its body — no body when it did not arrive whole or is longer than the bound — or with
+ * undefined when the socket gave no answer: no connection, or no response in time.
+ */
+function call(path: string, assertion: string): Promise<Reply | undefined> {
+  const bound = limits().socket_call_ms
+  const { socket } = config()
+  return new Promise((done) => {
+    let reply: Reply | undefined
+    const finish = (r: Reply | undefined) => {
+      clearTimeout(timer)
+      req.destroy()
+      done(r)
+    }
+    const req = request({
+      socketPath: socket,
+      path,
+      method: 'POST',
+      agent: false,
+      maxHeaderSize: 8192,
+      headers: { [HEADER]: assertion, 'Content-Length': 0 },
+    })
+    const timer = setTimeout(() => finish(reply), bound)
+    req.on('response', (res) => {
+      const status = res.statusCode ?? 0
+      reply = { status }
+      const chunks: Buffer[] = []
+      let size = 0
+      res.on('data', (chunk: Buffer) => {
+        size += chunk.length
+        if (size > MAX_ANSWER_BYTES) finish(reply)
+        else chunks.push(chunk)
+      })
+      res.on('end', () => finish(res.complete ? { status, body: Buffer.concat(chunks) } : reply))
+      res.on('error', () => finish(reply))
+      res.on('close', () => finish(reply))
+    })
+    // Bytes that are not HTTP are an answer, if a useless one; anything else before a
+    // response is the socket not answering.
+    req.on('error', (error: NodeJS.ErrnoException) =>
+      finish(reply ?? (error.code?.startsWith('HPE_') ? { status: 0 } : undefined))
+    )
+    req.end()
+  })
+}
+
+/**
+ * Asks the socket. Returns the checked answer, or undefined when the socket gave none.
+ * A refusal throws with its status and code; an answer that cannot be used throws 503.
+ */
+async function ask<T>(
+  path: string,
+  a: Assertion,
+  check: (value: unknown) => T
+): Promise<T | undefined> {
+  const reply = await call(path, a.text)
+  if (!reply) return undefined
+  let value: unknown
+  try {
+    value = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(reply.body))
+  } catch {
+    value = undefined
+  }
+  if (reply.status !== 200) {
+    const code = z.object({ code: z.string() }).safeParse(value).data?.code ?? ''
+    if (REFUSALS.get(code) !== reply.status) throw unavailable()
+    throw new ProjectError(reply.status, code, 'The control plane refused the request')
+  }
+  try {
+    return check(value)
+  } catch {
+    console.error(`supapace: the control plane's answer to ${path} for ${a.ref} cannot be used`)
+    throw unavailable()
+  }
+}
+
+// --- the disk entry -----------------------------------------------------------------------------
+
+const cacheDir = (ref: string) => join(config().data, ref, 'cache')
+const errno = (error: unknown) => (error as NodeJS.ErrnoException)?.code ?? 'error'
+
+// A temporary file of this client: `<class>.<16 hex>.tmp`. One is left when the process ends
+// between a write and its rename. A write and its rename run without a pause in between and
+// one process writes the directory, so any that is found before a write is such a leftover.
+const LEFTOVER = /^(?:rw|ro)\.[0-9a-f]{16}\.tmp$/
+
+/** Removes leftovers from a cache directory, looking at a bounded number of its names. */
+function sweepLeftovers(dir: string) {
+  try {
+    const names = opendirSync(dir)
+    try {
+      for (let seen = 0; seen < SWEEP_NAMES; seen++) {
+        const entry = names.readSync()
+        if (!entry) break
+        if (LEFTOVER.test(entry.name)) rmSync(join(dir, entry.name), { force: true })
+      }
+    } finally {
+      names.closeSync()
+    }
+  } catch {
+    // a leftover that stays is harmless; the write goes on
+  }
+}
+
+/** Writes the entry of (ref, class): nonce, AES-256-GCM of the answer's JSON, tag; by rename. */
+function writeEntry(ref: string, cls: RoleClass, answer: ResolveAnswer) {
+  try {
+    const dir = cacheDir(ref)
+    mkdirSync(dir, { recursive: true, mode: 0o700 })
+    sweepLeftovers(dir)
+    const nonce = randomBytes(NONCE_BYTES)
+    const cipher = createCipheriv('aes-256-gcm', config().cacheKey, nonce)
+    cipher.setAAD(Buffer.from(`${ref}:${cls}`))
+    const sealed = Buffer.concat([
+      nonce,
+      cipher.update(JSON.stringify(answer), 'utf8'),
+      cipher.final(),
+      cipher.getAuthTag(),
+    ])
+    const tmp = join(dir, `${cls}.${randomBytes(8).toString('hex')}.tmp`)
+    try {
+      writeFileSync(tmp, sealed, { mode: 0o600 })
+      renameSync(tmp, join(dir, `${cls}.bin`))
+    } catch (error) {
+      rmSync(tmp, { force: true })
+      throw error
+    }
+  } catch (error) {
+    console.error(`supapace: the cache entry of ${ref} could not be written (${errno(error)})`)
+  }
+}
+
+/**
+ * The entry of (ref, class), if the socket last answered for it within the entry's lifetime
+ * and it opens under this project's and class's name. Reading changes nothing on disk.
+ */
+function readEntry(ref: string, cls: RoleClass): ResolveAnswer | undefined {
+  try {
+    const file = join(cacheDir(ref), `${cls}.bin`)
+    const stat = statSync(file)
+    const age = Date.now() - stat.mtimeMs
+    if (age > limits().resolve_disk_days * DAY_MS || age < -CLOCK_SKEW_MS) return undefined
+    if (!stat.isFile() || stat.size > NONCE_BYTES + MAX_ANSWER_BYTES + TAG_BYTES) return undefined
+    const sealed = readFileSync(file)
+    const decipher = createDecipheriv(
+      'aes-256-gcm',
+      config().cacheKey,
+      sealed.subarray(0, NONCE_BYTES)
+    )
+    decipher.setAAD(Buffer.from(`${ref}:${cls}`))
+    decipher.setAuthTag(sealed.subarray(sealed.length - TAG_BYTES))
+    const plain = Buffer.concat([
+      decipher.update(sealed.subarray(NONCE_BYTES, sealed.length - TAG_BYTES)),
+      decipher.final(),
+    ])
+    const kept = checkResolve(JSON.parse(plain.toString('utf8')), ref, cls)
+    // the answer's own time bounds the entry too: a file time can be a copy's
+    const answered = Date.now() - Date.parse(kept.at)
+    if (!(answered <= limits().resolve_disk_days * DAY_MS && answered >= -CLOCK_SKEW_MS)) {
+      return undefined
+    }
+    return kept
+  } catch (error) {
+    if (errno(error) !== 'ENOENT')
+      console.error(`supapace: the cache entry of ${ref} cannot be used`)
+    return undefined
+  }
+}
+
+// --- resolve, keys --------------------------------------------------------------------------------
+
+// `until` is a reading of the clock that only moves forward (performance.now): an entry's
+// life is elapsed time, whatever is done to the wall clock.
+type Entry = { ref: string; answer: ResolveAnswer; until: number }
+// Keyed per principal — (ref, iss, sub, role class): a member is never answered from an entry
+// another member warmed.
+const memory = new Map<string, Entry>()
+const flights = new Map<string, Promise<ResolveAnswer>>()
+
+function remember(key: string, entry: Entry) {
+  // ponytail: a full map is swept on insert, O(entries); a heap by expiry if that ever shows.
+  if (memory.size >= MEMORY_ENTRIES) {
+    for (const [k, e] of memory) if (e.until <= performance.now()) memory.delete(k)
+  }
+  if (memory.size >= MEMORY_ENTRIES) memory.delete(memory.keys().next().value!)
+  memory.delete(key)
+  memory.set(key, entry)
+}
+
+async function fresh(a: Assertion, cls: RoleClass, key: string): Promise<ResolveAnswer> {
+  const answer = await ask('/v1/resolve', a, (value) => checkResolve(value, a.ref, cls))
+  if (answer) {
+    remember(key, {
+      ref: a.ref,
+      answer,
+      until: performance.now() + limits().resolve_memory_s * 1000,
+    })
+    writeEntry(a.ref, cls, answer)
+    return answer
+  }
+  // The socket gave no answer. Only now, and without keeping it in memory, the disk entry.
+  const kept = readEntry(a.ref, cls)
+  if (!kept) throw unavailable()
+  return kept
+}
+
+/**
+ * What the control plane answers about the assertion's project, for the assertion's
+ * principal. Throws a ProjectError: the control plane's refusal, or 503 when there is
+ * neither an answer nor a usable disk entry.
+ */
+export async function resolve(a: Assertion): Promise<ResolveAnswer> {
+  const cls = checkCaller(a)
+  const key = JSON.stringify([a.ref, a.iss, a.sub, cls])
+  const warm = memory.get(key)
+  if (warm && warm.until > performance.now()) return warm.answer
+  // requests of one principal that arrive together share one call
+  let flight = flights.get(key)
+  if (!flight) {
+    flight = fresh(a, cls, key).finally(() => flights.delete(key))
+    flights.set(key, flight)
+  }
+  return flight
+}
+
+/** The project's keys, asked every time: nothing of this answer is kept anywhere. */
+export async function keys(a: Assertion): Promise<KeysAnswer> {
+  checkCaller(a)
+  const answer = await ask('/v1/keys', a, (value) => checkKeys(value, a))
+  if (!answer) throw unavailable()
+  return answer
+}
+
+/** Drops every entry of one project, in memory and on disk; other projects' stay. */
+export function dropProject(ref: string) {
+  if (!REF.test(ref)) throw new Error('not a project ref')
+  for (const [key, entry] of memory) if (entry.ref === ref) memory.delete(key)
+  rmSync(cacheDir(ref), { recursive: true, force: true })
+}
