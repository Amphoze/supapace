@@ -1,14 +1,7 @@
 import crypto from 'crypto-js'
 
-import {
-  ENCRYPTION_KEY,
-  POSTGRES_DATABASE,
-  POSTGRES_HOST,
-  POSTGRES_PASSWORD,
-  POSTGRES_PORT,
-  POSTGRES_USER_READ_ONLY,
-  POSTGRES_USER_READ_WRITE,
-} from './constants'
+import { ENCRYPTION_KEY } from './constants'
+import { getProjectContext, ProjectError } from './project-context'
 import { IS_PLATFORM } from '@/lib/constants'
 
 /**
@@ -24,8 +17,21 @@ export function encryptString(stringToEncrypt: string): string {
   return crypto.AES.encrypt(stringToEncrypt, ENCRYPTION_KEY).toString()
 }
 
+/**
+ * The connection string of the request's project, as the control plane answered it: the
+ * read-only one when the call site asks for it and whenever the member's role is read_only.
+ * There is no default project: outside a request this throws.
+ */
 export function getConnectionString({ readOnly }: { readOnly: boolean }) {
-  const postgresUser = readOnly ? POSTGRES_USER_READ_ONLY : POSTGRES_USER_READ_WRITE
-
-  return `postgresql://${postgresUser}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}`
+  const context = getProjectContext()
+  if (readOnly || context.role === 'read_only') {
+    if (!context.dsn_ro) {
+      throw new ProjectError(403, 'no_read_only_login', 'The project has no read-only login')
+    }
+    return context.dsn_ro
+  }
+  if (!context.dsn_rw) {
+    throw new ProjectError(503, 'project_unavailable', 'The project is not available')
+  }
+  return context.dsn_rw
 }
