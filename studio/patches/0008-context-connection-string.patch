@@ -1,6 +1,12 @@
 import { beforeEach, describe, expect, it, vi } from 'vitest'
 
-import { assertSelfHosted, encryptString } from './util'
+import {
+  projectContext,
+  runWithProject,
+  type Assertion,
+  type ResolveAnswer,
+} from './project-context'
+import { assertSelfHosted, encryptString, getConnectionString } from './util'
 
 vi.mock('@/lib/constants', () => ({
   IS_PLATFORM: false,
@@ -66,7 +72,9 @@ describe('api/self-hosted/util', () => {
     })
   })
 
-  describe('getConnectionString', () => {
+  // Skipped: these cases build the string of one project from the environment, which this
+  // build removes. The cases that follow hold what replaces it.
+  describe.skip('getConnectionString, from the environment', () => {
     beforeEach(() => {
       vi.resetModules()
     })
@@ -117,4 +125,114 @@ describe('api/self-hosted/util', () => {
       expect(resultReadOnly).toBe('postgresql://supabase_read_only_user:postgres@db:5432/postgres')
     })
   })
+
+  describe('getConnectionString', () => {
+    const REF_A = 'abcdefghij0123456789'
+    const REF_B = 'bcdefghij0123456789a'
+    const dsn = (login: string, port: number) =>
+      `postgresql://${login}:pw${port}@10.212.0.6:${port}/postgres?sslmode=disable`
+
+    function context(ref: string, port: number, role: Assertion['role'], readOnlyLogin = true) {
+      const answer: ResolveAnswer = {
+        ref,
+        name: 'p',
+        state: 'active',
+        db_version: '17.6.1',
+        pg_meta: port % 2,
+        api_url: `https://${ref}.example.test`,
+        data_api: {
+          schemas: ['public'],
+          extra_search_path: [],
+          max_rows: null,
+        },
+        generation: 1,
+        at: '2026-11-19T10:00:00Z',
+      }
+      if (role !== 'read_only') answer.dsn_rw = dsn('postgres', port)
+      if (readOnlyLogin) answer.dsn_ro = dsn('supabase_read_only_user', port)
+      return projectContext(
+        {
+          text: 'v1.a.b',
+          ref,
+          iss: 'https://issuer.test',
+          sub: 'u',
+          name: 'U',
+          role,
+          purpose: '',
+        },
+        answer
+      )
+    }
+
+    it('is the string of the request’s project, never one built from the environment', () => {
+      vi.stubEnv('POSTGRES_HOST', 'env-host')
+      vi.stubEnv('POSTGRES_PORT', '5999')
+      vi.stubEnv('POSTGRES_DB', 'env-db')
+      vi.stubEnv('POSTGRES_PASSWORD', 'env-password')
+      vi.stubEnv('POSTGRES_USER_READ_WRITE', 'env-admin')
+      vi.stubEnv('POSTGRES_USER_READ_ONLY', 'env-reader')
+      for (const role of ['owner', 'developer'] as const) {
+        runWithProject(context(REF_A, 20001, role), () => {
+          expect(getConnectionString({ readOnly: false })).toBe(dsn('postgres', 20001))
+          expect(getConnectionString({ readOnly: true })).toBe(
+            dsn('supabase_read_only_user', 20001)
+          )
+        })
+      }
+      vi.unstubAllEnvs()
+    })
+
+    it('is the read-only string for a read_only member, whatever the call site asks', () => {
+      runWithProject(context(REF_A, 20001, 'read_only'), () => {
+        expect(getConnectionString({ readOnly: false })).toBe(dsn('supabase_read_only_user', 20001))
+        expect(getConnectionString({ readOnly: true })).toBe(dsn('supabase_read_only_user', 20001))
+      })
+    })
+
+    it('refuses where the read-only string is needed and the project has no read-only login', () => {
+      const refused = { status: 403, code: 'no_read_only_login' }
+      runWithProject(context(REF_A, 20001, 'read_only', false), () => {
+        expect(() => getConnectionString({ readOnly: false })).toThrow(
+          expect.objectContaining(refused)
+        )
+        expect(() => getConnectionString({ readOnly: true })).toThrow(
+          expect.objectContaining(refused)
+        )
+      })
+      runWithProject(context(REF_A, 20001, 'owner', false), () => {
+        expect(() => getConnectionString({ readOnly: true })).toThrow(
+          expect.objectContaining(refused)
+        )
+        // control: the same member's read-write call is served
+        expect(getConnectionString({ readOnly: false })).toBe(dsn('postgres', 20001))
+      })
+    })
+
+    it('throws outside a request: there is no default project', () => {
+      expect(() => getConnectionString({ readOnly: false })).toThrow(
+        expect.objectContaining({ code: 'no_project_context' })
+      )
+      expect(() => getConnectionString({ readOnly: true })).toThrow(
+        expect.objectContaining({ code: 'no_project_context' })
+      )
+    })
+
+    it('gives interleaved requests of two projects each their own', async () => {
+      const got: boolean[] = []
+      const request = (ref: string, port: number, n: number) =>
+        runWithProject(context(ref, port, n % 3 ? 'owner' : 'read_only'), async () => {
+          for (let i = 0; i < 4; i++) {
+            await new Promise((r) => setTimeout(r, (n + i) % 4))
+            got.push(getConnectionString({ readOnly: false }).includes(`@10.212.0.6:${port}/`))
+          }
+        })
+      await Promise.all(
+        Array.from({ length: 40 }, (_, n) =>
+          n % 2 ? request(REF_A, 20001, n) : request(REF_B, 20002, n)
+        )
+      )
+      expect(got).toHaveLength(160)
+      expect(got.every(Boolean)).toBe(true)
+    })
+  })
 })
