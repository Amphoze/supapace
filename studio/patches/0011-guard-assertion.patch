--- /dev/null
+++ b/apps/studio/lib/api/self-hosted/assertion.ts
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: Apache-2.0
+// The gateway's assertion: who asks, for which project, in which role. The gateway signs one
+// per request with the node's key; this server holds the public key only and verifies every
+// request's assertion before anything else runs. The format has one encoding, so that this
+// verifier and the gateway's accept exactly the same tokens:
+//
+//   v1.<P>.<S>   P: base64url of the payload, S: base64url of an Ed25519 signature over the
+//                label followed by P; no padding, no unused bits, at most 4096 bytes
+//   payload      {"node","iss","sub","name","ref","role","purpose","iat","exp"}: these members
+//                in this order, no white space, no escape but \" and \\
+//
+// The payload is never rebuilt from a lenient decoder: what was decoded is serialised again
+// and its bytes are compared with the bytes that were signed.
+
+import { createPublicKey, verify, type KeyObject } from 'node:crypto'
+import { readFileSync } from 'node:fs'
+import { isAbsolute, join } from 'node:path'
+
+import { orStop } from './limits'
+import { ProjectError, type Assertion } from './project-context'
+
+const LABEL = 'supapace-assertion-v1.'
+const MAX_TOKEN_BYTES = 4096
+const SIGNATURE_CHARS = 86
+const MAX_LIFETIME_S = 60
+const AHEAD_S = 5
+const BASE64URL = /^[A-Za-z0-9_-]+$/
+const REF = /^[a-z0-9]{20}$/
+const PRINTABLE = /^[\x20-\x7e]{1,255}$/
+// Control characters, and the two separators that JSON encoders do not all write the same way.
+const UNWRITTEN = /[\u0000-\u001f\u007f-\u009f\u2028\u2029]/
+const ROLES: readonly unknown[] = ['owner', 'developer', 'read_only']
+const PURPOSES: readonly unknown[] = ['', 'reveal']
+
+// One refusal for every cause: the answer says nothing about which check failed.
+const refuse = () =>
+  new ProjectError(401, 'bad_assertion', 'The request carries no valid assertion')
+
+/** Unpadded base64url with no unused bit set, or nothing. */
+function decode(text: string): Buffer | undefined {
+  if (!BASE64URL.test(text)) return undefined
+  const bytes = Buffer.from(text, 'base64url')
+  return bytes.toString('base64url') === text ? bytes : undefined
+}
+
+/** UTF-8 text of `min` to `max` bytes, without a control character or a Unicode separator. */
+function isText(value: unknown, min: number, max: number): value is string {
+  if (typeof value !== 'string' || !value.isWellFormed() || UNWRITTEN.test(value)) return false
+  const bytes = Buffer.byteLength(value)
+  return bytes >= min && bytes <= max
+}
+
+// --- the node's settings, read once, at the first use ----------------------------------------
+
+type Settings = { node: string; key: KeyObject }
+let loaded: Settings | undefined
+
+/** The public key file: 32 bytes as 43 base64url characters and at most one line end. */
+function readKey(file: string): KeyObject {
+  let text: string
+  try {
+    text = readFileSync(file, 'latin1')
+  } catch {
+    throw new Error('the assertion key file cannot be read')
+  }
+  const x = text.endsWith('\n') ? text.slice(0, -1) : text
+  if (x.length !== 43 || decode(x) === undefined) {
+    throw new Error('the assertion key file does not hold 32 bytes in base64url')
+  }
+  return createPublicKey({
+    key: { kty: 'OKP', crv: 'Ed25519', x },
+    format: 'jwk',
+  })
+}
+
+function settings(): Settings {
+  return (loaded ??= orStop(() => {
+    const node = process.env.SUPAPACE_NODE_ID
+    if (!node) throw new Error('SUPAPACE_NODE_ID is not set')
+    const keys = process.env.SUPAPACE_DASH_KEYS
+    if (!keys || !isAbsolute(keys)) {
+      throw new Error('SUPAPACE_DASH_KEYS is not set to an absolute path')
+    }
+    return { node, key: readKey(join(keys, 'assert.pub')) }
+  }))
+}
+
+/**
+ * Reads and checks the node's id and the assertion key now; a missing or malformed one stops
+ * the process, with the line the first request would give. Nothing is read when the module
+ * loads.
+ */
+export function checkAssertionSettings() {
+  settings()
+}
+
+// --- the verifier ----------------------------------------------------------------------------
+
+/**
+ * Verifies the text of a request's assertion header and returns it as verified, or throws the
+ * one refusal, `401 bad_assertion`. In order: the size and the envelope, the signature, the
+ * payload's bytes against their own re-serialisation, the members' types and domains, the
+ * times, the node. `now` is in seconds; the clock when it is not given.
+ */
+export function verifyAssertion(
+  text: string | null,
+  now = Math.floor(Date.now() / 1000)
+): Assertion {
+  const { node, key } = settings()
+  if (text === null || text.length > MAX_TOKEN_BYTES || !text.startsWith('v1.')) throw refuse()
+  const parts = text.slice(3).split('.')
+  if (parts.length !== 2 || parts[1].length !== SIGNATURE_CHARS) throw refuse()
+  const payload = decode(parts[0])
+  const signature = decode(parts[1])
+  if (!payload || !signature) throw refuse()
+  if (!verify(null, Buffer.from(LABEL + parts[0]), key, signature)) throw refuse()
+
+  let value: unknown
+  try {
+    value = JSON.parse(new TextDecoder('utf-8', { fatal: true, ignoreBOM: true }).decode(payload))
+  } catch {
+    throw refuse()
+  }
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) throw refuse()
+  const given: Record<string, unknown> = { ...value }
+  // Only these members, in this order: a missing, added, repeated, reordered or otherwise
+  // spelled member, an escape or a number in another notation does not serialise to the
+  // bytes that were signed.
+  const claims = {
+    node: given.node,
+    iss: given.iss,
+    sub: given.sub,
+    name: given.name,
+    ref: given.ref,
+    role: given.role,
+    purpose: given.purpose,
+    iat: given.iat,
+    exp: given.exp,
+  }
+  const { iss, sub, name, ref, role, purpose, iat, exp } = claims
+  if (
+    !isText(claims.node, 1, 255) ||
+    typeof iss !== 'string' ||
+    !PRINTABLE.test(iss) ||
+    typeof sub !== 'string' ||
+    !PRINTABLE.test(sub) ||
+    !isText(name, 0, 128) ||
+    typeof ref !== 'string' ||
+    !REF.test(ref) ||
+    !ROLES.includes(role) ||
+    !PURPOSES.includes(purpose) ||
+    typeof iat !== 'number' ||
+    !Number.isSafeInteger(iat) ||
+    typeof exp !== 'number' ||
+    !Number.isSafeInteger(exp)
+  ) {
+    throw refuse()
+  }
+  if (!Buffer.from(JSON.stringify(claims), 'utf8').equals(payload)) throw refuse()
+
+  if (exp <= now || iat > now + AHEAD_S || exp <= iat || exp - iat > MAX_LIFETIME_S) throw refuse()
+  if (claims.node !== node) throw refuse()
+  return {
+    text,
+    ref,
+    iss,
+    sub,
+    name,
+    role: role as Assertion['role'],
+    purpose: purpose as Assertion['purpose'],
+  }
+}
