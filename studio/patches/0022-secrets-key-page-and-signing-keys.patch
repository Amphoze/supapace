+
+// The project's public signing keys as the server lists them, in the rows of the keys table.
+// They are shown and can be copied; no action exists on them here.
+function ReadOnlySigningKeys() {
+  const { ref: projectRef } = useParams()
+  const { grant } = useGrant('GET /v1/projects/{ref}/config/auth/signing-keys', { projectRef })
+  const { data, error, isPending, isError } = useQuery(
+    jwtSigningKeysQueryOptions({ projectRef, grant })
+  )
+
+  if (isPending) return <GenericSkeletonLoader />
+  if (isError) return <AlertError error={error} subject="Failed to retrieve JWT signing keys" />
+
+  return (
+    <Card>
+      <CardContent className="p-0">
+        <Table>
+          <TableHeader>
+            <TableRow>
+              <TableHead>Key</TableHead>
+              <TableHead>Type</TableHead>
+            </TableRow>
+          </TableHeader>
+          <TableBody>
+            {data.keys.map((key) => (
+              <TableRow key={key.id}>
+                <TableCell>
+                  <CopyableKey keyId={key.id} />
+                </TableCell>
+                <TableCell>
+                  <AlgorithmHoverCard algorithm={key.algorithm} />
+                </TableCell>
+              </TableRow>
+            ))}
+          </TableBody>
+        </Table>
+      </CardContent>
+    </Card>
+  )
+}
