+// SPDX-License-Identifier: Apache-2.0
+// The key page: the settings answer no key. The anon key comes from the key list; the
+// service_role key is asked for by one named request, when its button is pressed.
+import { screen, waitFor } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { HttpResponse } from 'msw'
+import { beforeEach, describe, expect, it } from 'vitest'
+
+import { DisplayApiSettings } from './DisplayApiSettings'
+import { customRender } from '@/tests/lib/custom-render'
+import { addAPIMock } from '@/tests/lib/msw'
+
+const KEYS = 'http://localhost:3000/api/v1/projects/default/api-keys'
+const legacy = (name: string, api_key: string) => ({ name, id: name, api_key, type: 'legacy' })
+
+describe('DisplayApiSettings', () => {
+  let requested: string[]
+  let reveal: () => Response
+
+  beforeEach(() => {
+    requested = []
+    reveal = () => HttpResponse.json(legacy('service_role', 'the-service-role-key'))
+    addAPIMock({
+      method: 'get',
+      path: '/platform/projects/:ref/settings',
+      response: {
+        service_api_keys: [
+          { api_key: '', name: 'anon key', tags: 'anon' },
+          { api_key: '', name: 'service_role key', tags: 'service_role' },
+        ],
+      } as any,
+    })
+    addAPIMock({
+      method: 'get',
+      path: '/platform/projects/:ref/config/secrets/update-status',
+      response: { update_status: null } as any,
+    })
+    addAPIMock({
+      method: 'get',
+      path: '/v1/projects/:ref/api-keys',
+      response: (({ request }: { request: Request }) => {
+        requested.push(request.url)
+        return HttpResponse.json([legacy('anon', 'the-anon-key')])
+      }) as any,
+    })
+    addAPIMock({
+      method: 'get',
+      path: '/v1/projects/:ref/api-keys/:id',
+      response: (({ request }: { request: Request }) => {
+        requested.push(request.url)
+        return reveal()
+      }) as any,
+    })
+  })
+
+  it('asks for the service_role key when its button is pressed, and not before', async () => {
+    customRender(<DisplayApiSettings />)
+
+    // the page has loaded and shows the anon key: nothing asked for a revealed key
+    expect(await screen.findByDisplayValue('the-anon-key')).toBeInTheDocument()
+    expect(requested).toEqual([`${KEYS}?reveal=false`])
+    expect(screen.queryByDisplayValue('the-service-role-key')).not.toBeInTheDocument()
+
+    await userEvent.click(screen.getByRole('button', { name: 'Reveal' }))
+
+    expect(await screen.findByDisplayValue('the-service-role-key')).toBeInTheDocument()
+    // exactly the one request, with the one parameter the gateway signs the purpose for
+    expect(requested).toEqual([`${KEYS}?reveal=false`, `${KEYS}/service_role?reveal=true`])
+    expect(screen.queryByRole('button', { name: 'Reveal' })).not.toBeInTheDocument()
+  })
+
+  it('shows no key when the reveal is refused', async () => {
+    reveal = () => HttpResponse.json({ error: { message: 'API key not found' } }, { status: 404 })
+    customRender(<DisplayApiSettings />)
+    await screen.findByDisplayValue('the-anon-key')
+
+    await userEvent.click(screen.getByRole('button', { name: 'Reveal' }))
+
+    await waitFor(() => expect(requested).toHaveLength(2))
+    expect(await screen.findByRole('button', { name: 'Reveal' })).toBeInTheDocument()
+    expect(screen.queryByDisplayValue(/service-role-key/)).not.toBeInTheDocument()
+  })
+})
