+// The key of the header that names the database, as the server under test reads it.
+export const HEADER_KEY = Buffer.alloc(48, 9).toString('base64url') + '\n'
+/** The header as the server under test seals it. */
+export const seal = (text: string) => crypto.AES.encrypt(text, HEADER_KEY).toString()
+const open = (sealed: string) => {
+  try {
+    return crypto.AES.decrypt(sealed, HEADER_KEY).toString(crypto.enc.Utf8)
+  } catch {
