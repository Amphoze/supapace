+export type Arrived = {
+  method: string
+  url: string
+  headers: IncomingHttpHeaders
+  body: string
+  res: ServerResponse
+  /** the connection string the request was sent with, and its port */
+  dsn: string
+  port: number
+  /** set when the connection has ended */
+  closed: boolean
+}
+
+/** An HTTP server of the test as one postgres-meta instance. */
+export class Meta {
+  seen: Arrived[] = []
+  /** the most requests that were unanswered at once */
+  most = 0
+  /** what is done with a request that has arrived: by default it is answered `[]` at once */
+  onRequest: (arrived: Arrived) => void = (arrived) => arrived.res.end('[]')
+  private waiting: (() => void)[] = []
+  private open = 0
+  readonly server: Server = createServer((req, res) => {
+    const chunks: Buffer[] = []
+    req.on('data', (chunk) => chunks.push(chunk))
+    req.on('end', () => {
+      const sent = open(String(req.headers['x-connection-encrypted']))
+      const arrived: Arrived = {
+        method: req.method ?? '',
+        url: req.url ?? '',
+        headers: req.headers,
+        body: Buffer.concat(chunks).toString('utf8'),
+        res,
+        dsn: sent,
+        port: Number(/:(\d+)\/postgres/.exec(sent)?.[1]),
+        closed: false,
+      }
+      this.most = Math.max(this.most, ++this.open)
+      res.on('close', () => {
+        arrived.closed = true
+        this.open--
+        this.wake()
+      })
+      this.seen.push(arrived)
+      this.wake()
+      this.onRequest(arrived)
+    })
+  })
+
+  private wake() {
+    for (const w of this.waiting.splice(0)) w()
+  }
+  /** Leaves every request unanswered until the test answers it. */
+  park() {
+    this.onRequest = () => {}
+  }
+  /** Resolves, with all requests so far, when `test` holds: checked at every arrival and close. */
+  async until(test: (seen: Arrived[]) => boolean): Promise<Arrived[]> {
+    while (!test(this.seen)) await new Promise<void>((done) => this.waiting.push(done))
+    return this.seen
+  }
+  /** Resolves when `count` requests have arrived. */
+  arrivals(count: number) {
+    return this.until((seen) => seen.length >= count)
+  }
+  get address() {
+    return `http://127.0.0.1:${(this.server.address() as AddressInfo).port}`
+  }
