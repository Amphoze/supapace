+          code: '42601',
+          formattedError: 'f',
+        })
+      )
+    }
+    const result = await kit.request(kit.context(1), () => executeQuery({ query: 'selec' }))
+    expect(result.error).toMatchObject({ code: '42601' })
+    // neither is an error that only shares a part of a refused login's marks: the code without
+    // the severity of a refusal at connection time, that severity with another code, the
+    // client's text under a code, the text further on in a message
+    const text = 'SASL: SCRAM-SERVER-FINAL-MESSAGE: server signature does not match'
+    for (const answer of [
+      { code: '28P01', message: 'm', formattedError: 'f' },
+      { code: '28P01', severity: 'ERROR', message: 'm', formattedError: 'f' },
+      { code: '28P01', severity: 'fatal', message: 'm', formattedError: 'f' },
+      { code: '53300', severity: 'FATAL', message: 'sorry, too many clients already' },
+      { code: 'P0001', message: text },
+      { code: '', message: text },
+      { message: `x ${text}` },
+      { message: ['SASL: SCRAM-SERVER-FINAL-MESSAGE: x'] },
+    ]) {
+      kit.metas[1].onRequest = (a) => {
+        a.res.statusCode = 400
+        a.res.end(JSON.stringify(answer))
+      }
+      await kit.request(kit.context(1), () => executeQuery({ query: 'do $$…$$' }))
+    }
+    // a result that only looks like a refused login is a result
+    kit.metas[1].onRequest = (a) =>
+      a.res.end(JSON.stringify({ code: '28P01', message: 'password authentication failed' }))
+    await kit.request(kit.context(1), () => executeQuery({ query: 'select 1' }))
+    expect(kit.control.asked).toEqual([])
+    expect(said).not.toHaveBeenCalled()
+  })
+})
diff --git a/apps/studio/lib/api/self-hosted/pg-meta.ts b/apps/studio/lib/api/self-hosted/pg-meta.ts
new file mode 100644
index 00000000..7e4ae7fd
--- /dev/null
+++ b/apps/studio/lib/api/self-hosted/pg-meta.ts
@@ -0,0 +1,521 @@
+// SPDX-License-Identifier: Apache-2.0
+// The one path from this server to postgres-meta. A statement or a type generation of any
+// route goes through callPgMeta, which, in order:
+//
+//   1. takes the connection string from the request's project: the read-only one whenever the
+//      member's role is read_only, whatever the call site asks;
+//   2. waits for a slot of the project's postgres-meta instance: a bounded number of calls in
+//      flight per instance and per project, granted to the waiting projects in turn;
+//   3. writes the audit record, flushed, and sends nothing when it cannot be written;
+//   4. sends the request with two headers of its own and nothing a caller handed in, to the
+//      instance the control plane names, and reads the answer under a deadline and a byte cap.
+//
+// The slot is held until the response made from the answer has been handed over to the
+// client, the client has gone, or the hand-over's own deadline has passed. Nothing else in
+// this server knows where postgres-meta is.
+
+import { AsyncLocalStorage } from 'node:async_hooks'
+import { createHash } from 'node:crypto'
+import { request as httpRequest } from 'node:http'
+
+import { writeAudit } from './audit'
+import { checkDsn, dropProject, resolve } from './dash-socket'
+import { limits, orStop } from './limits'
+import {
+  getProjectContext,
+  projectContext,
+  ProjectError,
+  runWithProject,
+  type ProjectContext,
+} from './project-context'
+import { encryptString, getConnectionString } from './util'
+
+export type PgMetaCall =
+  | { kind: 'query'; sql: string; parameters?: unknown[]; readOnly?: boolean }
+  | { kind: 'typegen'; schemas: string }
+
+/** postgres-meta's answer: its status and its body, which was valid UTF-8. */
+export type PgMetaAnswer = { status: number; text: string }
+
+/** A response is handed over in pieces of this size, each when the one before was taken. */
+const PIECE_BYTES = 64 * 1024
+// How the database client's own reports begin that the server did not prove it holds the
+// password: no signature, another signature, a server error in its place.
+const NO_PROOF = 'SASL: SCRAM-SERVER-FINAL-MESSAGE: '
+
+const busy = () => new ProjectError(429, 'busy', 'Too many statements at once; try again')
+const gone = () => new ProjectError(499, 'client_gone', 'The client has gone')
+const noContext = () =>
+  new ProjectError(500, 'no_project_context', 'No project context for this request')
+const noAnswer = () => new Error('postgres-meta gave no usable answer')
+
+// --- where postgres-meta is ---------------------------------------------------------------------
+
+type Instance = { host: string; port: number }
+let instances: readonly Instance[] | undefined
+
+/**
+ * The two postgres-meta instances, in the order the control plane numbers them:
+ * `http://<IPv4 address>:<port>,http://<IPv4 address>:<port>`. Read at the first use or by
+ * the start check; a missing or malformed value stops the process.
+ */
+function pgMetaInstances(): readonly Instance[] {
+  return (instances ??= orStop(() => {
+    const octet = '(?:0|[1-9][0-9]{0,2})'
+    const url = new RegExp(`^http://(${octet}(?:\\.${octet}){3}):([1-9][0-9]{0,4})$`)
+    const found = (process.env.SUPAPACE_PGMETA ?? '').split(',').map((text) => {
+      const m = url.exec(text)
+      const ok = m && m[1].split('.').every((o) => Number(o) <= 255) && Number(m[2]) <= 65535
+      return ok ? { host: m[1], port: Number(m[2]) } : undefined
+    })
+    if (found.length !== 2 || !found[0] || !found[1]) {
+      throw new Error('SUPAPACE_PGMETA is not http://<address>:<port>,http://<address>:<port>')
+    }
+    return [found[0], found[1]]
+  }))
+}
+
+/** Reads and checks this module's settings now; a missing or malformed one stops the process. */
+export function checkPgMetaSettings() {
+  limits()
+  pgMetaInstances()
+}
+
+// --- slots ---------------------------------------------------------------------------------------
+
+type Queue = { held: number; waiting: (() => void)[] }
+// `projects` is in the order of the round: a project that is granted a slot goes to its end.
+type Lane = {
+  cap: number
+  each: number
+  spare: number
+  busy: number
+  projects: Map<string, Queue>
+}
+
+/**
+ * Grants what can be granted: to the first project of the round that waits, holds less than
+ * its own bound and finds a slot free — two free, when it already holds one, so that a
+ * project never takes the last slot of its instance as its second.
+ */
+function grant(lane: Lane) {
+  for (let granted = true; granted; ) {
+    granted = false
+    for (const [ref, queue] of lane.projects) {
+      if (queue.waiting.length === 0 || queue.held >= lane.each) continue
+      if (lane.cap - lane.busy < (queue.held > 0 ? lane.spare : 1)) continue
+      queue.held++
+      lane.busy++
+      lane.projects.delete(ref)
+      lane.projects.set(ref, queue)
+      queue.waiting.shift()!()
+      granted = true
+      break
+    }
+  }
+}
+
+/**
+ * Waits for a slot of the lane for the project and resolves with its release, to be called
+ * once. Refused `429 busy` when the project's waiting places are
+ * taken and when the wait reaches its bound; a client that goes away leaves the queue.
+ */
+function acquire(lane: Lane, ref: string, signal: AbortSignal): Promise<() => void> {
+  const { slot_wait_ms, project_waiting } = limits()
+  const queue = lane.projects.get(ref) ?? { held: 0, waiting: [] }
+  lane.projects.set(ref, queue)
+  const tidy = () => {
+    if (queue.held === 0 && queue.waiting.length === 0 && lane.projects.get(ref) === queue) {
+      lane.projects.delete(ref)
+    }
+  }
+  return new Promise((resolve, reject) => {
+    let timer: ReturnType<typeof setTimeout> | undefined
+    const settle = () => {
+      clearTimeout(timer)
+      signal.removeEventListener('abort', onGone)
+    }
+    const leave = (error: ProjectError) => {
+      settle()
+      const at = queue.waiting.indexOf(granted)
+      if (at >= 0) queue.waiting.splice(at, 1)
+      tidy()
+      reject(error)
+    }
+    const onGone = () => leave(gone())
+    const granted = () => {
+      settle()
+      resolve(() => {
+        queue.held--
+        lane.busy--
+        tidy()
+        grant(lane)
+      })
+    }
+    if (signal.aborted) return leave(gone())
+    if (queue.waiting.length >= project_waiting) return leave(busy())
+    timer = setTimeout(() => leave(busy()), slot_wait_ms)
+    signal.addEventListener('abort', onGone, { once: true })
+    queue.waiting.push(granted)
+    grant(lane)
+  })
+}
+
+const newLane = (cap: number, each: number, spare: number): Lane => ({
+  cap,
+  each,
+  spare,
+  busy: 0,
+  projects: new Map(),
+})
+
+let lanes: Lane[] | undefined
+/** The lane of a postgres-meta instance. */
+function laneOf(instance: number): Lane | undefined {
+  const { instance_calls, project_calls } = limits()
+  lanes ??= pgMetaInstances().map(() => newLane(instance_calls, project_calls, 2))
+  return lanes[instance]
+}
+
+// --- a request and its slot ---------------------------------------------------------------------
+
+// What this module keeps for one request of the server: at most one slot, taken by its first
+// call and held, whatever else it calls, until its response has been handed over.
+type Flight = {
+  signal: AbortSignal
+  /** the request's calls run one at a time */
+  turn: Promise<void>
+  release?: () => void
+  /** runs when the hand-over has taken its bound */
+  timer?: ReturnType<typeof setTimeout>
+  late: boolean
+  cut?: () => void
+}
+const flights = new AsyncLocalStorage<Flight>()
+
+function free(flight: Flight) {
+  clearTimeout(flight.timer)
+  flight.timer = undefined
+  const release = flight.release
+  flight.release = undefined
+  release?.()
+}
+
+/**
+ * Runs the rest of a request, `next`, and hands its response over. While the response holds
+ * what postgres-meta answered, the request keeps its slot: the body is given out in pieces,
+ * each when the one before has been taken, and the slot is freed when the last one has —
+ * or when the client goes away, or when the hand-over has lasted `handover_ms` from
+ * postgres-meta's answer, at which point the body is cut.
+ */
+export async function handOver<T>(request: Request, next: () => T | Promise<T>) {
+  const flight: Flight = {
+    signal: request.signal,
+    turn: Promise.resolve(),
+    late: false,
+  }
+  request.signal.addEventListener('abort', () => free(flight), { once: true })
+  let result: T
+  try {
+    result = await flights.run(flight, next)
+  } catch (error) {
+    free(flight)
+    throw error
+  }
+  if (!flight.release && !flight.late) return result
+  const response =
+    result instanceof Response ? result : (result as { response?: unknown } | undefined)?.response
+  if (!(response instanceof Response) || !response.body) {
+    // nothing whose hand-over could be followed
+    free(flight)
+    return result
+  }
+  const source = response.body.getReader()
+  let rest = new Uint8Array(0)
+  let out: ReadableStreamDefaultController<Uint8Array> | undefined
+  const cut = () => {
+    out?.error(new Error('the response was not taken in time'))
+    void source.cancel().catch(() => {})
+  }
+  const body = new ReadableStream<Uint8Array>(
+    {
+      start(controller) {
+        out = controller
+      },
+      async pull(controller) {
+        if (flight.late) return cut()
+        if (rest.length === 0) {
+          const { done, value } = await source.read()
+          if (flight.late) return
+          if (done) {
+            free(flight)
+            return controller.close()
+          }
+          rest = value
+        }
+        controller.enqueue(rest.subarray(0, PIECE_BYTES))
+        rest = rest.subarray(PIECE_BYTES)
+      },
+      cancel(reason) {
+        free(flight)
+        return source.cancel(reason)
+      },
+    },
+    { highWaterMark: 0 }
+  )
+  flight.cut = cut
+  return new Response(body, {
+    status: response.status,
+    statusText: response.statusText,
+    headers: response.headers,
+  })
+}
+
+// --- one request to postgres-meta -------------------------------------------------------------
+
+/**
+ * Sends one request and reads its answer, within `meta_call_ms` from now and up to
+ * `result_bytes`. Refused `504 query_deadline` and `400 result_too_large`; the connection is
+ * closed then, and when the client goes away, and nothing more is read.
+ */
+function exchange(
+  target: Instance,
+  method: string,
+  path: string,
+  dsn: string,
+  body: string | undefined,
+  signal: AbortSignal
+): Promise<PgMetaAnswer> {
+  const { meta_call_ms, result_bytes } = limits()
+  if (signal.aborted) return Promise.reject(gone())
+  return new Promise((resolve, reject) => {
+    // these and no other: nothing of the client's request is passed on
+    const headers: Record<string, string | number> = {
+      'Content-Type': 'application/json',
+      'x-connection-encrypted': encryptString(dsn),
+    }
+    if (body !== undefined) headers['Content-Length'] = Buffer.byteLength(body)
+    const req = httpRequest({
+      ...target,
+      method,
+      path,
+      agent: false,
+      maxHeaderSize: 8192,
+      headers,
+    })
+    const end = (error: Error | undefined, answer?: PgMetaAnswer) => {
+      clearTimeout(timer)
+      signal.removeEventListener('abort', onGone)
+      req.destroy()
+      if (error || !answer) reject(error ?? noAnswer())
+      else resolve(answer)
+    }
+    const onGone = () => end(gone())
+    const timer = setTimeout(
+      () => end(new ProjectError(504, 'query_deadline', 'The statement took too long')),
+      meta_call_ms
+    )
+    signal.addEventListener('abort', onGone, { once: true })
+    req.on('response', (res) => {
+      const tooLarge = () =>
+        end(new ProjectError(400, 'result_too_large', 'The result is too large'))
+      if (Number(res.headers['content-length']) > result_bytes) return tooLarge()
+      const chunks: Buffer[] = []
+      let size = 0
+      res.on('data', (chunk: Buffer) => {
+        size += chunk.length
+        if (size > result_bytes) tooLarge()
+        else chunks.push(chunk)
+      })
+      res.on('end', () => {
+        try {
+          const text = new TextDecoder('utf-8', { fatal: true }).decode(Buffer.concat(chunks))
+          end(undefined, { status: res.statusCode ?? 0, text })
+        } catch {
+          end(noAnswer())
+        }
+      })
+      res.on('error', () => end(noAnswer()))
+      res.on('close', () => end(noAnswer()))
+    })
+    req.on('error', () => end(noAnswer()))
+    req.end(body)
+  })
+}
+
+/** The request a call is: a statement as JSON, or the type generation of the named schemas. */
+function requestOf(call: PgMetaCall): {
+  method: string
+  path: string
+  body?: string
+} {
+  if (call.kind !== 'query') {
+    const query = new URLSearchParams({
+      included_schemas: String(call.schemas),
+    })
+    return { method: 'GET', path: `/generators/typescript?${query}` }
+  }
+  if (typeof call.sql !== 'string') {
+    throw new ProjectError(400, 'bad_request', 'The statement is not a text')
+  }
+  const body = JSON.stringify({ query: call.sql, parameters: call.parameters })
+  // what postgres-meta takes: the control plane gives both the one figure
+  if (Buffer.byteLength(body) > limits().meta_body_bytes) {
+    throw new ProjectError(413, 'body_too_large', 'The statement is too large')
+  }
+  return { method: 'POST', path: '/query', body }
+}
+
+type Sent = PgMetaAnswer & { dsn: string; port: number }
+
+/** One call for the project of `context`: the string, the slot, the record, the request. */
+async function send(context: ProjectContext, flight: Flight, call: PgMetaCall): Promise<Sent> {
+  const dsn = runWithProject(context, () =>
+    getConnectionString({
+      readOnly: call.kind === 'query' && call.readOnly === true,
+    })
+  )
+  const { login, port } = checkDsn(dsn)
+  const lane = laneOf(context.pg_meta)
+  const target = pgMetaInstances()[context.pg_meta]
+  if (!lane || !target) {
+    throw new ProjectError(503, 'project_unavailable', 'The project is not available')
+  }
+  const { method, path, body } = requestOf(call)
+
+  flight.release ??= await acquire(lane, context.ref, flight.signal)
+  await writeAudit({
+    ref: context.ref,
+    iss: context.principal.iss,
+    sub: context.principal.sub,
+    role: context.role,
+    login,
+    kind: call.kind,
+    sql_sha256:
+      call.kind === 'query' ? createHash('sha256').update(call.sql).digest('hex') : undefined,
+  })
+  const answer = await exchange(target, method, path, dsn, body, flight.signal)
+  // the hand-over of what postgres-meta answered is bounded from here
+  flight.timer = setTimeout(() => {
+    flight.late = true
+    free(flight)
+    flight.cut?.()
+  }, limits().handover_ms)
+  return { ...answer, dsn, port }
+}
+
+/**
+ * How an answer says that the database did not take the login, or undefined. A password
+ * refused when the connection is made is the code 28P01 with the severity FATAL; a proof
+ * that failed is the client's own error, which has no code. An error that a statement raises
+ * is neither: its severity is ERROR, and it has a code.
+ */
+function authFailure({ status, text }: PgMetaAnswer): string | undefined {
+  if (status >= 200 && status < 300) return undefined
+  let value: unknown
+  try {
+    value = JSON.parse(text)
+  } catch {
+    return undefined
+  }
+  const { severity, code, message } = (typeof value === 'object' && value ? value : {}) as {
+    severity?: unknown
+    code?: unknown
+    message?: unknown
+  }
+  if (code === '28P01' && severity === 'FATAL') return 'the password was refused'
+  if (code === undefined && typeof message === 'string' && message.startsWith(NO_PROOF)) {
+    return 'the server did not prove it holds the password'
+  }
+  return undefined
+}
+
+/**
+ * Asks postgres-meta, for the project of the request, as the member's role allows. Throws a
+ * ProjectError for every refusal of this server: `403 no_read_only_login`, `429 busy`, `503
+ * audit_unavailable`, `504 query_deadline`, `400 result_too_large`, `413 body_too_large`.
+ *
+ * When the database refuses the login, what is kept of the project is dropped and the
+ * control plane is asked once more; the call is sent again, once, only if the control plane
+ * now names another connection string.
+ */
+export async function callPgMeta(call: PgMetaCall): Promise<PgMetaAnswer> {
+  // read before the first wait: what follows a wait must not run for another request
+  const context = getProjectContext()
+  const flight = flights.getStore()
+  if (!flight) throw noContext()
+  const before = flight.turn
+  let done = () => {}
+  flight.turn = new Promise((r) => (done = r))
+  await before
+  const failed = (sent: Sent) => {
+    const failure = authFailure(sent)
+    if (failure) {
+      console.error(
+        `supapace: security: the database of ${context.ref} at port ${sent.port} did not take the login: ${failure}`
+      )
+    }
+    return failure !== undefined
+  }
+  try {
+    clearTimeout(flight.timer)
+    flight.late = false
+    let sent = await send(context, flight, call)
+    if (failed(sent)) {
+      dropProject(context.ref)
+      const assertion = {
+        text: context.assertion,
+        ref: context.ref,
+        ...context.principal,
+        role: context.role,
+        purpose: context.purpose,
+      }
+      const fresh = projectContext(assertion, await resolve(assertion))
+      const again = runWithProject(fresh, () =>
+        getConnectionString({
+          readOnly: call.kind === 'query' && call.readOnly === true,
+        })
+      )
+      if (again !== sent.dsn) {
+        // another instance has its own slots: the one held is given back first
+        if (fresh.pg_meta !== context.pg_meta) free(flight)
+        clearTimeout(flight.timer)
+        sent = await send(fresh, flight, call)
+        failed(sent)
+      }
+    }
+    return { status: sent.status, text: sent.text }
+  } catch (error) {
+    free(flight)
+    throw error
+  } finally {
+    done()
+  }
+}
+
+// --- the statement parser -----------------------------------------------------------------------
+
+const parsers = new Map<string, Lane>()
+
+/**
+ * Runs `parse` in a parser slot of the request's project: `parser_slots` at a time per
+ * project, a further request waiting as for a statement's slot.
+ */
+export async function parserSlot<T>(parse: () => T | Promise<T>): Promise<T> {
+  const { ref } = getProjectContext()
+  const flight = flights.getStore()
+  if (!flight) throw noContext()
+  const { parser_slots } = limits()
+  const lane = parsers.get(ref) ?? newLane(parser_slots, parser_slots, 1)
+  parsers.set(ref, lane)
+  try {
+    const release = await acquire(lane, ref, flight.signal)
+    try {
+      return await parse()
+    } finally {
+      release()
+    }
+  } finally {
+    if (lane.projects.size === 0 && parsers.get(ref) === lane) parsers.delete(ref)
+  }
+}
