+/** A statement of project `n` that postgres-meta has received and not answered: it holds a slot. */
+async function inFlight(n: number, signal?: AbortSignal, instance = 1) {
+  const meta = kit.metas[instance]
+  const count = meta.seen.length
+  const pending = kit.statement(kit.context(n, 'owner', {}, instance), undefined, signal)
+  pending.catch(() => {})
+  const seen = await meta.arrivals(count + 1)
+  return { pending, arrived: seen[count] }
+}
+/** A statement that is expected to wait or to be refused: its end is looked at later. */
+function asked(n: number, signal?: AbortSignal) {
+  const pending = kit.statement(kit.context(n), undefined, signal)
+  pending.catch(() => {})
+  return pending
+}
