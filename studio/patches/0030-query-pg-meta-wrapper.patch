+// SPDX-License-Identifier: Apache-2.0
+// For the tests of the path to postgres-meta: two HTTP servers of the test as its two
+// instances, a server on a Unix socket as the control plane, a data and a keys directory of
+// the test, and the modules under test loaded fresh. A server opens the header it is sent with
+// the test's key, as postgres-meta does, and so shows which connection string it was sent. A
+// test file sets the address of the two instances from `addresses`.
+
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { createServer, type IncomingHttpHeaders, type Server, type ServerResponse } from 'node:http'
+import type { AddressInfo } from 'node:net'
+import { tmpdir } from 'node:os'
