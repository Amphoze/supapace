+      response.status,
+      response.headers.get('content-type'),
+      response.headers.get('x-kept'),
+    ]).toEqual([203, 'application/json', '1'])
+    const reader = response.body!.getReader()
+    const pieces = [(await reader.read()).value!]
+    // the answer has arrived and a part of it is taken: the slot is still the reader's
+    await expect(kit.run(kit.context(2))).rejects.toMatchObject(busy)
+    pieces.push((await reader.read()).value!)
+    await expect(kit.run(kit.context(2))).rejects.toMatchObject(busy)
+    expect(meta.seen).toHaveLength(1)
+    for (let i = 2; i < 5; i++) pieces.push((await reader.read()).value!)
+    // the last piece is out and the reader has not come back for more: still the reader's
+    await expect(kit.run(kit.context(2))).rejects.toMatchObject(busy)
+    expect((await reader.read()).done).toBe(true)
+    // the body is whole, in pieces no larger than one hand-over
+    expect(Buffer.concat(pieces).toString()).toBe(large)
