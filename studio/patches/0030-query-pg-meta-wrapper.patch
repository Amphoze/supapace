@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: Apache-2.0
+// The request guard hands every request over through the path to postgres-meta: what a handler
+// asks of postgres-meta holds its slot until the guard's response has been taken.
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { port, ref, startKit, type Kit } from './pg-meta-testkit'
+
+// The assertion is the verifier's own test; here the header names the project.
+vi.mock('./assertion', () => ({
+  checkAssertionSettings: () => {},
+  verifyAssertion: (text: string | null) => ({
+    text: `v1.${text}.s`,
+    ref: text,
+    iss: 'https://issuer.test',
+    sub: 'u',
+    name: 'U',
+    role: 'owner',
+    purpose: '',
+  }),
+}))
+
+// a router with no route: every path is a page
+const router = {
+  parseLocation: (location: { pathname: string }) => ({
+    pathname: location.pathname,
+  }),
+  getMatchedRoutes: () => [null, {}, undefined] as [unknown, Record<string, unknown>, undefined],
+}
+
+describe('the guard and the path to postgres-meta', () => {
+  let kit: Kit
+  afterEach(async () => {
+    await kit.stop()
+    vi.unstubAllEnvs()
+  })
+
+  it('a guarded request’s statement holds its slot until the response is taken', async () => {
+    kit = await startKit({
+      instance_calls: 1,
+      project_calls: 1,
+      slot_wait_ms: 150,
+    })
+    vi.stubEnv('SUPAPACE_PGMETA', kit.addresses)
+    const guard = await import('./request-guard')
+    const meta = kit.metas[1]
+    meta.onRequest = (a) => a.res.end(JSON.stringify('x'.repeat(200_000)))
+    for (const n of [1, 2]) kit.control.answers.set(ref(n), kit.answer(ref(n), port(n), 'owner'))
+    const send = (n: number, signal?: AbortSignal) =>
+      guard.guardRequest(
+        {
+          request: new Request('http://studio.test/x', {
+            headers: { 'x-supapace-assertion': ref(n) },
+            signal,
+          }),
+          pathname: '/x',
+          next: async () => {
+            const { text } = await kit.pgMeta.callPgMeta({
+              kind: 'query',
+              sql: 'select 1',
+            })
+            return new Response(text)
+          },
+        },
+        () => router
+      ) as Promise<Response>
+
+    const first = await send(1)
+    expect(first.status).toBe(200)
+    // answered, not taken: the other project's request finds no slot and is told so
+    const refused = await send(2)
+    expect([refused.status, await refused.json()]).toEqual([
+      429,
+      { code: 'busy', message: expect.any(String) },
+    ])
+    // taken: the slot is free
+    expect(await first.text()).toHaveLength(200_002)
+    expect((await (await send(2)).text()).length).toBe(200_002)
+
+    // and a client that leaves gives it back
+    const client = new AbortController()
+    await send(1, client.signal)
+    client.abort()
+    expect((await (await send(2)).text()).length).toBe(200_002)
+    expect(meta.seen.map((a) => a.port)).toEqual([port(1), port(2), port(1), port(2)])
+  })
+})
