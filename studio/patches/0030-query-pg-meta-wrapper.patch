+    const resent = kit.request(kit.context(1), () => executeQuery({ query: 'select 1' }))
+    await meta.arrivals(1)
+    const waiting = asked(2)
+    meta.seen[0].res.statusCode = 400
+    meta.seen[0].res.end(JSON.stringify(failures[0][1]))
+    await meta.arrivals(2)
+    expect(meta.seen[1].dsn).toBe(dsn(RW, port(1), 'new'))
+    meta.seen[1].res.end('[{"ok":1}]')
+    expect(await resent).toEqual({ data: [{ ok: 1 }], error: undefined })
+    await meta.arrivals(3)
+    expect(meta.seen[2].port).toBe(port(2))
+    expect(await finish(meta.seen[2], waiting)).toBe('[]')
+    expect(meta.most).toBe(1)
+  })
+
+  it('another error of the database drops and asks nothing', async () => {
