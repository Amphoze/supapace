+    name: 'U',
+    role,
+    purpose: '',
+  })
+  /** The context of a request of project `n`, which is on instance `instance`. */
+  const context = (
+    n: number,
+    role: Assertion['role'] = 'owner',
+    more: object = {},
+    instance = 1
+  ): ProjectContext =>
+    contexts.projectContext(assertion(ref(n), role), answer(ref(n), port(n, instance), role, more))
