From: Amphoze <184834775+Amphoze@users.noreply.github.com>
Date: Tue, 24 Nov 2026 09:23:54 +0000
Subject: [PATCH 3/5] secrets: two headers to postgres-meta

A statement went to postgres-meta with the caller's cookie and the process's
service key as headers. The helper now passes the content type and the
encrypted connection string, and nothing else.
---
 apps/studio/lib/api/apiHelpers.test.ts | 10 +---------
 apps/studio/lib/api/apiHelpers.ts      | 20 +++++---------------
 2 files changed, 6 insertions(+), 24 deletions(-)

diff --git a/apps/studio/lib/api/apiHelpers.test.ts b/apps/studio/lib/api/apiHelpers.test.ts
index b4abbf64..dc4cb3af 100644
--- a/apps/studio/lib/api/apiHelpers.test.ts
+++ b/apps/studio/lib/api/apiHelpers.test.ts
@@ -41,12 +41,8 @@ describe('apiHelpers', () => {
 
       const result = constructHeaders(inputHeaders)
       expect(result).toEqual({
-        Accept: 'application/json',
-        Authorization: 'Bearer token',
         'Content-Type': 'application/json',
         'x-connection-encrypted': 'true',
-        cookie: 'test-cookie',
-        apiKey: 'test-service-key',
       })
     })
 
@@ -59,11 +55,7 @@ describe('apiHelpers', () => {
       }
 
       const result = constructHeaders(inputHeaders)
-      expect(result).toEqual({
-        Authorization: 'Bearer token',
-        'Content-Type': 'application/json',
-        apiKey: 'test-service-key',
-      })
+      expect(result).toEqual({ 'Content-Type': 'application/json' })
     })
   })
 
diff --git a/apps/studio/lib/api/apiHelpers.ts b/apps/studio/lib/api/apiHelpers.ts
index c53d44ff..239bf565 100644
--- a/apps/studio/lib/api/apiHelpers.ts
+++ b/apps/studio/lib/api/apiHelpers.ts
@@ -3,21 +3,16 @@ import { snakeCase } from 'lodash'
 import type { NextApiRequest } from 'next'
 import z from 'zod'
 
-import { IS_PLATFORM, PG_META_URL } from '@/lib/constants'
+import { PG_META_URL } from '@/lib/constants'
 
 /**
- * Construct headers for api request.
- * For platform, it will include apiKey into the provided headers.
- *
- * To prevent relay frontend request headers like useragent, referrer... into the middleware requests.
- * We will only keep the header keys that are in this list: Accept, Authorization, Content-Type, x-connection-encrypted
+ * Construct headers for a request to postgres-meta: of what it is handed, the content type and
+ * the encrypted connection string, and nothing else. No cookie, no authorization and no key of
+ * the project goes there.
  */
 export function constructHeaders(headers: { [prop: string]: any }) {
   if (headers) {
     const cleansedHeaders = {
-      Accept: headers.Accept,
-      Authorization: headers.Authorization,
-      cookie: headers.cookie,
       'Content-Type': headers['Content-Type'],
       'x-connection-encrypted': headers['x-connection-encrypted'],
     } as any
@@ -25,12 +20,7 @@ export function constructHeaders(headers: { [prop: string]: any }) {
     Object.keys(cleansedHeaders).forEach((key) =>
       cleansedHeaders[key] === undefined ? delete cleansedHeaders[key] : {}
     )
-    return {
-      ...cleansedHeaders,
-      // [Joshen] JFYI both Alaister and I checked on this and realised this might not be used actually
-      // Could be safe to remove but leaving it here for now
-      ...(!IS_PLATFORM && { apiKey: `${process.env.SUPABASE_SERVICE_KEY}` }),
-    }
+    return cleansedHeaders
   } else {
     return {
       'Content-Type': 'application/json',
