+// SPDX-License-Identifier: Apache-2.0
+// The project of a request. One server process serves many projects; everything it knows
+// about the one a request is for is held here, for that request alone, and comes from the
+// control plane's answer to the gateway's signed assertion. Outside a request there is no
+// project: the accessor throws.
+
+import { AsyncLocalStorage } from 'node:async_hooks'
+
+export type Role = 'owner' | 'developer' | 'read_only'
+export type RoleClass = 'rw' | 'ro'
+
+/** The gateway's assertion, as verified: who asks, for which project, in which role. */
+export type Assertion = {
+  /** the signed text, as received; presented to the control plane unchanged */
+  text: string
+  ref: string
+  iss: string
+  sub: string
+  name: string
+  role: Role
+  purpose: '' | 'reveal'
+}
+
+/** The control plane's answer for a project (the dashboard socket's `resolve`). */
+export type ResolveAnswer = {
+  ref: string
+  name: string
+  state: 'active' | 'restarting' | 'restoring'
+  db_version: string
+  /** which postgres-meta instance serves the project */
+  pg_meta: number
+  /** present for owner and developer only */
+  dsn_rw?: string
+  /** present when the project has its read-only login */
+  dsn_ro?: string
+  api_url: string
+  data_api: {
+    schemas: readonly string[]
+    extra_search_path: readonly string[]
+    max_rows: number | null
+  }
+  generation: number
+  at: string
+}
+
+/** Exactly the answer's members, the assertion's principal, role and purpose, and its text. */
+export type ProjectContext = Readonly<
+  ResolveAnswer & {
+    principal: Readonly<{ iss: string; sub: string; name: string }>
+    role: Role
+    purpose: '' | 'reveal'
+    assertion: string
+  }
+>
+
+/**
+ * A refusal the server itself gives; the body of its answer is `{code, message}`. It holds
+ * nothing but these three: never a connection string, a key or an assertion.
+ */
+export class ProjectError extends Error {
+  constructor(
+    readonly status: number,
+    readonly code: string,
+    message: string
+  ) {
+    super(message)
+    this.name = 'ProjectError'
+  }
+}
+
+/** `rw` for owner and developer, `ro` for read_only; any other role is refused. */
+export function roleClass(role: Role): RoleClass {
+  if (role === 'owner' || role === 'developer') return 'rw'
+  if (role === 'read_only') return 'ro'
+  throw new ProjectError(401, 'bad_assertion', 'The request names no known role')
+}
+
+const store = new AsyncLocalStorage<ProjectContext>()
+
+/** The context of a request: the answer for the assertion's project, and who asked. */
+export function projectContext(assertion: Assertion, answer: ResolveAnswer): ProjectContext {
+  if (answer.ref !== assertion.ref) {
+    throw new ProjectError(503, 'project_unavailable', 'The project is not available')
+  }
+  return Object.freeze({
+    ...answer,
+    principal: Object.freeze({
+      iss: assertion.iss,
+      sub: assertion.sub,
+      name: assertion.name,
+    }),
+    role: assertion.role,
+    purpose: assertion.purpose,
+    assertion: assertion.text,
+  })
+}
+
+/** Runs `fn`, and everything it awaits, as a request for the context's project. */
+export function runWithProject<T>(context: ProjectContext, fn: () => T): T {
+  return store.run(context, fn)
+}
+
+/** The project of the current request. Throws when there is none: no default project exists. */
+export function getProjectContext(): ProjectContext {
+  const context = store.getStore()
+  if (!context)
+    throw new ProjectError(500, 'no_project_context', 'No project context for this request')
+  return context
+}
