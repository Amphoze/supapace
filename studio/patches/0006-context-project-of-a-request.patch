+// SPDX-License-Identifier: Apache-2.0
+import { setTimeout as sleep } from 'node:timers/promises'
+import { describe, expect, it } from 'vitest'
+
+import {
+  getProjectContext,
+  projectContext,
+  ProjectError,
+  roleClass,
+  runWithProject,
+  type Assertion,
+  type ResolveAnswer,
+} from './project-context'
+
+const REF_A = 'abcdefghij0123456789'
+const REF_B = 'bcdefghij0123456789a'
+
+function answer(ref: string, port: number): ResolveAnswer {
+  return {
+    ref,
+    name: `project ${port}`,
+    state: 'active',
+    db_version: '17.6.1',
+    pg_meta: port % 2,
+    dsn_rw: `postgresql://postgres:rw${port}@10.212.0.6:${port}/postgres?sslmode=disable`,
+    dsn_ro: `postgresql://supabase_read_only_user:ro${port}@10.212.0.6:${port}/postgres?sslmode=disable`,
+    api_url: `https://${ref}.example.test`,
+    data_api: {
+      schemas: ['public'],
+      extra_search_path: ['public', 'extensions'],
+      max_rows: null,
+    },
+    generation: 4,
+    at: '2026-11-19T10:00:00Z',
+  }
+}
+
+function assertion(ref: string, sub: string, role: Assertion['role'] = 'owner'): Assertion {
+  return {
+    text: `v1.${sub}.${ref}`,
+    ref,
+    iss: 'https://issuer.test',
+    sub,
+    name: `N ${sub}`,
+    role,
+    purpose: '',
+  }
+}
+
+describe('api/self-hosted/project-context', () => {
+  it('has no context outside a request: the accessor throws', () => {
+    expect(() => getProjectContext()).toThrow(ProjectError)
+    try {
+      getProjectContext()
+    } catch (e) {
+      expect(e).toMatchObject({ status: 500, code: 'no_project_context' })
+    }
+  })
+
+  it('has no context after the request has ended', async () => {
+    const ctx = projectContext(assertion(REF_A, 'u1'), answer(REF_A, 20001))
+    await runWithProject(ctx, async () => {
+      await sleep(1)
+      expect(getProjectContext()).toBe(ctx)
+    })
+    expect(() => getProjectContext()).toThrow(ProjectError)
+  })
+
+  it('makes the context of the answer, member for member, with the principal, role and purpose', () => {
+    const a = {
+      ...assertion(REF_A, 'u1', 'developer'),
+      purpose: 'reveal' as const,
+    }
+    const ans = answer(REF_A, 20001)
+    const ctx = projectContext(a, ans)
+    expect(ctx).toEqual({
+      ...ans,
+      principal: { iss: a.iss, sub: a.sub, name: a.name },
+      role: 'developer',
+      purpose: 'reveal',
+      assertion: a.text,
+    })
+    expect(Object.keys(ctx).sort()).toEqual(
+      [...Object.keys(ans), 'principal', 'role', 'purpose', 'assertion'].sort()
+    )
+    expect(Object.isFrozen(ctx)).toBe(true)
+    expect(Object.isFrozen(ctx.principal)).toBe(true)
+  })
+
+  it('refuses an answer for another project than the assertion’s', () => {
+    expect(() => projectContext(assertion(REF_A, 'u1'), answer(REF_B, 20002))).toThrow(ProjectError)
+  })
+
+  it('keeps interleaved requests of two projects apart', async () => {
+    const seen: string[] = []
+    const request = (ref: string, port: number, n: number) =>
+      runWithProject(projectContext(assertion(ref, `u${n}`), answer(ref, port)), async () => {
+        for (let i = 0; i < 5; i++) {
+          await sleep((n * 7 + i * 3) % 5)
+          const ctx = getProjectContext()
+          seen.push(
+            `${ref}:${ctx.ref}:${ctx.dsn_rw!.includes(`:${port}/`)}:${ctx.principal.sub}:u${n}`
+          )
+        }
+      })
+    await Promise.all(
+      Array.from({ length: 40 }, (_, n) =>
+        n % 2 ? request(REF_A, 20001, n) : request(REF_B, 20002, n)
+      )
+    )
+    expect(seen).toHaveLength(200)
+    for (const s of seen) {
+      const [asked, got, port, sub, want] = s.split(':')
+      expect(got).toBe(asked)
+      expect(port).toBe('true')
+      expect(sub).toBe(want)
+    }
+  })
+
+  it('classes owner and developer as rw and read_only as ro, and nothing else', () => {
+    expect(roleClass('owner')).toBe('rw')
+    expect(roleClass('developer')).toBe('rw')
+    expect(roleClass('read_only')).toBe('ro')
+    expect(() => roleClass('admin' as any)).toThrow(ProjectError)
+    expect(() => roleClass('' as any)).toThrow(ProjectError)
+  })
+})
