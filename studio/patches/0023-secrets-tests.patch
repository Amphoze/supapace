Subject: [PATCH 5/5] secrets: tests of every settings and key route as each
 role

Through the request guard, with the control plane and postgres-meta as servers
of the test and marked values in the process under every name a key was read
from.
---
 .../lib/api/self-hosted/secrets.test.ts       | 630 ++++++++++++++++++
 1 file changed, 630 insertions(+)
 create mode 100644 apps/studio/lib/api/self-hosted/secrets.test.ts

diff --git a/apps/studio/lib/api/self-hosted/secrets.test.ts b/apps/studio/lib/api/self-hosted/secrets.test.ts
new file mode 100644
index 00000000..cc8058e1
--- /dev/null
+++ b/apps/studio/lib/api/self-hosted/secrets.test.ts
@@ -0,0 +1,630 @@
+// SPDX-License-Identifier: Apache-2.0
+// No secret in a settings response, and a project's keys from the control plane alone. Every
+// request here goes through the request guard with an assertion the test signs, as each role;
+// the control plane and postgres-meta are HTTP servers of the test. The process holds marked
+// values under every name upstream read a key or a secret from: none may be answered.
+import { createPrivateKey, sign as signBytes } from 'node:crypto'
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { createServer, type IncomingHttpHeaders, type Server } from 'node:http'
+import type { AddressInfo } from 'node:net'
+import { tmpdir } from 'node:os'
+import { join, resolve as resolvePath } from 'node:path'
+import { createRootRoute, createRoute, createRouter } from '@tanstack/react-router'
+import { afterAll, beforeAll, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { mswServer } from '@/tests/lib/msw'
+
+vi.mock('@sentry/react', () => ({
+  startSpan: (_o: unknown, fn: (span: unknown) => unknown) => fn({ setAttribute: () => {} }),
+  captureException: () => {},
+}))
+// postgres-meta is a server of this file; its address is known once it listens
+const { meta, withMeta } = vi.hoisted(() => {
+  const meta = { url: '' }
+  const withMeta = async (original: () => Promise<Record<string, unknown>>) => ({
+    ...(await original()),
+    get PG_META_URL() {
+      return meta.url
+    },
+  })
+  return { meta, withMeta }
+})
+vi.mock('@/lib/constants', withMeta)
+vi.mock('@/lib/constants/index', withMeta)
+
+const VECTOR_DIR = resolvePath(import.meta.dirname, '../../../../../vectors')
+const VECTORS = JSON.parse(readFileSync(join(VECTOR_DIR, 'tokens.json'), 'utf8'))
+const LIMITS = readFileSync(join(VECTOR_DIR, 'limits.json'), 'utf8').trim()
+const HEADER = 'X-Supapace-Assertion'
+const REF_A = 'abcdefghij0123456789'
+const REF_B = 'bcdefghij0123456789a'
+const ROLES = ['owner', 'developer', 'read_only'] as const
+
+// What the process holds under the names upstream took keys and secrets from.
+const PROCESS = {
+  AUTH_JWT_SECRET: 'process-jwt-secret-marker-0123456789abcdef',
+  SUPABASE_ANON_KEY: 'process-anon-key-marker',
+  SUPABASE_SERVICE_KEY: 'process-service-key-marker',
+  SUPABASE_PUBLISHABLE_KEY: 'sb_publishable_process-marker',
+  SUPABASE_SECRET_KEY: 'sb_secret_process-marker-0123456789',
+}
+// What the control plane holds for a project.
+const anonKey = (ref: string) => `anon.key.of-${ref}`
+const serviceKey = (ref: string) => `service.key.of-${ref}`
+const signingKeys = (ref: string) =>
+  ['anon', 'service_role', 'issuer'].map((cls, i) => ({
+    kid: `kid-${cls}-${ref}`,
+    class: cls,
+    alg: 'RS256',
+    kty: 'RSA',
+    n: Buffer.from(`modulus ${i} of ${ref}`).toString('base64url'),
+    e: 'AQAB',
+  }))
+
+const KEY_LIST = (ref: string) => `/api/v1/projects/${ref}/api-keys`
+const SIGNING_KEYS = (ref: string) => `/api/v1/projects/${ref}/config/auth/signing-keys`
+// The routes that answer settings or keys, as a member requests them without a reveal.
+const PLAIN = (ref: string) => [
+  `/api/platform/projects/${ref}/settings`,
+  `/api/platform/projects/${ref}/config`,
+  `/api/platform/projects/${ref}/config/postgrest`,
+  `/api/platform/props/project/${ref}/api`,
+  KEY_LIST(ref),
+  `${KEY_LIST(ref)}?reveal=false`,
+  `${KEY_LIST(ref)}/anon`,
+  SIGNING_KEYS(ref),
+]
+// The two requests the gateway signs with the purpose `reveal`, for an owner.
+const REVEAL = (ref: string) => [
+  `${KEY_LIST(ref)}?reveal=true`,
+  `${KEY_LIST(ref)}/service_role?reveal=true`,
+]
+
+const privateKey = createPrivateKey({
+  key: { kty: 'OKP', crv: 'Ed25519', d: VECTORS.private_file, x: VECTORS.public_file },
+  format: 'jwk',
+})
+function assertion(ref: string, role: string, purpose = '', sub = `member-${role}`) {
+  const iat = Math.floor(Date.now() / 1000)
+  const claims = {
+    node: VECTORS.node,
+    iss: 'https://issuer.test',
+    sub,
+    name: `N ${sub}`,
+    ref,
+    role,
+    purpose,
+    iat,
+    exp: iat + 30,
+  }
+  const p = Buffer.from(JSON.stringify(claims)).toString('base64url')
+  const s = signBytes(null, Buffer.from('supapace-assertion-v1.' + p), privateKey)
+  return `v1.${p}.${s.toString('base64url')}`
+}
+
+function resolveAnswer(ref: string, role: string) {
+  const port = ref === REF_A ? 20001 : 20002
+  const dsn = (login: string) =>
+    `postgresql://${login}:pw${port}@10.212.0.6:${port}/postgres?sslmode=disable`
+  return {
+    ref,
+    name: `project ${port}`,
+    state: 'active',
+    db_version: '17.6.1',
+    pg_meta: port % 2,
+    ...(role !== 'read_only' && { dsn_rw: dsn('postgres') }),
+    dsn_ro: dsn('supabase_read_only_user'),
+    api_url: `https://${ref}.example.test`,
+    data_api: { schemas: ['public'], extra_search_path: ['public', 'extensions'], max_rows: null },
+    generation: 4,
+    at: new Date().toISOString().replace(/\.\d+Z$/, 'Z'),
+  }
+}
+
+type Claims = { ref: string; sub: string; role: string; purpose: string }
+type Reply = { status: number; body: unknown }
+// The control plane's own rule: the service_role key for an owner under the purpose reveal.
+const honest = (c: Claims): Reply => ({
+  status: 200,
+  body: {
+    anon_key: anonKey(c.ref),
+    signing_keys: signingKeys(c.ref),
+    ...(c.role === 'owner' && c.purpose === 'reveal' && { service_role_key: serviceKey(c.ref) }),
+  },
+})
+
+describe('secrets and keys', () => {
+  let dir: string
+  let socket: Server
+  let pgMeta: Server
+  let asked: string[]
+  let metaSeen: { url: string; headers: IncomingHttpHeaders }[]
+  let keysReply: (c: Claims) => Reply
+  let said: string[]
+  let guard: typeof import('./request-guard')
+  let router: any
+
+  /** One request through the guard to the route's own handler, as the server dispatches it. */
+  async function send(
+    target: string,
+    token: string,
+    init: {
+      method?: string
+      headers?: Record<string, string>
+      body?: string
+      // what runs in the request's context, in place of the route's handler
+      run?: () => Promise<unknown>
+    } = {}
+  ) {
+    const headers = new Headers(init.headers)
+    headers.set(HEADER, token)
+    const request = new Request(`http://studio.test${target}`, {
+      method: init.method ?? 'GET',
+      headers,
+      body: init.body,
+    })
+    const pathname = new URL(request.url).pathname
+    const next = async () => {
+      if (init.run) return Response.json(await init.run())
+      const [, params, found] = router.getMatchedRoutes(
+        router.parseLocation({ href: pathname, pathname, search: '', hash: '', state: {} }).pathname
+      )
+      return found.options.server.handlers[request.method]({ request, params })
+    }
+    const response = (await guard.guardRequest({ request, pathname, next }, () => router)) as Response
+    const text = await response.text()
+    let json: any
+    try {
+      json = JSON.parse(text)
+    } catch {
+      json = undefined
+    }
+    return { response, status: response.status, text, json }
+  }
+  /** Every secret of the test that a text holds: the process's, and any project's service key. */
+  const secretsIn = (text: string) =>
+    [...Object.values(PROCESS), serviceKey(REF_A), serviceKey(REF_B)].filter((s) =>
+      text.includes(s)
+    )
+  const keyCalls = () => asked.filter((line) => line.startsWith('/v1/keys '))
+
+  beforeAll(async () => {
+    // the requests of this file go to servers of its own
+    mswServer.close()
+    dir = mkdtempSync(join(tmpdir(), 'secrets-'))
+    writeFileSync(join(dir, 'assert.pub'), VECTORS.public_file + '\n')
+    writeFileSync(join(dir, 'cache.key'), Buffer.alloc(32, 7).toString('base64url') + '\n')
+    writeFileSync(join(dir, 'crypto.key'), 'k'.repeat(64) + '\n')
+    socket = createServer((req, res) => {
+      const text = String(req.headers[HEADER.toLowerCase()])
+      const claims = JSON.parse(Buffer.from(text.split('.')[1], 'base64url').toString('utf8'))
+      asked.push(`${req.url} ${claims.ref} ${claims.sub} ${claims.role} ${claims.purpose}`)
+      res.setHeader('content-type', 'application/json')
+      const reply =
+        req.url === '/v1/resolve'
+          ? { status: 200, body: resolveAnswer(claims.ref, claims.role) }
+          : keysReply(claims)
+      res.statusCode = reply.status
+      res.end(typeof reply.body === 'string' ? reply.body : JSON.stringify(reply.body))
+    })
+    await new Promise<void>((done) => socket.listen(join(dir, 'dash.sock'), done))
+    pgMeta = createServer((req, res) => {
+      metaSeen.push({ url: String(req.url), headers: req.headers })
+      res.setHeader('content-type', 'application/json')
+      res.end(req.url?.startsWith('/generators/') ? '{"types":""}' : '[]')
+    })
+    await new Promise<void>((done) => pgMeta.listen(0, '127.0.0.1', done))
+
+    vi.stubEnv('SUPAPACE_LIMITS', LIMITS)
+    vi.stubEnv('SUPAPACE_DASH_SOCKET', join(dir, 'dash.sock'))
+    vi.stubEnv('SUPAPACE_DASH_DATA', join(dir, 'data'))
+    vi.stubEnv('SUPAPACE_DASH_KEYS', dir)
+    vi.stubEnv('SUPAPACE_PGCAP', '10.212.0.6:20000:21023')
+    vi.stubEnv('SUPAPACE_NODE_ID', VECTORS.node)
+    meta.url = `http://127.0.0.1:${(pgMeta.address() as AddressInfo).port}`
+    for (const [name, value] of Object.entries(PROCESS)) vi.stubEnv(name, value)
+    delete process.env.TSS_PRERENDERING
+
+    said = []
+    for (const level of ['log', 'info', 'warn', 'error'] as const) {
+      vi.spyOn(console, level).mockImplementation((...args) => void said.push(args.join(' ')))
+    }
+    guard = await import('./request-guard')
+    const files: Record<string, { Route: any }> = {
+      '/api/platform/projects/$ref/settings': await import(
+        '@/routes/api/platform/projects/$ref/settings'
+      ),
+      '/api/platform/projects/$ref/config': await import(
+        '@/routes/api/platform/projects/$ref/config/index'
+      ),
+      '/api/platform/projects/$ref/config/postgrest': await import(
+        '@/routes/api/platform/projects/$ref/config/postgrest'
+      ),
+      '/api/platform/props/project/$ref/api': await import(
+        '@/routes/api/platform/props/project/$ref/api'
+      ),
+      '/api/v1/projects/$ref/api-keys': await import('@/routes/api/v1/projects/$ref/api-keys'),
+      '/api/v1/projects/$ref/api-keys/$id': await import(
+        '@/routes/api/v1/projects/$ref/api-keys/$id'
+      ),
+      '/api/v1/projects/$ref/config/auth/signing-keys': await import(
+        '@/routes/api/v1/projects/$ref/config/auth/signing-keys/index'
+      ),
+      '/api/platform/pg-meta/$ref/query': await import(
+        '@/routes/api/platform/pg-meta/$ref/query/index'
+      ),
+      '/api/platform/projects/$ref/run-lints': await import(
+        '@/routes/api/platform/projects/$ref/run-lints'
+      ),
+      '/api/v1/projects/$ref/database/migrations': await import(
+        '@/routes/api/v1/projects/$ref/database/migrations'
+      ),
+      '/api/v1/projects/$ref/types/typescript': await import(
+        '@/routes/api/v1/projects/$ref/types/typescript'
+      ),
+    }
+    // the routes as the application registers them, each with its own handlers
+    const root = createRootRoute()
+    router = createRouter({
+      routeTree: root.addChildren(
+        Object.entries(files).map(([path, file]) =>
+          createRoute({
+            getParentRoute: () => root,
+            path,
+            server: file.Route.options.server,
+          } as any)
+        )
+      ),
+    })
+  }, 300_000) // the routes' module graph is large; its first import is slow on a busy host
+
+  beforeEach(() => {
+    asked = []
+    metaSeen = []
+    keysReply = honest
+  })
+
+  afterAll(async () => {
+    vi.unstubAllEnvs()
+    vi.restoreAllMocks()
+    await new Promise((done) => socket.close(done))
+    await new Promise((done) => pgMeta.close(done))
+    rmSync(dir, { recursive: true, force: true })
+  })
+
+  describe('settings responses', () => {
+    it.each(ROLES)('carry no jwt_secret, as %s', async (role) => {
+      for (const path of PLAIN(REF_A).slice(0, 3)) {
+        const { status, text, json } = await send(path, assertion(REF_A, role))
+        expect([path, status]).toEqual([path, 200])
+        expect(text).not.toMatch(/jwt_secret/i)
+        expect(secretsIn(text)).toEqual([])
+        // the control: the route answered its settings
+        expect(Object.keys(json).length).toBeGreaterThan(3)
+      }
+    })
+
+    it.each(ROLES)('carry no service_role key, as %s', async (role) => {
+      const settings = await send(PLAIN(REF_A)[0], assertion(REF_A, role))
+      const props = await send(PLAIN(REF_A)[3], assertion(REF_A, role))
+      const list = await send(KEY_LIST(REF_A), assertion(REF_A, role))
+      for (const { status, text } of [settings, props, list]) {
+        expect(status).toBe(200)
+        expect(secretsIn(text)).toEqual([])
+      }
+      // settings names the two keys and answers neither; the list holds the anon key alone
+      expect(settings.json.service_api_keys).toEqual([
+        { api_key: '', name: 'anon key', tags: 'anon' },
+        { api_key: '', name: 'service_role key', tags: 'service_role' },
+      ])
+      expect(props.text).not.toMatch(/defaultApiKey|serviceApiKey/)
+      expect(list.json.map((k: any) => [k.id, k.api_key])).toEqual([['anon', anonKey(REF_A)]])
+    })
+
+    it('answer nothing of the process, whatever purpose the assertion has', async () => {
+      // an assertion with the purpose is valid for every route of its project while it lives
+      for (const path of PLAIN(REF_A)) {
+        const { status, text } = await send(path, assertion(REF_A, 'owner', 'reveal'))
+        expect([path, status]).toEqual([path, 200])
+        expect([path, secretsIn(text)]).toEqual([path, []])
+        expect(text).not.toMatch(/jwt_secret/i)
+      }
+    })
+  })
+
+  describe('a reveal request', () => {
+    it('carries the key for an owner under the purpose, and is not to be stored', async () => {
+      const [list, one] = await Promise.all(
+        REVEAL(REF_A).map((path) => send(path, assertion(REF_A, 'owner', 'reveal')))
+      )
+      expect(list.status).toBe(200)
+      expect(list.json.map((k: any) => [k.id, k.api_key])).toEqual([
+        ['anon', anonKey(REF_A)],
+        ['service_role', serviceKey(REF_A)],
+      ])
+      expect(one.status).toBe(200)
+      expect(one.json).toMatchObject({ id: 'service_role', api_key: serviceKey(REF_A) })
+      for (const { response, text } of [list, one]) {
+        expect(response.headers.get('cache-control')).toBe('no-store')
+        expect(response.headers.has('etag')).toBe(false)
+        // the project's own key and nothing of the process
+        expect(secretsIn(text)).toEqual([serviceKey(REF_A)])
+      }
+    })
+
+    it('carries none under a context without the purpose', async () => {
+      const [list, one] = await Promise.all(
+        REVEAL(REF_A).map((path) => send(path, assertion(REF_A, 'owner')))
+      )
+      expect(list.json.map((k: any) => k.id)).toEqual(['anon'])
+      expect(one.status).toBe(404)
+      expect(secretsIn(list.text + one.text)).toEqual([])
+      // nor when the control plane answers the key all the same: that answer is refused
+      keysReply = (c) => honest({ ...c, purpose: 'reveal' })
+      for (const path of REVEAL(REF_A)) {
+        const { status, text } = await send(path, assertion(REF_A, 'owner'))
+        expect([path, status, secretsIn(text)]).toEqual([path, 503, []])
+      }
+    })
+
+    it.each(['developer', 'read_only'])('never carries one for a %s', async (role) => {
+      for (const purpose of ['', 'reveal']) {
+        // a hostile control plane too: the key is in its answer whoever asks
+        for (const reply of [honest, (c: Claims) => honest({ ...c, role: 'owner', purpose: 'reveal' })]) {
+          keysReply = reply
+          for (const path of REVEAL(REF_A)) {
+            const { status, text } = await send(path, assertion(REF_A, role, purpose))
+            expect(status).not.toBe(500)
+            expect([path, purpose, secretsIn(text)]).toEqual([path, purpose, []])
+          }
+        }
+      }
+    })
+
+    it('takes the purpose from the assertion alone: not from a header, a query or a body', async () => {
+      const claims = {
+        purpose: 'reveal',
+        'x-supapace-purpose': 'reveal',
+        'x-purpose': 'reveal',
+        'x-reveal': 'true',
+        cookie: 'purpose=reveal; reveal=true',
+      }
+      for (const role of ROLES) {
+        for (const path of [
+          ...REVEAL(REF_A),
+          `${KEY_LIST(REF_A)}?reveal=true&purpose=reveal`,
+          `${KEY_LIST(REF_A)}/service_role?purpose=reveal&reveal=true&role=owner`,
+        ]) {
+          const { text } = await send(path, assertion(REF_A, role), { headers: claims })
+          expect([role, path, secretsIn(text)]).toEqual([role, path, []])
+        }
+      }
+      // every call reached the control plane with the assertion's own, empty purpose
+      expect(keyCalls().length).toBe(12)
+      expect(keyCalls().every((line) => line.endsWith(' '))).toBe(true)
+    })
+
+    it('needs the request to ask: an assertion with the purpose reveals nothing by itself', async () => {
+      const token = () => assertion(REF_A, 'owner', 'reveal')
+      for (const query of ['', '?reveal=false', '?reveal=TRUE', '?reveal=1', '?reveal', '?Reveal=true']) {
+        const list = await send(KEY_LIST(REF_A) + query, token())
+        const one = await send(`${KEY_LIST(REF_A)}/service_role${query}`, token())
+        expect([query, list.json.map((k: any) => k.id)]).toEqual([query, ['anon']])
+        expect([query, one.status]).toEqual([query, 404])
+        expect(secretsIn(list.text + one.text)).toEqual([])
+      }
+    })
+
+    it('is asked of the control plane every time: no answer is kept for a later request', async () => {
+      const reveal = REVEAL(REF_A)
+      const first = await send(reveal[0], assertion(REF_A, 'owner', 'reveal'))
+      expect(secretsIn(first.text)).toEqual([serviceKey(REF_A)])
+      // the same requests, later: another role, the same owner without the purpose, the
+      // same owner of another project, and a member of both projects
+      for (const [ref, role, purpose, want] of [
+        [REF_A, 'developer', '', []],
+        [REF_A, 'read_only', '', []],
+        [REF_A, 'owner', '', []],
+        [REF_B, 'owner', '', []],
+        [REF_B, 'owner', 'reveal', [serviceKey(REF_B)]],
+        [REF_A, 'owner', 'reveal', [serviceKey(REF_A)]],
+      ] as const) {
+        for (const path of REVEAL(ref)) {
+          const { text } = await send(path, assertion(ref, role, purpose, 'the-same-member'))
+          expect([ref, role, purpose, secretsIn(text)]).toEqual([ref, role, purpose, want])
+        }
+      }
+      expect(keyCalls().length).toBe(13)
+    })
+
+    it('answers each of two projects its own key when their requests interleave', async () => {
+      const answers = await Promise.all(
+        Array.from({ length: 40 }, (_, i) => {
+          const ref = i % 2 ? REF_A : REF_B
+          return send(REVEAL(ref)[i % 4 < 2 ? 0 : 1], assertion(ref, 'owner', 'reveal')).then(
+            ({ text }) => [ref, secretsIn(text)]
+          )
+        })
+      )
+      for (const [ref, found] of answers) expect(found).toEqual([serviceKey(ref as string)])
+    })
+  })
+
+  describe('the keys', () => {
+    it('are the control plane’s, never the process’s', async () => {
+      for (const role of ROLES) {
+        const list = await send(KEY_LIST(REF_B), assertion(REF_B, role))
+        const one = await send(`${KEY_LIST(REF_B)}/anon`, assertion(REF_B, role))
+        expect(list.json).toEqual([
+          {
+            name: 'anon',
+            api_key: anonKey(REF_B),
+            id: 'anon',
+            type: 'legacy',
+            hash: '',
+            prefix: '',
+            description: 'Legacy anon API key',
+          },
+        ])
+        expect(one.json).toEqual(list.json[0])
+        expect(one.response.headers.get('cache-control')).toBe('no-store')
+      }
+      for (const id of ['publishable', 'secret', 'service_role', 'missing', '__proto__']) {
+        const { status, text } = await send(`${KEY_LIST(REF_A)}/${id}`, assertion(REF_A, 'owner'))
+        expect([id, status]).toEqual([id, 404])
+        expect(secretsIn(text)).toEqual([])
+      }
+    })
+
+    it.each([
+      ['refuses', { status: 403, body: { code: 'not_a_member' } }, 403, 'not_a_member'],
+      ['is unavailable', { status: 503, body: { code: 'unavailable' } }, 503, 'unavailable'],
+      ['answers what is no answer', { status: 200, body: 'not json' }, 503, 'project_unavailable'],
+      [
+        'answers a key that is no token',
+        { status: 200, body: { anon_key: 'a b', signing_keys: [] } },
+        503,
+        'project_unavailable',
+      ],
+    ])('are refused when the control plane %s: no key of the process stands in', async (_, reply, status, code) => {
+      keysReply = () => reply
+      for (const path of [KEY_LIST(REF_A), ...REVEAL(REF_A), SIGNING_KEYS(REF_A)]) {
+        const sent = await send(path, assertion(REF_A, 'owner', 'reveal'))
+        expect([path, sent.status, sent.json]).toEqual([
+          path,
+          status,
+          { code, message: expect.any(String) },
+        ])
