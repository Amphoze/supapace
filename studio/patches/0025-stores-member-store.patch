+// SPDX-License-Identifier: Apache-2.0
+// The snippet store: private per member, shared per project, bounded per project, and found
+// from the request's context alone.
+import { execFileSync } from 'node:child_process'
+import {
+  existsSync,
+  lstatSync,
+  mkdirSync,
+  mkdtempSync,
+  readdirSync,
+  readFileSync,
+  rmSync,
+  statSync,
+  symlinkSync,
+  writeFileSync,
+} from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join, resolve as resolvePath } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import {
+  acquireRead,
+  checkName,
+  countSnippets,
+  createFolder,
+  deleteFolders,
+  deleteSnippets,
+  getSnippet,
+  listFolders,
+  listSnippets,
+  NAME_BYTES,
+  principalDir,
+  putSnippet,
+  READ_SLOTS,
+  READ_SLOTS_PROJECT,
+  READ_WAITING,
+  READ_WAITING_PROJECT,
+  readsHeld,
+  sharedId,
+  sqlAnswer,
+  type Snippet,
+} from './member-store'
+import { projectContext, ProjectError, runWithProject, type Assertion } from './project-context'
+
+const VECTORS = resolvePath(import.meta.dirname, '../../../../../vectors')
+const LIMITS = JSON.parse(readFileSync(join(VECTORS, 'limits.json'), 'utf8'))
+const MAX_BYTES: number = LIMITS.snippet_bytes
+const MAX_ENTRIES: number = LIMITS.snippet_entries
+const REF_A = 'abcdefghij0123456789'
+const REF_B = 'bcdefghij0123456789a'
+const ISS = 'https://issuer.test'
+const NEW_ID = '00000000-0000-4000-8000-000000000001'
+
+type Who = { ref: string; sub: string; iss?: string; role?: Assertion['role'] }
+const A1: Who = { ref: REF_A, sub: 'alice' }
+const A2: Who = { ref: REF_A, sub: 'bob' }
+const B1: Who = { ref: REF_B, sub: 'carol' }
+
+function as<T>(who: Who, fn: () => Promise<T>): Promise<T> {
+  const role = who.role ?? 'developer'
+  const ctx = projectContext(
+    {
+      text: 'v1.x.y',
+      ref: who.ref,
+      iss: who.iss ?? ISS,
+      sub: who.sub,
+      name: who.sub,
+      role,
+      purpose: '',
+    },
+    {
+      ref: who.ref,
+      name: 'p',
+      state: 'active',
+      db_version: '17.6.1',
+      pg_meta: 0,
+      ...(role === 'read_only' ? {} : { dsn_rw: 'postgresql://x' }),
+      api_url: `https://${who.ref}.example.test`,
+      data_api: { schemas: ['public'], extra_search_path: [], max_rows: null },
+      generation: 1,
+      at: new Date().toISOString(),
+    }
+  )
+  return runWithProject(ctx, fn)
+}
+
+/** The refusal `fn` ends in, as `<status> <code>`. */
+async function refusal(fn: () => Promise<unknown>): Promise<string> {
+  try {
+    await fn()
+  } catch (e) {
+    if (e instanceof ProjectError) return `${e.status} ${e.code}`
+    throw e
+  }
+  return 'no refusal'
+}
+
+const put = (who: Who, body: Record<string, unknown>) =>
+  as(who, () => putSnippet({ id: NEW_ID, ...body }))
+const save = (who: Who, name: string, sql = `select '${name}'`, extra = {}) =>
+  put(who, { name, content: { sql }, visibility: 'user', ...extra })
+const names = (r: { snippets: { name: string }[] }) => r.snippets.map((s) => s.name).sort()
+// runs fn in a read slot, as the routes' answers do
+const reading = async <T>(ref: string, fn: () => Promise<T>): Promise<T> => {
+  const release = await acquireRead(ref)
+  try {
+    return await fn()
+  } finally {
+    release()
+  }
+}
+
+describe('the member store', () => {
+  let dir: string
+  let data: string
+  const pdir = (who: Who) => principalDir(who.iss ?? ISS, who.sub)
+  const own = (who: Who) => join(data, who.ref, 'snippets', pdir(who))
+  const shared = (who: Who) => join(data, who.ref, 'snippets', 'shared', pdir(who))
+
+  beforeEach(() => {
+    dir = mkdtempSync(join(tmpdir(), 'dash-store-'))
+    data = join(dir, 'data')
+    mkdirSync(data)
+    vi.stubEnv('SUPAPACE_DASH_DATA', data)
+    vi.stubEnv('SUPAPACE_LIMITS', JSON.stringify(LIMITS))
+    vi.spyOn(console, 'error').mockImplementation(() => {})
+  })
+  afterEach(() => {
+    vi.unstubAllEnvs()
+    vi.restoreAllMocks()
+    rmSync(dir, { recursive: true, force: true })
+  })
+
+  describe('per member and per project', () => {
+    it("a member's snippet is not listed for another member of the project", async () => {
+      await save(A1, 'mine')
+      expect(names(await as(A1, () => listSnippets()))).toEqual(['mine']) // control
+      expect(names(await as(A2, () => listSnippets()))).toEqual([])
+      expect(names(await as(A2, () => listSnippets({ visibility: 'project' })))).toEqual([])
+      expect(names(await as(A2, () => listSnippets({ searchTerm: 'mine' })))).toEqual([])
+    })
+
+    it("a member's snippet is not readable, changeable or deletable by another member", async () => {
+      const s = await save(A1, 'mine', 'select secret')
+      expect(await refusal(() => as(A2, () => getSnippet(s.id)))).toBe('404 not_found')
+      expect(await refusal(() => as(A2, () => deleteSnippets([s.id])))).toBe('404 not_found')
+      // a write with the id makes a snippet of the writer's own; the owner's is unchanged
+      await as(A2, () => putSnippet({ id: s.id, name: 'mine', content: { sql: 'select 2' } }))
+      expect((await as(A1, () => getSnippet(s.id))).content.sql).toBe('select secret')
+      expect((await as(A2, () => getSnippet(s.id))).content.sql).toBe('select 2')
+    })
+
+    it('a shared one is listed and readable for every member of the project', async () => {
+      const s = await save(A1, 'team', 'select 1', { visibility: 'project' })
+      expect(s.visibility).toBe('project')
+      const listed = await as(A2, () => listSnippets({ visibility: 'project' }))
+      expect(names(listed)).toEqual(['team'])
+      expect(listed.snippets[0]).toMatchObject({ id: s.id, owner_id: 0, visibility: 'project' })
+      expect(
+        (await as(A1, () => listSnippets({ visibility: 'project' }))).snippets[0].owner_id
+      ).toBe(1)
+      expect((await as(A2, () => getSnippet(s.id))).content.sql).toBe('select 1')
+      expect(await as(A2, () => countSnippets())).toEqual({ shared: 1, favorites: 0, private: 0 })
+      // not in the other project
+      expect(names(await as(B1, () => listSnippets({ visibility: 'project' })))).toEqual([])
+    })
+
+    it('a shared snippet is changed and deleted by its author only', async () => {
+      const s = await save(A1, 'team', 'select 1', { visibility: 'project' })
+      expect(
+        await refusal(() =>
+          as(A2, () => putSnippet({ id: s.id, content: { sql: 'drop table x' } }))
+        )
+      ).toBe('403 not_author')
+      expect(await refusal(() => as(A2, () => deleteSnippets([s.id])))).toBe('403 not_author')
+      expect((await as(A2, () => getSnippet(s.id))).content.sql).toBe('select 1')
+      // control: its author may
+      await as(A1, () => putSnippet({ id: s.id, content: { sql: 'select 3' } }))
+      expect((await as(A2, () => getSnippet(s.id))).content.sql).toBe('select 3')
+      await as(A1, () => deleteSnippets([s.id]))
+      expect(await refusal(() => as(A2, () => getSnippet(s.id)))).toBe('404 not_found')
+    })
+
+    it('a private and a shared snippet of one name have different ids', async () => {
+      const mine = await save(A1, 'report')
+      const team = await save(A2, 'report', 'select 2', { visibility: 'project' })
+      expect(mine.id).not.toBe(team.id)
+      expect(team.id).toBe(sharedId(pdir(A2), 'report'))
+      // two authors' shared snippets of one name, too
+      const team1 = await put(A1, { id: mine.id, visibility: 'project' })
+      expect(team1.id).not.toBe(team.id)
+      const all = await as(A1, () => listSnippets({ visibility: 'project' }))
+      expect(new Set(all.snippets.map((s) => s.id)).size).toBe(2)
+    })
+
+    it("a member's own snippet keeps the id the editor derives from its folder and name", async () => {
+      const { generateDeterministicUuid } = await import('../snippets.browser')
+      const s = await save(A1, 'Untitled query 1')
+      expect(s.id).toBe(generateDeterministicUuid(['Untitled query 1.sql']))
+      // a second save by that id changes it in place
+      await as(A1, () => putSnippet({ id: s.id, content: { sql: 'select 9' } }))
+      const listed = await as(A1, () => listSnippets())
+      expect(listed.snippets).toHaveLength(1)
+      expect((listed.snippets[0] as Snippet).content.sql).toBe('select 9')
+    })
+
+    it('a share moves the file, and an unshare moves it back', async () => {
+      const s = await save(A1, 'q', 'select 1')
+      expect(readdirSync(own(A1))).toEqual(['q.sql'])
+      const team = await put(A1, { id: s.id, visibility: 'project', folder_id: null })
+      expect(readdirSync(own(A1))).toEqual([])
+      expect(readdirSync(shared(A1))).toEqual(['q.sql'])
+      expect(readFileSync(join(shared(A1), 'q.sql'), 'utf8')).toBe('select 1')
+      expect(team.id).not.toBe(s.id)
+      expect(await refusal(() => as(A1, () => getSnippet(s.id)))).toBe('404 not_found')
+      const back = await put(A1, { id: team.id, visibility: 'user', folder_id: null })
+      expect(back.id).toBe(s.id)
+      expect(readdirSync(shared(A1))).toEqual([])
+      expect(readdirSync(own(A1))).toEqual(['q.sql'])
+    })
+
+    it('a shared snippet is in no folder', async () => {
+      const f = await as(A1, () => createFolder('f'))
+      expect(
+        await refusal(() => save(A1, 'q', 'select 1', { visibility: 'project', folder_id: f.id }))
+      ).toBe('400 bad_request')
+    })
+
+    it('org and public visibility are refused', async () => {
+      for (const visibility of ['org', 'public', 'other']) {
+        expect(await refusal(() => save(A1, 'q', 'x', { visibility }))).toBe('400 bad_request')
+      }
+      expect(existsSync(join(data, REF_A))).toBe(false)
+    })
+
+    it("nothing of one project's directory is reachable under another's context", async () => {
+      const mine = await save(A1, 'a-private')
+      const team = await save(A1, 'a-shared', 'select 1', { visibility: 'project' })
+      const f = await as(A1, () => createFolder('a-folder'))
+      // the same principal in project B sees nothing of A
+      const sameInB: Who = { ref: REF_B, sub: A1.sub }
+      for (const who of [B1, sameInB]) {
+        expect(names(await as(who, () => listSnippets()))).toEqual([])
+        expect(names(await as(who, () => listSnippets({ visibility: 'project' })))).toEqual([])
+        expect(await as(who, () => listFolders())).toEqual([])
+        expect(await as(who, () => countSnippets())).toEqual({
+          shared: 0,
+          favorites: 0,
+          private: 0,
+        })
+        for (const id of [mine.id, team.id]) {
+          expect(await refusal(() => as(who, () => getSnippet(id)))).toBe('404 not_found')
+          expect(await refusal(() => as(who, () => deleteSnippets([id])))).toBe('404 not_found')
+        }
+        expect(await refusal(() => as(who, () => deleteFolders([f.id])))).toBe('404 not_found')
+        expect(
+          await refusal(() => as(who, () => putSnippet({ id: team.id, content: { sql: 'x' } })))
+        ).toBe('400 bad_name') // no such snippet there, and the write names none
+      }
+      expect(readdirSync(join(data, REF_A, 'snippets', pdir(A1))).sort()).toEqual([
+        'a-folder',
+        'a-private.sql',
+      ])
+      expect(existsSync(join(data, REF_B, 'snippets', 'shared'))).toBe(false)
+    })
+  })
+
+  describe('ids and names', () => {
+    const hostileIds = [
+      '..',
+      '../x',
+      'a/b',
+      'a\\b',
+      '%2e%2e%2f',
+      '..%2F..%2Fetc',
+      `${NEW_ID}/..`,
+      `../${NEW_ID}`,
+      `${NEW_ID}\u0000`,
+      NEW_ID.toUpperCase().replace(/-/g, '∕'),
+      '',
+    ]
+    it.each(hostileIds)('an id with `..` or a separator is refused: %j', async (id) => {
+      await save(A1, 'x')
+      expect(await refusal(() => as(A1, () => getSnippet(id)))).toBe('400 bad_id')
+      expect(await refusal(() => as(A1, () => deleteSnippets([id])))).toBe('400 bad_id')
+      expect(await refusal(() => as(A1, () => deleteFolders([id])))).toBe('400 bad_id')
+      expect(await refusal(() => as(A1, () => putSnippet({ id, name: 'y' })))).toBe('400 bad_id')
+      expect(await refusal(() => save(A1, 'y', 'x', { folder_id: id }))).toBe('400 bad_id')
+      expect(await refusal(() => as(A1, () => listSnippets({ folderId: id })))).toBe('400 bad_id')
+      expect(readdirSync(own(A1))).toEqual(['x.sql'])
+    })
+
+    const hostileNames = [
+      '',
+      '.',
+      '..',
+      '.hidden',
+      '../escape',
+      'a/b',
+      'a\\b',
+      'nul\u0000byte',
+      'line\nbreak',
+      'tab\tname',
+      'del\u007f',
+      'half\ud800',
+      'x'.repeat(NAME_BYTES + 1),
+      'é'.repeat(NAME_BYTES / 2 + 1),
+    ]
+    it.each(hostileNames.map((n) => [JSON.stringify(n).slice(0, 24), n]))(
+      'a name is refused: %s',
+      async (_, name) => {
+        expect(await refusal(() => save(A1, name))).toBe('400 bad_name')
+        expect(await refusal(() => as(A1, () => createFolder(name)))).toBe('400 bad_name')
+        expect(existsSync(join(data, REF_A))).toBe(false)
+      }
+    )
+
+    const inertNames = [
+      'a%2Fb',
+      '%2e%2e%2f%2e%2e',
+      'a∕b', // division slash
+      'a⁄b', // fraction slash
+      'a／b', // fullwidth solidus
+      'a⧸b', // big solidus
+      'trailing.',
+      'x'.repeat(NAME_BYTES),
+    ]
+    it.each(inertNames.map((n) => [JSON.stringify(n).slice(0, 24), n]))(
+      'a name that only looks like a path stays one file in place: %s',
+      async (_, name) => {
+        const s = await save(A1, name, 'select 1')
+        expect(readdirSync(own(A1))).toEqual([`${name}.sql`])
+        expect(readdirSync(join(data, REF_A, 'snippets')).sort()).toEqual([pdir(A1)])
+        expect((await as(A1, () => getSnippet(s.id))).name).toBe(name)
+      }
+    )
+
+    it('names differing only in case are two snippets', async () => {
+      const lower = await save(A1, 'report', 'select 1')
+      const upper = await save(A1, 'Report', 'select 2')
+      expect(lower.id).not.toBe(upper.id)
+      expect(names(await as(A1, () => listSnippets()))).toEqual(['Report', 'report'])
+      expect((await as(A1, () => getSnippet(lower.id))).content.sql).toBe('select 1')
+      expect((await as(A1, () => getSnippet(upper.id))).content.sql).toBe('select 2')
+    })
+
+    it('checkName accepts the name as given', () => {
+      expect(checkName('Untitled query 12')).toBe('Untitled query 12')
+    })
+  })
+
+  describe('the directory of a principal', () => {
+    const hostile: [string, string][] = [
+      ['https://issuer.test/../..', 'a/b'],
+      ['..', '..'],
+      ['%2F', '%2F..%2F'],
+      ['/', '/'],
+      ['x'.repeat(5000), 'y'.repeat(5000)],
+      ['', ''],
+    ]
+    it.each(hostile.map(([i, s]) => [JSON.stringify([i, s]).slice(0, 32), i, s]))(
+      'is a fixed-form digest inside the store: %s',
+      async (_, iss, sub) => {
+        const who: Who = { ref: REF_A, iss, sub }
+        await save(who, 'q')
+        const top = readdirSync(join(data, REF_A, 'snippets'))
+        expect(top).toEqual([principalDir(iss, sub)])
+        expect(top[0]).toMatch(/^[0-9a-f]{64}$/)
+        expect(readdirSync(data)).toEqual([REF_A])
+      }
+    )
+
+    it('cannot collide between two principals', () => {
+      const pairs: [string, string][] = [
+        ['ab', 'c'],
+        ['a', 'bc'],
+        ['a\u0000', 'bc'],
+        ['a', '\u0000bc'],
+        ['', 'abc'],
+        ['abc', ''],
+      ]
+      const dirs = pairs.map(([i, s]) => principalDir(i, s))
+      expect(new Set(dirs).size).toBe(pairs.length)
+    })
+
+    it('two principals that differ only in the issuer have two stores', async () => {
+      const other: Who = { ref: REF_A, iss: 'https://other.test', sub: A1.sub }
+      await save(A1, 'mine')
+      expect(names(await as(other, () => listSnippets()))).toEqual([])
+    })
+  })
+
+  describe('what is planted on the volume', () => {
+    it('a link where a snippet file is expected is not followed, not listed, and replaced by a write', async () => {
+      const outside = join(dir, 'outside.sql')
+      writeFileSync(outside, 'select outside')
+      await save(A1, 'real')
+      symlinkSync(outside, join(own(A1), 'planted.sql'))
+      expect(names(await as(A1, () => listSnippets()))).toEqual(['real'])
+      const { generateDeterministicUuid } = await import('../snippets.browser')
+      const plantedId = generateDeterministicUuid(['planted.sql'])
+      expect(await refusal(() => as(A1, () => getSnippet(plantedId)))).toBe('404 not_found')
+      await save(A1, 'planted', 'select new')
+      expect(readFileSync(outside, 'utf8')).toBe('select outside')
+      expect(lstatSync(join(own(A1), 'planted.sql')).isFile()).toBe(true)
+    })
+
+    it('a link to another project is not followed as a folder', async () => {
+      await save(B1, 'b-secret')
+      await save(A1, 'real')
+      symlinkSync(own(B1), join(own(A1), 'linked'))
+      expect(await as(A1, () => listFolders())).toEqual([])
+      expect(names(await as(A1, () => listSnippets({ searchTerm: 'b-' })))).toEqual([])
+    })
+
+    it('a directory where a snippet file is expected refuses the write with a code and no path', async () => {
+      await save(A1, 'real')
+      mkdirSync(join(own(A1), 'planted.sql'))
+      writeFileSync(join(own(A1), 'planted.sql', 'keep'), 'k')
+      let error: unknown
+      try {
+        await save(A1, 'planted')
+      } catch (e) {
+        error = e
+      }
+      expect(error).toBeInstanceOf(ProjectError)
+      expect(error).toMatchObject({ status: 503, code: 'store_unavailable' })
+      expect(
+        JSON.stringify({ code: (error as ProjectError).code, message: (error as Error).message })
+      ).not.toContain(dir)
+      expect(String((error as Error).message)).not.toContain(dir)
+      expect(readFileSync(join(own(A1), 'planted.sql', 'keep'), 'utf8')).toBe('k')
+      for (const call of vi.mocked(console.error).mock.calls)
+        expect(String(call[0])).not.toContain(dir)
+      // the directory is a folder by its name, but no snippet
+      expect(names(await as(A1, () => listSnippets()))).toEqual(['real'])
+    })
+
+    it('a link in place of a directory of the layout refuses every operation, and nothing is followed', async () => {
+      const elsewhere = join(dir, 'elsewhere')
+      mkdirSync(elsewhere)
+      const cases: [string, () => void][] = [
+        ['the project directory', () => symlinkSync(elsewhere, join(data, REF_A))],
+        [
+          'the snippets directory',
+          () => {
+            mkdirSync(join(data, REF_A))
+            symlinkSync(elsewhere, join(data, REF_A, 'snippets'))
+          },
+        ],
+        [
+          "the member's directory",
+          () => {
+            mkdirSync(join(data, REF_A, 'snippets'), { recursive: true })
+            symlinkSync(elsewhere, own(A1))
+          },
+        ],
+        [
+          'the shared directory',
+          () => {
+            mkdirSync(join(data, REF_A, 'snippets'), { recursive: true })
