@@ -0,0 +1,817 @@
+// SPDX-License-Identifier: Apache-2.0
+// The SQL snippets of the request's project, on Studio's data volume. A member's own snippets
+// are private to that member; a snippet its author shares is readable by every member of the
+// project and writable by its author alone. Nothing is taken from the request to find a file:
+// the project and the member are those of the request's context.
+//
+//   <SUPAPACE_DASH_DATA>/<ref>/snippets/<P>/<name>.sql            a member's own, at the root
+//   <SUPAPACE_DASH_DATA>/<ref>/snippets/<P>/<folder>/<name>.sql   in one of its folders
+//   <SUPAPACE_DASH_DATA>/<ref>/snippets/shared/<P>/<name>.sql     shared by its author
+//
+// <P> is the hex SHA-256 of the principal's issuer and subject, each preceded by its length.
+// Directories are 0700, files 0600, written by rename. No path is followed through a link: a
+// directory of the layout that is not a directory refuses the request, and a file that is not
+// a regular file is not a snippet. Bounds: per project, all members together, at most
+// snippet_entries entries (snippets and folders) and snippet_bytes bytes of SQL; a write is
+// checked and made under the project's lock, so no bound is passed, while another project's
+// writes go on.
+//
+// What one request may hold: a snippet, and the SQL of one listing, are at most result_bytes
+// (row e, as for postgres-meta's answers); a listing past it ends with a cursor. Reads of SQL
+// take one of READ_SLOTS slots of the process, at most READ_SLOTS_PROJECT of them for one project;
+// a read waits for one at most slot_wait_ms, behind a bounded number of others, or is 429 busy.
+
+import { createHash, randomBytes } from 'node:crypto'
+import { constants, type Dirent } from 'node:fs'
+import { lstat, mkdir, open, readdir, rename, rm, unlink, writeFile } from 'node:fs/promises'
+import { isAbsolute, join } from 'node:path'
+import z from 'zod'
+
+import { generateDeterministicUuid } from '../snippets.browser'
+import { limits } from './limits'
+import { getProjectContext, ProjectError } from './project-context'
+
+const REF = /^[a-z0-9]{20}$/
+const PRINCIPAL = /^[0-9a-f]{64}$/
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/
+const TMP = /^\.[0-9a-f]{16}\.tmp$/
+const SUFFIX = '.sql'
+/** A name's UTF-8 bytes: with the suffix and a temporary name it stays below a file name's 255. */
+export const NAME_BYTES = 200
+const OPEN_READ = constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK
+
+const fail = (status: number, code: string, message: string) =>
+  new ProjectError(status, code, message)
+const badId = () => fail(400, 'bad_id', 'Not a snippet or folder id')
+const notFound = () => fail(404, 'not_found', 'Not found')
+
+/** The directory name of a principal: no two (issuer, subject) pairs share one. */
+export function principalDir(iss: string, sub: string): string {
+  const h = createHash('sha256')
+  for (const part of [iss, sub]) {
+    const bytes = Buffer.from(part, 'utf8')
+    const length = Buffer.alloc(4)
+    length.writeUInt32BE(bytes.length)
+    h.update(length).update(bytes)
+  }
+  return h.digest('hex')
+}
+
+/**
+ * The id of a shared snippet: from its author's directory and its name, by SHA-256. A member's
+ * own snippet keeps the id the editor derives from folder and name; this one cannot equal it.
+ */
+export function sharedId(author: string, name: string): string {
+  const b = createHash('sha256').update(`shared\0${author}\0${name}`).digest()
+  b[6] = (b[6] & 0x0f) | 0x40
+  b[8] = (b[8] & 0x3f) | 0x80
+  const x = b.subarray(0, 16).toString('hex')
+  return `${x.slice(0, 8)}-${x.slice(8, 12)}-${x.slice(12, 16)}-${x.slice(16, 20)}-${x.slice(20)}`
+}
+
+const ownId = (folderId: string | null, name: string) =>
+  generateDeterministicUuid([folderId, `${name}${SUFFIX}`])
+const folderIdOf = (name: string) => generateDeterministicUuid([name])
+
+/**
+ * A snippet's or folder's name, or a refusal: not empty, at most NAME_BYTES bytes, no leading
+ * dot, no separator, no control character.
+ */
+export function checkName(name: unknown): string {
+  if (
+    typeof name !== 'string' ||
+    name === '' ||
+    Buffer.byteLength(name, 'utf8') > NAME_BYTES ||
+    name.startsWith('.') ||
+    /[/\\\u0000-\u001f\u007f]/.test(name) ||
+    Buffer.from(name, 'utf8').toString('utf8') !== name // half a surrogate pair
+  ) {
+    throw fail(400, 'bad_name', 'Not a valid name')
+  }
+  return name
+}
+
+export function checkId(id: unknown): string {
+  if (typeof id !== 'string' || !UUID.test(id)) throw badId()
+  return id
+}
+
+// --- where -------------------------------------------------------------------------------
+
+type Store = { ref: string; me: string; readOnly: boolean; root: string }
+
+/** The store of the request's project and member; read before anything waits. */
+function store(): Store {
+  const ctx = getProjectContext()
+  const data = process.env.SUPAPACE_DASH_DATA
+  if (!REF.test(ctx.ref) || !data || !isAbsolute(data)) {
+    throw fail(503, 'store_unavailable', 'The snippet store is not available')
+  }
+  return {
+    ref: ctx.ref,
+    me: principalDir(ctx.principal.iss, ctx.principal.sub),
+    readOnly: ctx.role === 'read_only',
+    root: join(data, ctx.ref, 'snippets'),
+  }
+}
+
+function writer(): Store {
+  const s = store()
+  if (s.readOnly) throw fail(403, 'read_only', 'A read-only member saves no snippet')
+  return s
+}
+
+const ownDir = (s: Store) => join(s.root, s.me)
+const sharedDir = (s: Store) => join(s.root, 'shared')
+
+/**
+ * Whether a directory of the layout exists, creating it when asked. A link or anything else
+ * that is not a directory is refused: no path leaves the project's directory through one.
+ */
+async function realDir(path: string, create: boolean): Promise<boolean> {
+  if (create) {
+    await mkdir(path, { mode: 0o700 }).catch((e) => {
+      if (e?.code !== 'EEXIST') throw e
+    })
+  }
+  const st = await lstat(path).catch((e) => {
+    if (!create && e?.code === 'ENOENT') return undefined
+    throw e
+  })
+  if (st && !st.isDirectory())
+    throw fail(503, 'store_unavailable', 'The snippet store is not available')
+  return st !== undefined
+}
+
+/** Each directory from the project's down to `dirs`' last, in order; false if one is missing. */
+async function chain(s: Store, dirs: string[], create: boolean): Promise<boolean> {
+  for (const d of [join(s.root, '..'), s.root, ...dirs]) {
+    if (!(await realDir(d, create))) return false
+  }
+  return true
+}
+
+const list = (dir: string): Promise<Dirent[]> =>
+  readdir(dir, { withFileTypes: true }).catch((e) => {
+    if (e?.code === 'ENOENT') return []
+    throw e
+  })
+
+function validName(name: string): boolean {
+  try {
+    return checkName(name) === name
+  } catch {
+    return false
+  }
+}
+const snippetName = (file: string) =>
+  file.endsWith(SUFFIX) && validName(file.slice(0, -SUFFIX.length))
+    ? file.slice(0, -SUFFIX.length)
+    : undefined
+
+// --- what is there -----------------------------------------------------------------------
+
+type Item = {
+  id: string
+  name: string
+  folderId: string | null
+  path: string
+  author: string
+  shared: boolean
+  created: Date
+  size: number
+}
+type FolderItem = { id: string; name: string; path: string }
+
+async function items(
+  dir: string,
+  author: string,
+  shared: boolean,
+  folderId: string | null
+): Promise<Item[]> {
+  const out: Item[] = []
+  for (const e of await list(dir)) {
+    const name = e.isFile() ? snippetName(e.name) : undefined
+    if (name === undefined) continue
+    const path = join(dir, e.name)
+    const st = await lstat(path).catch(() => undefined)
+    if (!st?.isFile() || st.size > limits().result_bytes) continue
+    out.push({
+      id: shared ? sharedId(author, name) : ownId(folderId, name),
+      name,
+      folderId,
+      path,
+      author,
+      shared,
+      created: st.birthtime,
+      size: st.size,
+    })
+  }
+  return out
+}
+
+/** The member's own folders and snippets; nothing of another member's directory is read. */
+async function scanOwn(s: Store): Promise<{ folders: FolderItem[]; files: Item[] }> {
+  if (!(await chain(s, [ownDir(s)], false))) return { folders: [], files: [] }
+  const folders: FolderItem[] = []
+  for (const e of await list(ownDir(s))) {
+    if (e.isDirectory() && validName(e.name)) {
+      folders.push({ id: folderIdOf(e.name), name: e.name, path: join(ownDir(s), e.name) })
+    }
+  }
+  const files = await items(ownDir(s), s.me, false, null)
+  for (const f of folders) files.push(...(await items(f.path, s.me, false, f.id)))
+  return { folders, files }
+}
+
+/** Every shared snippet of the project, of every author. */
+async function scanShared(s: Store): Promise<Item[]> {
+  if (!(await chain(s, [sharedDir(s)], false))) return []
+  const out: Item[] = []
+  for (const e of await list(sharedDir(s))) {
+    if (e.isDirectory() && PRINCIPAL.test(e.name)) {
+      out.push(...(await items(join(sharedDir(s), e.name), e.name, true, null)))
+    }
+  }
+  return out
+}
+
+/** A visible snippet by id: the member's own first, then the shared ones. */
+async function find(s: Store, id: string): Promise<Item | undefined> {
+  return (
+    (await scanOwn(s)).files.find((f) => f.id === id) ??
+    (await scanShared(s)).find((f) => f.id === id)
+  )
+}
+
+/** A snippet file's text: a regular file, opened without following a link, within the bound. */
+async function readSql(path: string): Promise<string> {
+  const fh = await open(path, OPEN_READ)
+  try {
+    const st = await fh.stat()
+    if (!st.isFile() || st.size > limits().result_bytes) throw notFound()
+    return await fh.readFile('utf8')
+  } finally {
+    await fh.close()
+  }
+}
+
+/**
+ * What the project's store holds, all members together: every name below a member's or an
+ * author's directory is an entry, every regular file's size counts. Called under the lock, so
+ * a temporary file found is one a stopped process left: it is removed. Stops counting past the
+ * bound.
+ */
+async function usage(s: Store): Promise<{ entries: number; bytes: number }> {
+  let entries = 0
+  let bytes = 0
+  const max = limits().snippet_entries
+  const count = async (dir: string, depth: number) => {
+    for (const e of await list(dir)) {
+      if (entries > max) return
+      const path = join(dir, e.name)
+      if (TMP.test(e.name)) {
+        await rm(path, { force: true })
+        continue
+      }
+      entries++
+      if (e.isFile()) bytes += (await lstat(path)).size
+      else if (e.isDirectory() && depth > 0) await count(path, depth - 1)
+    }
+  }
+  for (const e of await list(s.root)) {
+    if (!e.isDirectory()) continue
+    if (e.name === 'shared') {
+      for (const a of await list(sharedDir(s))) {
+        if (a.isDirectory()) await count(join(sharedDir(s), a.name), 0)
+      }
+    } else {
+      await count(join(s.root, e.name), 1)
+    }
+  }
+  return { entries, bytes }
+}
+
+const full = () => fail(507, 'store_full', "The project's snippet store is full")
+
+// --- reads of SQL: a bounded number at once ----------------------------------------------
+
+// ponytail: fixed figures, fairness by the per-project cap alone; make them rows of the bounds
+// table if a node needs other values.
+export const READ_SLOTS = 4
+export const READ_SLOTS_PROJECT = 2
+export const READ_WAITING = 32
+export const READ_WAITING_PROJECT = 8
+
+let reads = 0
+const readsOf = new Map<string, { held: number; waiting: number }>()
+const waiters: { ref: string; grant: () => void }[] = []
+const busy = () => fail(429, 'busy', 'The server is busy; try again')
+
+const tally = (ref: string) => {
+  let t = readsOf.get(ref)
+  if (!t) readsOf.set(ref, (t = { held: 0, waiting: 0 }))
+  return t
+}
+const forget = (ref: string) => {
+  const t = readsOf.get(ref)
+  if (t && t.held === 0 && t.waiting === 0) readsOf.delete(ref)
+}
+const free = (ref: string) => reads < READ_SLOTS && tally(ref).held < READ_SLOTS_PROJECT
+const take = (ref: string) => {
+  reads++
+  tally(ref).held++
+}
+
+/** Slots held and reads waiting, for the process or for one project. */
+export function readsHeld(ref?: string): { held: number; waiting: number } {
+  if (ref === undefined) return { held: reads, waiting: waiters.length }
+  const t = readsOf.get(ref)
+  return { held: t?.held ?? 0, waiting: t?.waiting ?? 0 }
+}
+
+/**
+ * A slot of the process for an answer that carries SQL: at once when one is free, else after
+ * the reads ahead of it, for at most slot_wait_ms; with too many waiting, or past the wait,
+ * 429 busy. Resolves to the slot's release, which frees it once however often it is called.
+ */
+export async function acquireRead(ref: string): Promise<() => void> {
+  if (free(ref)) {
+    take(ref)
+  } else {
+    const t = tally(ref)
+    if (waiters.length >= READ_WAITING || t.waiting >= READ_WAITING_PROJECT) {
+      forget(ref)
+      throw busy()
+    }
+    await new Promise<void>((granted, refused) => {
+      const w = {
+        ref,
+        grant: () => {
+          clearTimeout(timer)
+          granted()
+        },
+      }
+      const timer = setTimeout(() => {
+        waiters.splice(waiters.indexOf(w), 1)
+        t.waiting--
+        forget(ref)
+        refused(busy())
+      }, limits().slot_wait_ms)
+      waiters.push(w)
+      t.waiting++
+    })
+  }
+  let released = false
+  return () => {
+    if (released) return
+    released = true
+    reads--
+    tally(ref).held--
+    for (let i = 0; i < waiters.length; ) {
+      const w = waiters[i]
+      if (!free(w.ref)) {
+        i++
+        continue
+      }
+      waiters.splice(i, 1)
+      tally(w.ref).waiting--
+      take(w.ref)
+      w.grant()
+    }
+    forget(ref)
+  }
+}
+
+const CHUNK = 64 * 1024
+
+/**
+ * The answer of a route that carries SQL, made and sent inside one slot: the slot is taken
+ * before `fn` reads, and held until the body has been handed over to the server — or cut: the
+ * client gone (the stream cancelled), an error, or handover_ms (row 1s) after the answer was
+ * made. So at most READ_SLOTS answers with SQL exist in the process at once, however slowly
+ * their clients read.
+ */
+export async function sqlAnswer(fn: () => Promise<unknown>): Promise<Response> {
+  const s = store()
+  const release = await acquireRead(s.ref)
+  let body: Buffer | undefined
+  try {
+    body = Buffer.from(JSON.stringify(await fn()), 'utf8')
+  } catch (error) {
+    release()
+    throw error
+  }
+  const size = body.length
+  let at = 0
+  let timer: NodeJS.Timeout | undefined
+  const done = () => {
+    clearTimeout(timer)
+    body = undefined
+    release()
+  }
+  const stream = new ReadableStream<Uint8Array>({
+    start(c) {
+      timer = setTimeout(() => {
+        c.error(new Error('the answer was not taken in time'))
+        done()
+      }, limits().handover_ms)
+    },
+    // the server asks for the next chunk when it has taken the last: the slot is freed when
+    // it asks after the answer's end
+    pull(c) {
+      if (!body) return
+      if (at >= body.length) {
+        c.close()
+        done()
+        return
+      }
+      // a copy: a view would keep the whole answer alive until the server lets go of it
+      c.enqueue(new Uint8Array(body.subarray(at, (at += CHUNK))))
+    },
+    cancel() {
+      done()
+    },
+  })
+  return new Response(stream, {
+    status: 200,
+    headers: { 'Content-Type': 'application/json', 'Content-Length': String(size) },
+  })
+}
+
+// --- one writer at a time per project ----------------------------------------------------
+
+// ponytail: an in-process lock; one Studio process writes the volume. A second writer would
+// need a lock on the volume itself.
+const locks = new Map<string, Promise<void>>()
+
+async function locked<T>(ref: string, fn: () => Promise<T>): Promise<T> {
+  const before = locks.get(ref) ?? Promise.resolve()
+  let release!: () => void
+  const mine = before.then(() => new Promise<void>((done) => (release = done)))
+  locks.set(ref, mine)
+  await before
+  try {
+    return await fn()
+  } finally {
+    release()
+    if (locks.get(ref) === mine) locks.delete(ref)
+  }
+}
+
+/** Runs one operation of the store; a failure of the file system is one answer, with no path. */
+async function guarded<T>(s: Store, fn: () => Promise<T>): Promise<T> {
+  try {
+    return await fn()
+  } catch (error) {
+    if (error instanceof ProjectError) throw error
+    console.error(
+      `supapace: the snippet store of ${s.ref} failed (${(error as NodeJS.ErrnoException)?.code ?? 'error'})`
+    )
+    throw fail(503, 'store_unavailable', 'The snippet store is not available')
+  }
+}
+
+/** Writes a file by rename: a reader sees the old text or the new, never part of one. */
+async function writeAtomic(dir: string, target: string, text: string) {
+  const tmp = join(dir, `.${randomBytes(8).toString('hex')}.tmp`)
+  try {
+    await writeFile(tmp, text, { mode: 0o600, flag: 'wx' })
+    await rename(tmp, target)
+  } catch (error) {
+    await rm(tmp, { force: true })
+    throw error
+  }
+}
+
+// --- the answers -------------------------------------------------------------------------
+
+export type SnippetMetadata = {
+  id: string
+  inserted_at: string
+  updated_at: string
+  type: 'sql'
+  name: string
+  description: string
+  favorite: boolean
+  visibility: 'user' | 'project'
+  project_id: number
+  folder_id: string | null
+  /** 1, the profile's id, when the member asking is its author; 0 otherwise */
+  owner_id: number
+  owner: { id: number; username: string }
+  updated_by: { id: number; username: string }
+}
+export type Snippet = SnippetMetadata & {
+  content: { sql: string; content_id: string; schema_version: '1.0' }
+}
+export type Folder = {
+  id: string
+  name: string
+  owner_id: number
+  parent_id: null
+  project_id: number
+}
+
+function metadata(s: Store, item: Item): SnippetMetadata {
+  const owner = item.author === s.me ? 1 : 0
+  const who = { id: owner, username: owner ? 'johndoe' : '' }
+  return {
+    id: item.id,
+    inserted_at: item.created.toISOString(),
+    updated_at: item.created.toISOString(),
+    type: 'sql',
+    name: item.name,
+    description: '',
+    favorite: false,
+    visibility: item.shared ? 'project' : 'user',
+    project_id: 1,
+    folder_id: item.folderId,
+    owner_id: owner,
+    owner: who,
+    updated_by: who,
+  }
+}
+
+const withContent = (s: Store, item: Item, sql: string): Snippet => ({
+  ...metadata(s, item),
+  content: { sql, content_id: item.id, schema_version: '1.0' },
+})
+
+const folder = (f: FolderItem): Folder => ({
+  id: f.id,
+  name: f.name,
+  owner_id: 1,
+  parent_id: null,
+  project_id: 1,
+})
+
+export type ListParams = {
+  visibility?: 'user' | 'project'
+  searchTerm?: string
+  folderId?: string | null
+  limit?: number
+  cursor?: string
+  sort?: 'name' | 'inserted_at'
+  sortOrder?: 'asc' | 'desc'
+  includeContent?: boolean
+}
+
+// A page's cursor: the sort key and the id of its last snippet, so the next page goes on after
+// that place whether or not the snippet is still there. It names nothing outside the listing.
+type Mark = [number | string, string]
+const order = (a: Mark, b: Mark) =>
+  a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : a[1] < b[1] ? -1 : a[1] > b[1] ? 1 : 0
+const writeCursor = (m: Mark) => Buffer.from(JSON.stringify(m), 'utf8').toString('base64url')
+function readCursor(text: string, keyType: 'number' | 'string'): Mark {
+  try {
+    const m: unknown =
+      text.length <= 1024 ? JSON.parse(Buffer.from(text, 'base64url').toString('utf8')) : null
+    if (Array.isArray(m) && m.length === 2 && typeof m[0] === keyType && typeof m[1] === 'string') {
+      return m as Mark
+    }
+  } catch {
+    // refused below
+  }
+  throw fail(400, 'bad_request', 'Not a cursor of this listing')
+}
+
+/**
+ * A page of snippets: the shared ones for `project`, else the member's own — in one folder, at
+ * the root, or in all when searching by name; ordered by time or name, then id. With the SQL, at
+ * most result_bytes of it; the rest after the cursor.
+ */
+export async function listSnippets(p: ListParams = {}): Promise<{
+  cursor: string | undefined
+  snippets: (Snippet | SnippetMetadata)[]
+}> {
+  const s = store()
+  const limit = p.limit ?? 100
+  if (!Number.isSafeInteger(limit) || limit <= 0 || limit > 1000) {
+    throw fail(400, 'bad_request', 'The limit is out of range')
+  }
+  const folderId = p.folderId == null ? null : checkId(p.folderId)
+  const byTime = (p.sort ?? 'inserted_at') === 'inserted_at'
+  const after = p.cursor ? readCursor(p.cursor, byTime ? 'number' : 'string') : undefined
+  const desc = (p.sortOrder ?? 'desc') === 'desc'
+  return guarded(s, async () => {
+    let files = p.visibility === 'project' ? await scanShared(s) : (await scanOwn(s)).files
+    const term = p.searchTerm?.trim().toLowerCase() ?? ''
+    files = term
+      ? files.filter((f) => f.name.toLowerCase().includes(term))
+      : files.filter((f) => f.folderId === folderId)
+    const mark = (f: Item): Mark => [byTime ? f.created.getTime() : f.name.toLowerCase(), f.id]
+    files.sort((a, b) => order(mark(a), mark(b)))
+    if (desc) files.reverse()
+    if (after) files = files.filter((f) => (desc ? -1 : 1) * order(mark(f), after) > 0)
+    let more = files.length > limit
+    files = files.slice(0, limit)
+    const page: Item[] = []
+    const snippets: (Snippet | SnippetMetadata)[] = []
+    let bytes = 0
+    for (const f of files) {
+      if (p.includeContent === false) {
+        snippets.push(metadata(s, f))
+        page.push(f)
+        continue
+      }
+      // by its size when listed, then by what was read: the file can change in between
+      const over = (n: number) => page.length > 0 && bytes + n > limits().result_bytes
+      const sql = over(f.size) ? undefined : await readSql(f.path)
+      if (sql === undefined || over(Buffer.byteLength(sql, 'utf8'))) {
+        more = true
+        break
+      }
+      bytes += Buffer.byteLength(sql, 'utf8')
+      snippets.push(withContent(s, f, sql))
+      page.push(f)
+    }
+    const last = page[page.length - 1]
+    return { cursor: more && last ? writeCursor(mark(last)) : undefined, snippets }
+  })
+}
+
+/** One visible snippet with its text: the member's own or a shared one. */
+export async function getSnippet(id: unknown): Promise<Snippet> {
+  const s = store()
+  const want = checkId(id)
+  return guarded(s, async () => {
+    const item = await find(s, want)
+    if (!item) throw notFound()
+    return withContent(s, item, await readSql(item.path))
+  })
+}
+
+/** The counts the editor's sections show: the member's own, and the project's shared. */
+export async function countSnippets(name?: string) {
+  const s = store()
+  return guarded(s, async () => {
+    const own = (await scanOwn(s)).files
+    if (name) {
+      const term = name.trim().toLowerCase()
+      return { count: own.filter((f) => f.name.toLowerCase().includes(term)).length }
+    }
+    return { shared: (await scanShared(s)).length, favorites: 0, private: own.length }
+  })
+}
+
+const PutBody = z.object({
+  id: z.string(),
+  name: z.string().optional(),
+  content: z.object({ sql: z.string().optional() }).partial().optional(),
+  folder_id: z.string().nullable().optional(),
+  visibility: z.enum(['user', 'project']).optional(),
+})
+
+/**
+ * Creates or changes a snippet by id. `visibility` decides where it is kept: `user` in the
+ * member's own directory (in a folder of its own, or at the root), `project` in its author's
+ * shared directory — a change of visibility moves the file, and the id changes with it. A
+ * shared snippet is changed by its author only. A name already used at the target is
+ * replaced, as upstream's store does.
+ */
+export async function putSnippet(body: unknown): Promise<Snippet> {
+  const s = writer()
+  const parsed = PutBody.safeParse(body)
+  if (!parsed.success) throw fail(400, 'bad_request', 'Not a snippet')
+  const b = parsed.data
+  const id = checkId(b.id)
+  if (b.name !== undefined) checkName(b.name)
+  if (b.folder_id != null) checkId(b.folder_id)
+  if (
+    b.content?.sql !== undefined &&
+    Buffer.byteLength(b.content.sql, 'utf8') > limits().result_bytes
+  ) {
+    throw fail(413, 'too_large', 'The snippet is too large')
+  }
+
+  return guarded(s, () =>
+    locked(s.ref, async () => {
+      const own = await scanOwn(s)
+      const found =
+        own.files.find((f) => f.id === id) ?? (await scanShared(s)).find((f) => f.id === id)
+      if (found && found.author !== s.me) {
+        throw fail(403, 'not_author', 'A shared snippet is changed by its author only')
+      }
+      const name = checkName(b.name ?? found?.name)
+      const visibility = b.visibility ?? (found?.shared ? 'project' : 'user')
+      const folderId = b.folder_id !== undefined ? b.folder_id : (found?.folderId ?? null)
+      let dirs: string[]
+      if (visibility === 'project') {
+        if (folderId) throw fail(400, 'bad_request', 'A shared snippet is in no folder')
+        dirs = [sharedDir(s), join(sharedDir(s), s.me)]
+      } else {
+        const f = folderId ? own.folders.find((x) => x.id === folderId) : undefined
+        if (folderId && !f) throw notFound()
+        dirs = [ownDir(s), ...(f ? [f.path] : [])]
+      }
+      const dir = dirs[dirs.length - 1]
+      const target = join(dir, `${name}${SUFFIX}`)
+      const newId =
+        visibility === 'project'
+          ? sharedId(s.me, name)
+          : ownId(dirs.length > 1 ? folderId : null, name)
+      // the editor's own ids are a 32-bit hash: another snippet with the new id is not this one
+      if (own.files.some((f) => f.id === newId && f.path !== target)) {
+        throw fail(409, 'exists', 'Another snippet has this id')
+      }
+      const sql = b.content?.sql ?? (found ? await readSql(found.path) : '')
+
+      // the bounds, with what this write replaces taken out
+      const used = await usage(s)
+      const there = target === found?.path ? undefined : await lstat(target).catch(() => undefined)
+      // a create replaces a snippet of its name, as upstream's store; a rename, move or share does not
+      if (found && there) throw fail(409, 'exists', 'A snippet of this name is there')
+      const entries = used.entries + 1 - (found ? 1 : 0) - (there ? 1 : 0)
+      const bytes =
+        used.bytes +
+        Buffer.byteLength(sql, 'utf8') -
+        (found?.size ?? 0) -
+        (there?.isFile() ? there.size : 0)
+      if (entries > limits().snippet_entries || bytes > limits().snippet_bytes) throw full()
+
+      await chain(s, dirs, true)
+      await writeAtomic(dir, target, sql)
+      if (found && found.path !== target) await unlink(found.path)
+
+      const item: Item = {
+        id: newId,
+        name,
+        folderId: visibility === 'project' ? null : (folderId ?? null),
+        path: target,
+        author: s.me,
+        shared: visibility === 'project',
+        created: (await lstat(target)).birthtime,
+        size: Buffer.byteLength(sql, 'utf8'),
+      }
+      return withContent(s, item, sql)
+    })
+  )
+}
+
+/** Deletes snippets by id: the member's own, or shared ones the member wrote. */
+export async function deleteSnippets(ids: unknown[]): Promise<void> {
+  const s = writer()
+  const want = ids.map(checkId)
+  if (want.length === 0) throw badId()
+  await guarded(s, () =>
+    locked(s.ref, async () => {
+      const visible = [...(await scanOwn(s)).files, ...(await scanShared(s))]
+      const gone: Item[] = []
+      for (const id of want) {
+        const item = visible.find((f) => f.id === id)
+        if (!item) throw notFound()
+        if (item.author !== s.me) {
+          throw fail(403, 'not_author', 'A shared snippet is deleted by its author only')
+        }
+        gone.push(item)
+      }
+      for (const item of gone) await rm(item.path, { force: true })
+    })
+  )
+}
+
+/** The member's own folders. */
+export async function listFolders(): Promise<Folder[]> {
+  const s = store()
+  return guarded(s, async () => (await scanOwn(s)).folders.map(folder))
+}
+
+export async function createFolder(name: unknown): Promise<Folder> {
+  const s = writer()
+  const want = checkName(name)
+  return guarded(s, () =>
+    locked(s.ref, async () => {
+      const own = await scanOwn(s)
+      if (own.folders.some((f) => f.name === want)) {
+        throw fail(409, 'exists', 'A folder of this name exists')
+      }
+      if ((await usage(s)).entries + 1 > limits().snippet_entries) throw full()
+      const path = join(ownDir(s), want)
+      if (await lstat(path).catch(() => undefined)) {
+        throw fail(409, 'exists', 'A folder or snippet of this name exists')
+      }
+      await chain(s, [ownDir(s)], true)
+      await mkdir(path, { mode: 0o700 })
+      return folder({ id: folderIdOf(want), name: want, path })
+    })
+  )
+}
+
+/** Deletes the member's own folders, with the snippets in them. */
+export async function deleteFolders(ids: unknown[]): Promise<void> {
+  const s = writer()
+  const want = ids.map(checkId)
+  if (want.length === 0) throw badId()
+  await guarded(s, () =>
+    locked(s.ref, async () => {
+      const { folders } = await scanOwn(s)
+      const gone = want.map((id) => {
+        const f = folders.find((x) => x.id === id)
+        if (!f) throw notFound()
+        return f
+      })
+      for (const f of gone) await rm(f.path, { recursive: true, force: true })
+    })
+  )
+}
