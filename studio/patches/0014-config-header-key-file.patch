+let headerKey: string | undefined
+
+/**
+ * postgres-meta's key for the connection-string header: the node's file
+ * <SUPAPACE_DASH_KEYS>/crypto.key, 48 bytes as 64 base64url characters and at most one line
+ * end, used exactly as the file holds it — line end included, as postgres-meta is handed it.
+ * Read at the first use (or by the start check); a missing or malformed file stops the process.
+ * There is no other key.
+ */
+export function checkHeaderKey(): string {
+  return (headerKey ??= orStop(() => {
+    const dir = process.env.SUPAPACE_DASH_KEYS
+    if (!dir || !isAbsolute(dir)) throw new Error('SUPAPACE_DASH_KEYS is not set to an absolute path')
+    let text: string
+    try {
+      text = readFileSync(join(dir, 'crypto.key'), 'latin1')
+    } catch {
+      throw new Error('the header key file cannot be read')
+    }
+    if (!/^[A-Za-z0-9_-]{64}\n?$/.test(text)) {
+      throw new Error('the header key file does not hold 48 bytes in base64url')
+    }
+    return text
+  }))
+}
+
 export function encryptString(stringToEncrypt: string): string {
-  return crypto.AES.encrypt(stringToEncrypt, ENCRYPTION_KEY).toString()
+  return crypto.AES.encrypt(stringToEncrypt, checkHeaderKey()).toString()
 }
 
