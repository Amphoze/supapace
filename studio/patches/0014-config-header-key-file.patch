+// SPDX-License-Identifier: Apache-2.0
+// postgres-meta's key for the connection-string header is the node's key file, used as the file
+// holds it; without it, or with one of another form, the server does not start. There is no
+// other key: not a setting of the process, not a built-in one.
+import crypto from 'crypto-js'
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join, resolve as resolvePath } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+const VECTOR_DIR = resolvePath(import.meta.dirname, '../../../../../vectors')
+const VECTORS = JSON.parse(readFileSync(join(VECTOR_DIR, 'tokens.json'), 'utf8'))
+const LIMITS = readFileSync(join(VECTOR_DIR, 'limits.json'), 'utf8').trim()
+const KEY = Buffer.alloc(48, 9).toString('base64url') // 64 characters, as the agent writes it
+
+describe('the header key', () => {
+  let dir: string
+  let exit: ReturnType<typeof vi.spyOn>
+  let said: ReturnType<typeof vi.spyOn>
+
+  beforeEach(() => {
+    vi.resetModules()
+    dir = mkdtempSync(join(tmpdir(), 'header-key-'))
+    writeFileSync(join(dir, 'assert.pub'), VECTORS.public_file + '\n')
+    writeFileSync(join(dir, 'cache.key'), Buffer.alloc(32, 7).toString('base64url') + '\n')
+    writeFileSync(join(dir, 'crypto.key'), KEY + '\n')
+    vi.stubEnv('SUPAPACE_LIMITS', LIMITS)
+    vi.stubEnv('SUPAPACE_DASH_SOCKET', join(dir, 'dash.sock'))
+    vi.stubEnv('SUPAPACE_DASH_DATA', join(dir, 'data'))
+    vi.stubEnv('SUPAPACE_DASH_KEYS', dir)
+    vi.stubEnv('SUPAPACE_PGCAP', '10.212.0.6:20000:21023')
+    vi.stubEnv('SUPAPACE_NODE_ID', VECTORS.node)
+    delete process.env.TSS_PRERENDERING
+    exit = vi.spyOn(process, 'exit').mockImplementation(() => {
+      throw new Error('the process exited')
+    })
+    said = vi.spyOn(console, 'error').mockImplementation(() => {})
+  })
+  afterEach(() => {
+    vi.unstubAllEnvs()
+    vi.restoreAllMocks()
+    rmSync(dir, { recursive: true, force: true })
+  })
+
+  const start = async () => (await import('./request-guard')).checkStart()
+
+  it('the server starts with the key file', async () => {
+    await start()
+    expect(exit).not.toHaveBeenCalled()
+  })
+
+  it('the server refuses to start without the key file, and takes no other key', async () => {
+    rmSync(join(dir, 'crypto.key'))
+    vi.stubEnv('PG_META_CRYPTO_KEY', KEY)
+    await expect(start()).rejects.toThrow('the process exited')
+    expect(exit).toHaveBeenCalledWith(1)
+    expect(said).toHaveBeenCalledTimes(1)
+    expect(String(said.mock.calls[0][0])).toMatch(/^supapace: the header key file .*; the server stops$/)
+  })
+
+  it.each([
+    ['empty', ''],
+    ['a character short', KEY.slice(1)],
+    ['a character long', KEY + 'A'],
+    ['padded', KEY.slice(4) + 'AA=='],
+    ['a character outside base64url', KEY.slice(1) + '+'],
+    ['two line ends', KEY + '\n\n'],
+    ['a carriage return', KEY + '\r\n'],
+    ['a space', KEY + ' '],
+    ['a directory', null],
+  ])('the server refuses to start with a key file %s, and never names its content', async (_, text) => {
+    rmSync(join(dir, 'crypto.key'))
+    if (text === null) mkdirSync(join(dir, 'crypto.key'))
+    else writeFileSync(join(dir, 'crypto.key'), text)
+    await expect(start()).rejects.toThrow('the process exited')
+    expect(exit).toHaveBeenCalledWith(1)
+    expect(String(said.mock.calls[0][0])).not.toContain(KEY.slice(8, 40))
+  })
+
+  it.each([
+    ['with its line end', KEY + '\n'],
+    ['without one', KEY],
+  ])('the header is encrypted with the file’s bytes exactly as they are, %s', async (_, text) => {
+    writeFileSync(join(dir, 'crypto.key'), text)
+    const { encryptString } = await import('./util')
+    const sealed = encryptString('postgresql://x')
+    expect(crypto.AES.decrypt(sealed, text).toString(crypto.enc.Utf8)).toBe('postgresql://x')
+    // another key does not open it: not the trimmed text, not upstream's built-in one
+    for (const other of [text === KEY ? KEY + '\n' : KEY, 'SAMPLE_KEY']) {
+      let opened = ''
+      try {
+        opened = crypto.AES.decrypt(sealed, other).toString(crypto.enc.Utf8)
+      } catch {}
+      expect(opened).not.toBe('postgresql://x')
+    }
+  })
+
+  it('the first use with a key directory that is not absolute stops', async () => {
+    vi.stubEnv('SUPAPACE_DASH_KEYS', 'keys')
+    const { encryptString } = await import('./util')
+    expect(() => encryptString('x')).toThrow('the process exited')
+    expect(String(said.mock.calls[0][0])).toContain('SUPAPACE_DASH_KEYS')
+  })
+
+  it('nothing is read when the module loads; the first use without the file stops', async () => {
+    rmSync(join(dir, 'crypto.key'))
+    const { encryptString } = await import('./util')
+    expect(exit).not.toHaveBeenCalled()
+    expect(() => encryptString('x')).toThrow('the process exited')
+    expect(exit).toHaveBeenCalledWith(1)
+  })
+})
