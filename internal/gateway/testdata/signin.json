  "callback": [
    {"name": "the two fields", "form": {"id_token": ["idt.x"], "state": ["v1.{A}.AAAAAAAAAAA.0.Lw"]}, "status": 200, "target": "{A}"},
    {"name": "target the sign-in host", "form": {"id_token": ["x"], "state": ["v1._.AAAAAAAAAAA.0.Lw"]}, "status": 200, "target": "_"},
    {"name": "a further field is ignored", "form": {"id_token": ["a"], "state": ["v1.{A}.AAAAAAAAAAA.1.Lw"], "session_state": ["x"]}, "status": 200, "target": "{A}"},
    {"name": "a token of 8 KiB", "form": {"id_token": ["{a*8192}"], "state": ["v1.{B}.AAAAAAAAAAA.0.Lw"]}, "status": 200, "target": "{B}"},
    {"name": "a state of 1,404 characters", "form": {"id_token": ["x"], "state": ["v1.{A}.AAAAAAAAAAA.0.{A*1366}"]}, "status": 200, "target": "{A}"},
    {"name": "a state of 1,405 characters", "form": {"id_token": ["x"], "state": ["v1.{A}.AAAAAAAAAAA.0.{A*1367}"]}, "status": 400},
    {"name": "target not a ref of the table", "form": {"id_token": ["x"], "state": ["v1.{D}.AAAAAAAAAAA.0.Lw"]}, "status": 400},
    {"name": "target the studio domain", "form": {"id_token": ["x"], "state": ["v1.{S}.AAAAAAAAAAA.0.Lw"]}, "status": 400},
    {"name": "target a host", "form": {"id_token": ["x"], "state": ["v1.{A}.{S}.AAAAAAAAAAA.0.Lw"]}, "status": 400},
    {"name": "target in capitals", "form": {"id_token": ["x"], "state": ["v1.AAAAAAAAAAAAAAAAAAAA.AAAAAAAAAAA.0.Lw"]}, "status": 400},
    {"name": "target empty", "form": {"id_token": ["x"], "state": ["v1..AAAAAAAAAAA.0.Lw"]}, "status": 400},
    {"name": "another version", "form": {"id_token": ["x"], "state": ["v2.{A}.AAAAAAAAAAA.0.Lw"]}, "status": 400},
    {"name": "a sixth part", "form": {"id_token": ["x"], "state": ["v1.{A}.AAAAAAAAAAA.0.Lw.x"]}, "status": 400},
    {"name": "four parts", "form": {"id_token": ["x"], "state": ["v1.{A}.AAAAAAAAAAA.0"]}, "status": 400},
    {"name": "n not 0 or 1", "form": {"id_token": ["x"], "state": ["v1.{A}.AAAAAAAAAAA.2.Lw"]}, "status": 400},
    {"name": "n empty", "form": {"id_token": ["x"], "state": ["v1.{A}.AAAAAAAAAAA..Lw"]}, "status": 400},
    {"name": "a of 4", "form": {"id_token": ["x"], "state": ["v1.{A}.AAAA.0.Lw"]}, "status": 400},
    {"name": "a of 12", "form": {"id_token": ["x"], "state": ["v1.{A}.AAAAAAAAAAAA.0.Lw"]}, "status": 400},
    {"name": "a outside the alphabet", "form": {"id_token": ["x"], "state": ["v1.{A}.AAAAAAAAAA+.0.Lw"]}, "status": 400},
    {"name": "p padded", "form": {"id_token": ["x"], "state": ["v1.{A}.AAAAAAAAAAA.0.Lw=="]}, "status": 400},
    {"name": "p in the standard alphabet", "form": {"id_token": ["x"], "state": ["v1.{A}.AAAAAAAAAAA.0.Lz8/"]}, "status": 400},
    {"name": "p of an impossible length", "form": {"id_token": ["x"], "state": ["v1.{A}.AAAAAAAAAAA.0.Lw8AA"]}, "status": 400},
    {"name": "a state that is not one", "form": {"id_token": ["x"], "state": ["x"]}, "status": 400},
    {"name": "an empty state", "form": {"id_token": ["x"], "state": [""]}, "status": 400},
    {"name": "no state", "form": {"id_token": ["x"]}, "status": 400},
    {"name": "no id_token", "form": {"state": ["v1.{A}.AAAAAAAAAAA.0.Lw"]}, "status": 400},
    {"name": "the issuer's error", "form": {"error": ["access_denied"], "state": ["v1.{A}.AAAAAAAAAAA.0.Lw"]}, "status": 400},
    {"name": "a token outside the alphabet", "form": {"id_token": ["x y"], "state": ["v1.{A}.AAAAAAAAAAA.0.Lw"]}, "status": 400},
    {"name": "a token with markup", "form": {"id_token": ["x<script>"], "state": ["v1.{A}.AAAAAAAAAAA.0.Lw"]}, "status": 400},
    {"name": "a token in the standard alphabet", "form": {"id_token": ["a+b/c="], "state": ["v1.{A}.AAAAAAAAAAA.0.Lw"]}, "status": 400},
    {"name": "an empty token", "form": {"id_token": [""], "state": ["v1.{A}.AAAAAAAAAAA.0.Lw"]}, "status": 400},
    {"name": "a token of 8 KiB and a byte", "form": {"id_token": ["{a*8193}"], "state": ["v1.{A}.AAAAAAAAAAA.0.Lw"]}, "status": 400},
    {"name": "a body above 16 KiB", "form": {"id_token": ["x"], "state": ["v1.{A}.AAAAAAAAAAA.0.Lw"], "pad": ["{p*16384}"]}, "status": 400}
  ],
  "fields": [
    {"name": "each once", "body": "id_token=a&state=v1.{A}.AAAAAAAAAAA.0.Lw", "callback": 200, "session": 200},
    {"name": "a further field", "body": "id_token=a&state=v1.{A}.AAAAAAAAAAA.0.Lw&session_state=x", "callback": 200, "session": 200},
    {"name": "id_token twice", "body": "id_token=a&id_token=a&state=v1.{A}.AAAAAAAAAAA.0.Lw", "callback": 400, "session": 400},
    {"name": "id_token twice, the second empty", "body": "id_token=a&state=v1.{A}.AAAAAAAAAAA.0.Lw&id_token=", "callback": 400, "session": 400},
    {"name": "state twice", "body": "id_token=a&state=v1.{A}.AAAAAAAAAAA.0.Lw&state=v1.{A}.AAAAAAAAAAA.0.Lw", "callback": 400, "session": 400},
    {"name": "state twice, the first another", "body": "state=v1.{B}.AAAAAAAAAAA.0.Lw&id_token=a&state=v1.{A}.AAAAAAAAAAA.0.Lw", "callback": 400, "session": 400},
    {"name": "no id_token", "body": "state=v1.{A}.AAAAAAAAAAA.0.Lw", "callback": 400, "session": 400},
    {"name": "no state", "body": "id_token=a", "callback": 400, "session": 400},
    {"name": "an empty body", "body": "", "callback": 400, "session": 400},
    {"name": "names in capitals", "body": "ID_TOKEN=a&STATE=v1.{A}.AAAAAAAAAAA.0.Lw", "callback": 400, "session": 400},
    {"name": "a semicolon between the fields", "body": "id_token=a;state=v1.{A}.AAAAAAAAAAA.0.Lw", "callback": 400, "session": 400},
    {"name": "a broken escape", "body": "id_token=a&state=v1.{A}.AAAAAAAAAAA.0.Lw&x=%zz", "callback": 400, "session": 400},
    {"name": "error", "body": "id_token=a&state=v1.{A}.AAAAAAAAAAA.0.Lw&error=x", "callback": 400, "session": 200},
    {"name": "an empty error", "body": "id_token=a&state=v1.{A}.AAAAAAAAAAA.0.Lw&error=", "callback": 400, "session": 200},
    {"name": "error without a value", "body": "id_token=a&state=v1.{A}.AAAAAAAAAAA.0.Lw&error", "callback": 400, "session": 200}
  ],
