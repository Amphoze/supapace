== file . drwxr-xr-x
== file conf.d drwxr-xr-x
== file conf.d/auto_explain.conf -r--r--r--
auto_explain.log_min_duration = 10s

== file conf.d/custom_overrides.conf -r--r--r--

== file conf.d/generated_optimizations.conf -r--r--r--

== file conf.d/pg_cron.conf -r--r--r--
cron.database_name = 'postgres'

== file conf.d/pg_net.conf -r--r--r--
pg_net.username = 'postgres'

== file conf.d/zz-supapace.conf -r--r--r--
listen_addresses = '*'
max_connections = 120
superuser_reserved_connections = 3
reserved_connections = 2
shared_buffers = 128MB
effective_cache_size = 384MB
work_mem = 4MB
maintenance_work_mem = 64MB
autovacuum_work_mem = 32MB
autovacuum_max_workers = 2
max_worker_processes = 38
max_wal_size = 1GB
max_slot_wal_keep_size = 2GB
wal_level = logical
archive_mode = on
archive_command = 'true # pgbackrest'
archive_timeout = 300
max_replication_slots = 8
max_wal_senders = 10
password_encryption = 'scram-sha-256'
cron.max_running_jobs = 2
cron.use_background_workers = on
random_page_cost = 1.1
huge_pages = off
max_parallel_workers_per_gather = 0
max_prepared_transactions = 0
temp_file_limit = 1GB

